# beanies.family — Environment Variables
#
# Copy to .env.local and fill in the vars you want enabled. A vanilla clone
# with no .env.local builds the "community" self-host: offline-only, manual
# .beanpod export/import, no cloud features. Each var below gates one feature
# in the UI; missing vars cleanly disable their feature.
#
# Full reference + provisioning steps (Google OAuth client, etc.):
#   docs/SELF_HOSTING.md

# ── Google Drive sync ────────────────────────────────────────────────────
# All three required to enable Drive sync. Register your own OAuth client at
# console.cloud.google.com (Drive API + Picker API enabled).
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_PROJECT_NUMBER=

# ── Google Drive OAuth proxy (Path B self-host only) ────────────────────
# Required for Drive sign-in on a self-host build that runs its own OAuth
# Lambda. Google's "Web Application" OAuth client type requires a server-
# side client_secret, so the SPA cannot talk to Google's token endpoint
# directly — see docs/SELF_HOSTING.md → Path B for the architectural
# explanation and infrastructure/lambda/oauth/ for a deployable reference.
#
# On the cloud build, this is left empty and the resolver falls back to
# VITE_REGISTRY_API_URL (one Lambda backs both surfaces). Path-B self-
# hosters who only run the OAuth Lambda set this and leave the registry
# vars empty.
VITE_OAUTH_PROXY_URL=

# ── Family registry (optional smoothness for invites) ────────────────────
# Both required to enable the registry. Used to look up a family's beanpod
# location by familyId during the join flow — saves the joiner one Picker
# click. Without it, joiners pick the shared file via Google Drive Picker
# manually (still works, just one more tap).
#
# On the cloud build, this URL also serves as the OAuth proxy host (one
# Lambda, two surfaces). On a Path-B self-host where you only stand up the
# OAuth Lambda and skip the registry, leave these empty and set
# VITE_OAUTH_PROXY_URL above instead.
VITE_REGISTRY_API_URL=
VITE_REGISTRY_API_KEY=

# ── Invite-only gate (closed-beta) ───────────────────────────────────────
# The gate is OFF by default (open registration). It arms only when BOTH of
# the following are true, so it can never lock everyone out with no valid token.
#
# 1. The explicit switch. ONLY the literal "true" arms it; unset/empty/"false"
#    /typo all mean off. In CI this is the INVITE_GATE repo VARIABLE (not a
#    secret) so its value is visible and editable in the GitHub UI.
VITE_INVITE_GATE=false
# 2. Comma-separated SHA-256 hashes of valid invite tokens (lowercase hex).
#    Generate: echo -n "my-token" | sha256sum | cut -d' ' -f1
#    Safe to keep populated while the gate is off — it's inert until (1) flips.
VITE_INVITE_BEAN_HASHES=

# ── App Store / Play review demo mode (TEMPORARY) ────────────────────────
# REVIEW-DEMO: delete this whole block at retirement — see
# docs/runbooks/native-store-submission.md.
# A code-gated way into a fully-seeded synthetic family with NO Google
# sign-in, because store reviewers cannot get past Google's risk-based
# verification challenges. Leave all three empty everywhere except the two
# mobile RELEASE lanes — never set them for the web deploy.
#
# Arms the gate. Only the exact string "true" enables it, AND the hash below
# must be non-empty (both required — see features.reviewDemo).
VITE_REVIEW_DEMO=
# Comma-separated SHA-256 hex digests of the valid demo codes. The plaintext
# code never appears in the repo or the bundle.
#   echo -n "my-demo-code" | sha256sum | cut -d' ' -f1
VITE_REVIEW_DEMO_CODE_HASH=
# ISO date after which demo mode disarms ITSELF, with no new release needed.
# Parsed as UTC MIDNIGHT, so this is the FIRST DEAD instant, not the last
# working day: 2026-11-01 keeps the demo live through 31 Oct UTC.
# Unset or unparseable = permanently expired (fail closed).
VITE_REVIEW_DEMO_EXPIRES=

# ── Slack incoming webhooks (optional telemetry) ─────────────────────────
# Each is independent; leave empty to disable that channel silently.
VITE_INVITE_WEBHOOK_URL=
VITE_SLACK_WEBHOOK_URL=
VITE_BEANIES_ERROR_WEBHOOK_URL=
# #45: private #beanies-feedback channel for in-app NPS/feedback submissions.
VITE_FEEDBACK_WEBHOOK_URL=

# ── Diagnostic logging / telemetry firehose (optional, ADR-027) ──────────
# The AWS ingest endpoint (POST /logs) the diagnostic-log queue ships to.
# Leave empty to disable — logEvent() becomes a cheap no-op (warns once).
# In CI this is the BEANIES_LOG_INGEST_URL repo VARIABLE (the Terraform
# `telemetry_ingest_url` output, e.g. https://api.beanies.family/logs).
VITE_BEANIES_LOG_INGEST_URL=
# Soft API key sent with each batch (x-api-key header / ?k= for beacons).
# Public in the client bundle, so not a true secret, but a CI SECRET to deter
# casual abuse. Matches the VITE_REGISTRY_API_KEY pattern.
VITE_BEANIES_LOG_INGEST_API_KEY=

# ── Plausible analytics (optional) ───────────────────────────────────────
# Your Plausible site identifier (the `pa-XXX` part of the script URL —
# pass just the `XXX`). Leave empty to disable analytics entirely
# (vanilla self-host stays offline). The official app.beanies.family deploy
# sets this in .github/workflows/deploy.yml (value: jvjpzIr6FM9tDKaS1gZaK);
# you don't need it for local dev unless you're testing the analytics path.
VITE_PLAUSIBLE_DOMAIN=

# ── MyMemory translation API quota (optional) ────────────────────────────
# Your email address. With this set, the daily quota goes from 5k → 50k
# chars/day. Without it, translation works at the lower quota.
VITE_MYMEMORY_EMAIL=

# ── Marketing-site URL (optional) ────────────────────────────────────────
# Used for in-app links to /help, /blog, /guides, etc. Defaults to
# https://beanies.family in prod and http://localhost:4321 in dev.
VITE_MARKETING_URL=

# Note: AI API keys are stored locally in the app settings, not env vars.
# Users enter their own keys in the Settings page for privacy.
#
# VITE_BUILD_SHA is set automatically by Vite at build time (CI). Do not set
# it manually — it surfaces in error reports for deploy correlation.
