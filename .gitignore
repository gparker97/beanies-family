# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files
.env
.env.local
# ...and any backup of it. A `.env.local.bak-<ts>` was left untracked and UNignored by an
# editing script — one `git add .` from committing live secrets to a public repo.
.env.local.*
.env.*.bak*
.env.*.local
.env.production

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code (ignore local settings, but track shared skills)
.claude/*
!.claude/skills/

# Private ops skills: symlinks into the private ops repo, created by its
# scripts/link-ops-skills.sh. Never commit them (no trailing slash: a symlink is a file to git).
/.claude/skills/beanie-video
/.claude/skills/beanies-blog
/.claude/skills/beanies-books
/.claude/skills/beanies-competitor-analysis
/.claude/skills/beanies-metrics
/.claude/skills/beanies-new-issue
/.claude/skills/beanies-pre-plan
/.claude/skills/deploy-prod-auto
/.claude/skills/deploy-prod-skip-ci
/.claude/skills/end-session
/.claude/skills/error-review
/.claude/skills/good-morning
/.claude/skills/karma-run
/.claude/skills/launch-status
/.claude/skills/pilot-scout
/.claude/skills/pinterest-post
/.claude/skills/start-session

# MCP server config (contains API tokens)
.mcp.json

# Playwright
playwright-report
test-results

# Lambda build artifacts
infrastructure/lambda/**/lambda.zip
infrastructure/modules/**/*.zip

# Terraform
infrastructure/.terraform/
infrastructure/**/.terraform/
*.tfstate
*.tfstate.backup
*.tfplan
tfplan
tfplan.out
# A filled-in copy of the terraform env file — the .example template stays tracked.
.beanies-tf.env
infrastructure/*.plan

# Promo-video recording artifacts (raw footage, traces) — never committed
scripts/promo-video/.out/
scripts/store-screenshots/.out/
scripts/store-screenshots/.tmp/

# Native release signing + build artifacts — NEVER commit. The upload keystore is
# a private signing key; AABs/IPAs are regenerable via the release lanes. The
# debug keystore is intentionally tracked (fixed App Link fingerprint) — excepted.
*.keystore
!android/app/beanies-debug.keystore
*.jks
*.aab
*.p8
*.p12

# Design-review screenshots (rendered artifacts — see CLAUDE.md: these belong on Drive)
screenshots/

# Moved to the private ops repo (2026-10-03/05); ignored so nothing re-publishes them.
/docs/mockups/
/docs/research/
/docs/test-plans/
/docs/wireframes/

# Wall grid capture output — rendered artifacts belong in Drive, not here.
scratch-shots/

# Brand media: generated by scripts/sync-brand-assets.mjs from the ONE copy in
# packages/brand/assets/. Both public roots are separate origins that each need
# the files at build time, so they are build output, not sources. Edit or add
# artwork in packages/brand/assets/{shared,marketing,blog}/ and re-run
# `npm run sync-brand-assets` (predev/prebuild do it for you).
# The .webp companions under web/public/ are generated on top by
# scripts/convert-images.mjs and are likewise not committed.
/public/brand/
/web/public/brand/
/web/public/blog/

# .webp companions generated by scripts/convert-images.mjs beside their committed
# .jpg/.png masters. The masters stay in git; these do not.
/public/help/pwa-install/*.webp
/web/public/help/pwa-install/*.webp

# vitest JSON reporter output (written by review tooling; never committed)
.vitest/
