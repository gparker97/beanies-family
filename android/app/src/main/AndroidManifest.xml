<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:screenOrientation="portrait"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth deep link (ADR-029 A2): verified https App Link, NOT a
                 custom scheme. Routes Google's redirect to
                 https://beanies.family/oauth/native back into the app once
                 /.well-known/assetlinks.json is hosted + verified. launchMode
                 singleTask (above) delivers it to the running instance as an
                 appUrlOpen event. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="beanies.family" android:pathPrefix="/oauth/native" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- #52: BiometricPrompt for hardware Keystore biometric unlock (ADR-029). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- #55: on-device reminder notifications (@capacitor/local-notifications).
         POST_NOTIFICATIONS is the Android 13+ (API 33) runtime prompt to show any
         notification. RECEIVE_BOOT_COMPLETED lets the plugin re-register scheduled
         alarms after a reboot.

         EXACT ALARMS — do not "simplify" this back to SCHEDULE_EXACT_ALARM alone.
         An earlier revision of this comment claimed the plugin's fallback
         "combined with the lead-time offset delivers on time". It does not: when
         exact alarms are unavailable the plugin silently degrades to
         AlarmManager.setAndAllowWhileIdle (LocalNotificationManager.java:380-393),
         which is INEXACT and Doze-batched to roughly one alarm per 9 minutes.
         `allowWhileIdle` buys permission to fire DURING Doze, not punctuality, and
         a lead-time offset cannot compensate for an unbounded deferral. That is
         the root cause of the original "9am reminder arrived at 9:05" defect.

         USE_EXACT_ALARM (API 33+) is auto-granted and non-revocable. Play
         restricts it to apps whose core function is an alarm clock or calendar;
         beanies.family's Family Planner is a calendar with user-set per-event
         reminders, which is the declared justification in the Play Console.
         SCHEDULE_EXACT_ALARM is capped at API 32, where it is auto-granted (it is
         denied-by-default from API 34) — on Android 12/12L it IS user-revocable,
         which is why the Settings recovery row exists. See the #55 remediation
         plan (docs/plans/2026-07-23-notifications-review-remediation.md). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!-- Android 11+ (API 30+) package visibility: without this <queries> entry,
         Intent(ACTION_IMAGE_CAPTURE).resolveActivity() returns null even when a
         camera app is installed, so Capacitor's WebView file chooser silently
         falls back to the document picker instead of launching the camera. This
         is what powers the `capture="environment"` file inputs (AiDocumentPicker
         "Take a photo" + PhotoAttachments "Take photo"). We deliberately do NOT
         declare android.permission.CAMERA — the system camera app handles the
         capture via intent, and leaving the permission undeclared lets Capacitor
         skip the runtime permission prompt (see BridgeWebChromeClient). -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>
</manifest>
