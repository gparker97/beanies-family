<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth deep link (ADR-029 A2): verified https App Link. Routes
                 Google's redirect to https://beanies.family/oauth/native back
                 into the app once /.well-known/assetlinks.json is hosted +
                 verified. launchMode singleTask (above) delivers it to the
                 running instance as an appUrlOpen event. This filter stays
                 FIRST — it is the preferred path on Android. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="beanies.family" android:pathPrefix="/oauth/native" />
            </intent-filter>

            <!-- OAuth custom-scheme bridge. Android does not NEED this (the
                 verified App Link above is the normal path), but iOS does:
                 Apple fires Universal Links only on user-initiated taps, so the
                 OAuth *redirect* never hands off and the app ends up running
                 inside SFSafariViewController. The fix is a bridge page at
                 beanies.family/oauth/native that hops to this scheme.

                 Registering it here too keeps BOTH platforms on one code path
                 and gives Android a recovery route it lacks today: if App Link
                 verification ever lapses, the device lands on the same bridge
                 page and this filter catches the hop instead of dead-ending.

                 The scheme is the bundle/application id. Keep it in sync with
                 NATIVE_BRIDGE_URI in src/constants/nativeOAuth.ts — a tripwire
                 test asserts this file declares exactly that scheme. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="family.beanies.app" android:host="oauth" />
            </intent-filter>

            <!-- Share target (#64): beanies appears in the system share sheet for photos,
                 screenshots and PDFs, handled by ShareIntentPlugin. EXPORTED is required
                 for a share target and is a deliberate, reviewed decision — any app can
                 invoke this, so nothing arriving through it is trusted: the type is
                 re-decided from the resolved bytes, the read is size-capped natively, the
                 filename is sanitised before storage, and nothing is saved until the user
                 confirms it in a review modal. launchMode="singleTask" (above) delivers a
                 share to the RUNNING instance via onNewIntent rather than starting a
                 second copy of the app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <!-- Links (#64 links). YouTube, browsers and most apps share a URL as
                     text/plain, not as a file. Declared on ACTION_SEND ONLY: a multi-item
                     text share is not a thing anyone does, and every declared type is
                     exported attack surface. -->
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- #52: BiometricPrompt for hardware Keystore biometric unlock (ADR-029). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- #55: on-device reminder notifications (@capacitor/local-notifications).
         POST_NOTIFICATIONS is the Android 13+ (API 33) runtime prompt to show any
         notification. RECEIVE_BOOT_COMPLETED lets the plugin re-register scheduled
         alarms after a reboot.

         EXACT ALARMS — do not "simplify" this back to SCHEDULE_EXACT_ALARM alone.
         An earlier revision of this comment claimed the plugin's fallback
         "combined with the lead-time offset delivers on time". It does not: when
         exact alarms are unavailable the plugin silently degrades to
         AlarmManager.setAndAllowWhileIdle (LocalNotificationManager.java:380-393),
         which is INEXACT and Doze-batched to roughly one alarm per 9 minutes.
         `allowWhileIdle` buys permission to fire DURING Doze, not punctuality, and
         a lead-time offset cannot compensate for an unbounded deferral. That is
         the root cause of the original "9am reminder arrived at 9:05" defect.

         USE_EXACT_ALARM (API 33+) is auto-granted and non-revocable. Play
         restricts it to apps whose core function is an alarm clock or calendar;
         beanies.family's Family Planner is a calendar with user-set per-event
         reminders, which is the declared justification in the Play Console.
         SCHEDULE_EXACT_ALARM is capped at API 32, where it is auto-granted (it is
         denied-by-default from API 34) — on Android 12/12L it IS user-revocable,
         which is why the Settings recovery row exists. See the #55 remediation
         plan (docs/plans/2026-07-23-notifications-review-remediation.md). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!-- Android 11+ (API 30+) package visibility: without this <queries> entry,
         Intent(ACTION_IMAGE_CAPTURE).resolveActivity() returns null even when a
         camera app is installed, so Capacitor's WebView file chooser silently
         falls back to the document picker instead of launching the camera. This
         is what powers the `capture="environment"` file inputs (AiDocumentPicker
         "Take a photo" + PhotoAttachments "Take photo"). We deliberately do NOT
         declare android.permission.CAMERA — the system camera app handles the
         capture via intent, and leaving the permission undeclared lets Capacitor
         skip the runtime permission prompt (see BridgeWebChromeClient). -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>
</manifest>
