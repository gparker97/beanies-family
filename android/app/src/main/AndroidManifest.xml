<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:screenOrientation="portrait"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth deep link (ADR-029 A2): verified https App Link, NOT a
                 custom scheme. Routes Google's redirect to
                 https://beanies.family/oauth/native back into the app once
                 /.well-known/assetlinks.json is hosted + verified. launchMode
                 singleTask (above) delivers it to the running instance as an
                 appUrlOpen event. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="beanies.family" android:pathPrefix="/oauth/native" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- #52: BiometricPrompt for hardware Keystore biometric unlock (ADR-029). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- #55: on-device reminder notifications (@capacitor/local-notifications).
         POST_NOTIFICATIONS is the Android 13+ (API 33) runtime prompt to show any
         notification. RECEIVE_BOOT_COMPLETED lets the plugin re-register scheduled
         alarms after a reboot. SCHEDULE_EXACT_ALARM is a NORMAL declaration for
         Android 13 (auto-granted, revocable) — we deliberately do NOT build the
         Android 14+ user-grant flow (USE_EXACT_ALARM is Play-restricted to
         alarm/clock apps): the plugin falls back to setAndAllowWhileIdle when the
         permission is absent, which combined with the lead-time offset delivers
         on time without the extra friction. See ADR-029 + the #55 plan. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Android 11+ (API 30+) package visibility: without this <queries> entry,
         Intent(ACTION_IMAGE_CAPTURE).resolveActivity() returns null even when a
         camera app is installed, so Capacitor's WebView file chooser silently
         falls back to the document picker instead of launching the camera. This
         is what powers the `capture="environment"` file inputs (AiDocumentPicker
         "Take a photo" + PhotoAttachments "Take photo"). We deliberately do NOT
         declare android.permission.CAMERA — the system camera app handles the
         capture via intent, and leaving the permission undeclared lets Capacitor
         skip the runtime permission prompt (see BridgeWebChromeClient). -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>
</manifest>
