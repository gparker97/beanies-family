<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's configuration screen (#130): whose day, the six blocks in fill order, the
     background opacity. Labels from strings.xml (en + zh); not a RemoteViews layout. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/config_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_bold"
            android:text="@string/widget_config_title"
            android:textColor="@color/widget_ink"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/config_audience_heading"
            style="@style/WidgetConfigHeading"
            android:text="@string/widget_config_whose_day" />

        <RadioGroup
            android:id="@+id/config_audience"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/config_audience_my"
                style="@style/WidgetConfigOption"
                android:layout_marginEnd="24dp"
                android:text="@string/widget_config_my_day" />

            <RadioButton
                android:id="@+id/config_audience_our"
                style="@style/WidgetConfigOption"
                android:text="@string/widget_config_our_day" />
        </RadioGroup>

        <TextView
            style="@style/WidgetConfigHeading"
            android:text="@string/widget_config_show" />

        <CheckBox
            android:id="@+id/config_block_events"
            style="@style/WidgetConfigOption"
            android:text="@string/widget_config_events" />

        <CheckBox
            android:id="@+id/config_block_whos_where"
            style="@style/WidgetConfigOption"
            android:text="@string/widget_config_whos_where" />

        <CheckBox
            android:id="@+id/config_block_meals"
            style="@style/WidgetConfigOption"
            android:text="@string/widget_config_meals" />

        <CheckBox
            android:id="@+id/config_block_due"
            style="@style/WidgetConfigOption"
            android:text="@string/widget_config_due" />

        <CheckBox
            android:id="@+id/config_block_coming_up"
            style="@style/WidgetConfigOption"
            android:text="@string/widget_config_coming_up" />

        <CheckBox
            android:id="@+id/config_block_hint"
            style="@style/WidgetConfigOption"
            android:text="@string/widget_config_hint" />

        <TextView
            style="@style/WidgetConfigHeading"
            android:text="@string/widget_config_background" />

        <RadioGroup
            android:id="@+id/config_opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/config_opacity_100"
                style="@style/WidgetConfigOption"
                android:layout_marginEnd="24dp"
                android:text="@string/widget_config_opacity_100" />

            <RadioButton
                android:id="@+id/config_opacity_70"
                style="@style/WidgetConfigOption"
                android:layout_marginEnd="24dp"
                android:text="@string/widget_config_opacity_70" />

            <RadioButton
                android:id="@+id/config_opacity_40"
                style="@style/WidgetConfigOption"
                android:text="@string/widget_config_opacity_40" />
        </RadioGroup>

        <TextView
            style="@style/WidgetConfigHeading"
            android:text="@string/widget_config_text_size" />

        <!-- Vertical: three word labels overflow a narrow screen at a large system font. Order is
             WidgetPrefs.TextSize's declaration order (DayWidgetConfigActivity.TEXT_SIZE_IDS). -->
        <RadioGroup
            android:id="@+id/config_text_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/config_text_standard"
                style="@style/WidgetConfigOption"
                android:text="@string/widget_config_text_standard" />

            <RadioButton
                android:id="@+id/config_text_large"
                style="@style/WidgetConfigOption"
                android:text="@string/widget_config_text_large" />

            <RadioButton
                android:id="@+id/config_text_larger"
                style="@style/WidgetConfigOption"
                android:text="@string/widget_config_text_larger" />
        </RadioGroup>

        <Button
            android:id="@+id/config_done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/widget_config_button"
            android:fontFamily="@font/outfit_bold"
            android:minHeight="52dp"
            android:text="@string/widget_config_done"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
