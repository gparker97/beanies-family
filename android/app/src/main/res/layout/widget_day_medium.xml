<?xml version="1.0" encoding="utf-8"?>
<!--
  "Your day", 4x2 and 4x3 (#130, mockup placement E, round 9b; the 4x3 is an alias in
  values/widget_layouts.xml): the date column beside the agenda panel (calendar, to-dos, footer).
  widget_frame and widget_inner paint the card; both thin with the background-opacity choice
  (setImageAlpha) while their colour still follows light/dark. No readable text sits on them when
  they do: the panel keeps its own 95% fill and the date column gets a 95% tile (widget_tile_bg,
  set only below 100%). The root's 8dp start padding plus the column's 6dp keep the text at 14dp.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_container_bg" />

    <!-- The inner surface (95%), inset 10dp; thins with the rim. -->
    <ImageView
        android:id="@+id/widget_inner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="10dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_inner_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <include layout="@layout/widget_part_date_column" />

        <include layout="@layout/widget_part_panel" />
    </LinearLayout>
</FrameLayout>
