<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview (Android 12+ previewLayout, #130): frame, panel and the peek,
     no text, since nothing here can be localized or reflect the person's own day. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_container_bg" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="74dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="20dp"
            android:background="@drawable/widget_panel_bg">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_family_hug" />
        </FrameLayout>

        <ImageView
            android:layout_width="48dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/peek_family" />
    </FrameLayout>
</FrameLayout>
