<?xml version="1.0" encoding="utf-8"?>
<!--
  The agenda panel of the medium and large widgets (#130, round 9b): the scrolling calendar
  (a ListView whose rows DayWidgetList builds: inline in the update on API 31+, through
  DayWidgetService on API 24-30; or the relaxed block in its place on a clear week), the
  fixed to-dos section (widget_part_tasks.xml, never part of the scroll) in one of two slots:
  under the list in Your day, above it in To-dos (2026-11-11), the "tonight" footer with "later ›"
  (in To-dos "N more" / "all to-dos ›"),
  and the peek over the panel's top-right edge. Geometry (root padding top 5dp): the peek's top is 5dp below the widget's top, the panel's
  top 20dp below that (= 13dp below the 12dp content top), so the 22dp peek ends 2dp inside the
  panel, 6dp in from its right edge. The 13dp right padding leaves room for the scrollbar.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    tools:ignore="MergeRootFrame">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="20dp"
        android:background="@drawable/widget_panel_bg"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="13dp"
        android:paddingBottom="3dp">

        <!-- The to-dos section's slot above the calendar (the To-dos layout). Both slots are
             emptied on every render and the section (widget_part_tasks.xml) is added into one;
             the weight-1 list (or relaxed block) under a top-slotted section is its spacer. -->
        <LinearLayout
            android:id="@+id/tasks_slot_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <ListView
            android:id="@+id/agenda_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbars="vertical" />

        <include
            layout="@layout/widget_part_relaxed"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- The to-dos section's slot under the calendar (Your day). -->
        <LinearLayout
            android:id="@+id/tasks_slot_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/panel_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="17dp"
            android:orientation="horizontal"
            android:paddingTop="1dp">

            <TextView
                android:id="@+id/footer_tonight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/widget_ink_soft"
                android:textSize="@dimen/widget_text_body"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/footer_later"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:singleLine="true"
                android:textColor="@color/widget_ink_faint"
                android:textSize="@dimen/widget_text_body"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/peek_family"
        android:layout_width="48dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="6dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/peek_family" />

    <ImageView
        android:id="@+id/peek_avatar"
        android:layout_width="30dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="6dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />
</FrameLayout>
