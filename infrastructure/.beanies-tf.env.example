# beanies.family — Terraform environment (TEMPLATE — no secrets in this file).
#
# Copy it somewhere private, fill in the five keys, and lock it down:
#   cp infrastructure/.beanies-tf.env.example ~/.beanies-tf.env
#   chmod 600 ~/.beanies-tf.env
#   # edit ~/.beanies-tf.env
#
# Source it before running terraform:   source ~/.beanies-tf.env
#
# Then:
#   cd ~/projects/beanies-family/infrastructure
#   beanies_tf_check          # preflight: account, region, required vars
#   terraform plan            # terraform.auto.tfvars is auto-loaded — no -var-file needed
#   terraform apply
#
# ── AWS account ──────────────────────────────────────────────────────────────
# beanies.family lives in the PERSONAL account 517040426968 via the 'default'
# profile. This is NOT the grobrix account 785130009771 that Penelope uses —
# sourcing ~/.penelope-tf.env in a beanies shell points you at the wrong account
# and the state backend below will not be found.
export AWS_PROFILE="default"
export AWS_REGION="ap-southeast-1"
export AWS_DEFAULT_REGION="ap-southeast-1"

# For the preflight check. Not read by Terraform.
export BEANIES_AWS_ACCOUNT_ID="517040426968"

# ── State backend (declared in infrastructure/backend.tf — FYI only) ─────────
# bucket: beanies-family-terraform-state   key: prod/terraform.tfstate
# lock:   beanies-family-terraform-lock    region: ap-southeast-1

# ── Terraform secrets (no defaults — apply FAILS without all five) ───────────
# Non-sensitive config (domain, hosted zone, apex TXT records) is committed in
# infrastructure/terraform.auto.tfvars and needs nothing here.

# Google OAuth client secret. Server-held by the oauth Lambda for token
# exchange + refresh — never in the client bundle.
#   Google Cloud Console → APIs & Services → Credentials → the beanies.family
#   OAuth 2.0 Web client → Client secret.
export TF_VAR_google_client_secret=""

# Tinfoil inference API key for the AI document-extraction proxy
# (POST /ai-extract). Server-held, BILLABLE third-party credential — never in
# the client bundle. See #133 / ADR-030.
#   Tinfoil dashboard → API keys.
export TF_VAR_tinfoil_api_key=""

# ── Soft client keys ─────────────────────────────────────────────────────────
# The next three ship inside the public client bundle, so they are not true
# secrets — they only deter casual abuse of the public endpoints. But each MUST
# match its GitHub Actions secret exactly, or the deployed client starts getting
# 401s from an endpoint Terraform just re-keyed. Rotating one means updating
# BOTH sides and redeploying the client.

# Family registry service (POST api.beanies.family) — GH secret REGISTRY_API_KEY
export TF_VAR_registry_api_key=""

# Telemetry ingest (POST /logs) — GH secret BEANIES_LOG_INGEST_API_KEY
export TF_VAR_log_ingest_api_key=""

# Recipe content fetcher (POST /content-fetch) — GH secret CONTENT_FETCH_API_KEY
# Declared with NO default, so a missing value fails `terraform apply` loudly rather than
# silently blanking anything. Generate with:  head -c 24 /dev/urandom | base64 | tr '+/' '-_' | tr -d '='
export TF_VAR_content_fetch_api_key=

# AI extraction proxy (POST /ai-extract) — GH secret AI_EXTRACT_API_KEY
export TF_VAR_ai_extract_api_key=""

# ── Recovering a value you've lost ───────────────────────────────────────────
# All five are live in the deployed Lambdas' environments. To read one back:
#
#   aws lambda get-function-configuration --region ap-southeast-1 \
#     --function-name beanies-family-oauth-prod \
#     --query 'Environment.Variables' --output json
#
# Function names by key:
#   google_client_secret            → beanies-family-oauth-prod
#   registry_api_key                → beanies-family-registry-prod
#   log_ingest_api_key              → beanies-family-telemetry-prod
#   tinfoil_api_key, ai_extract_api_key → beanies-family-ai-extract-prod

# ── Optional-but-set-in-prod (the silent-revert class) ───────────────────────
# ⚠️ READ THIS BEFORE ADDING A NEW VARIABLE.
#
# The five above are declared with NO default, so a missing one fails the apply
# loudly. The one below is declared `default = ""` — deliberately optional, so a
# self-hoster without a Slack workspace still gets a working Lambda. That makes
# it a DIFFERENT and more dangerous shape: if you forget it, Terraform does not
# fail. It plans to overwrite the live value with "" and the apply succeeds.
#
# This exact thing happened on 2026-08-25. The variable was introduced 2026-08-10
# (commit 7c25b28e, server-side build-integrity alarm); this file was last written
# 2026-08-05 and never updated, and the old preflight looped a hardcoded list of
# five names, so it printed "→ ready" while the plan was staged to blank the
# webhook. It was caught by reading the plan, not by any check. The preflight
# below now derives its list from variables.tf so it cannot happen again.

# Slack incoming-webhook for #beanies-errors, used by the TELEMETRY LAMBDA to
# escalate build-integrity events server-side. Same URL as the client's
# BEANIES_ERROR_WEBHOOK_URL GitHub variable — the Lambda needs its own copy
# because the condition it detects (a dev build in prod) is precisely the case
# where the client has no webhook and cannot report anything itself.
#   Slack → Apps → Incoming Webhooks → the #beanies-errors configuration.
#   Or read it back:  aws lambda get-function-configuration --region ap-southeast-1 \
#     --function-name beanies-family-telemetry-prod --query 'Environment.Variables'
export TF_VAR_slack_error_webhook_url=

# ── Preflight ────────────────────────────────────────────────────────────────
# Derives the variable list from infrastructure/variables.tf rather than
# hardcoding it, so a variable added later cannot be silently forgotten. It
# classifies each declaration by the two properties that decide how a missing
# value behaves:
#
#   sensitive, no default  → REQUIRED. Terraform fails the apply. Safe to forget.
#   sensitive, has default → EXPECTED. Terraform SILENTLY BLANKS the live value.
#                            This is the dangerous class; treated as an error.
#   not sensitive          → config, committed in terraform.auto.tfvars. Ignored.

# Emit "<name> <has_default> <sensitive>" per variable block.
_beanies_tf_declared_vars() {
  awk '
    /^[[:space:]]*variable[[:space:]]+"/ {
      match($0, /"[^"]+"/); name = substr($0, RSTART+1, RLENGTH-2)
      has_default = 0; sensitive = 0; in_block = 1; next
    }
    in_block && /^[[:space:]]*default[[:space:]]*=/                   { has_default = 1 }
    in_block && /^[[:space:]]*sensitive[[:space:]]*=[[:space:]]*true/ { sensitive = 1 }
    in_block && /^}/ { print name, has_default, sensitive; in_block = 0 }
  ' "$1"
}

beanies_tf_check() {
  local ok=0
  local repo="${BEANIES_REPO:-$HOME/projects/beanies-family}"
  local vars_tf="$repo/infrastructure/variables.tf"

  local acct
  acct=$(aws sts get-caller-identity --query Account --output text 2>/dev/null)
  if [ -z "$acct" ]; then
    echo "  ✗ AWS: no valid credentials for profile '$AWS_PROFILE'"
    ok=1
  elif [ "$acct" != "$BEANIES_AWS_ACCOUNT_ID" ]; then
    echo "  ✗ AWS: authenticated to $acct, expected $BEANIES_AWS_ACCOUNT_ID"
    echo "        (785130009771 = grobrix/penelope — wrong account, wrong state backend)"
    ok=1
  else
    echo "  ✓ AWS account $acct  region $AWS_REGION  profile $AWS_PROFILE"
  fi

  if [ ! -r "$vars_tf" ]; then
    echo "  ✗ cannot read $vars_tf — set BEANIES_REPO if the repo lives elsewhere"
    echo "  → NOT ready (cannot verify variables without it; do NOT apply blind)"
    return 1
  fi

  local name has_default sensitive tfvar val
  while read -r name has_default sensitive; do
    [ "$sensitive" = 1 ] || continue          # config lives in terraform.auto.tfvars
    tfvar="TF_VAR_$name"
    val="${!tfvar}"
    if [ -n "$val" ]; then
      echo "  ✓ $tfvar set (${#val} chars)"
    elif [ "$has_default" = 0 ]; then
      echo "  ✗ $tfvar is empty — apply will FAIL (no default)"
      ok=1
    else
      echo "  ✗ $tfvar is empty — it has a default, so terraform will NOT fail."
      echo "      It will plan to OVERWRITE the live value with \"\" and succeed."
      echo "      Set it, or confirm from the plan that blanking it is intended."
      ok=1
    fi
  done < <(_beanies_tf_declared_vars "$vars_tf")

  if [ "$PWD" != "$repo/infrastructure" ]; then
    echo "  ! not in infrastructure/ — cd there before terraform"
  fi

  if [ $ok -eq 0 ]; then
    echo "  → ready.  Always: terraform plan -out=tfplan.out  →  read it  →  apply tfplan.out"
  else
    echo "  → NOT ready, fix the above first"
  fi
  return $ok
}

echo "beanies.family terraform env loaded — run 'beanies_tf_check' before applying."
