<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>NSCameraUsageDescription</key>
	<string>beanies.family uses the camera so you can take a photo of an invitation or booking for the beanies to read.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>beanies.family uses Face ID to unlock your family data with a single glance instead of typing your password.</string>
	<key>CFBundleDisplayName</key>
        <string>beanies.family</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- OAuth custom-scheme bridge. This is what makes iOS route
	     family.beanies.app://oauth/native to us, so AppDelegate's
	     application(_:open:options:) fires Capacitor's appUrlOpen event.

	     WHY A CUSTOM SCHEME AT ALL: Apple fires Universal Links only on
	     user-initiated TAPS. The Google OAuth *redirect* to our Universal Link
	     (https://beanies.family/oauth/native) therefore never hands off — it
	     just loads in the SFSafariViewController that @capacitor/browser opened,
	     so the whole app ends up running inside the browser sheet. Custom
	     schemes do escape the sheet, so a bridge page at that https URL hops to
	     this scheme. See docs/plans/2026-08-06-ios-oauth-custom-scheme-bridge.md.

	     The scheme is the bundle id (reverse-DNS, the iOS convention; dots are
	     legal per RFC 3986). Keep it in sync with NATIVE_BRIDGE_URI in
	     src/constants/nativeOAuth.ts — a tripwire test asserts this file
	     declares exactly that scheme. No LSApplicationQueriesSchemes is needed:
	     that governs outbound canOpenURL, which the app never calls. -->
	<!-- DOCUMENT TYPES (#64). What makes beanies appear in the share sheet as a
	     DOCUMENT HANDLER rather than only as a Share Extension - and, crucially, what
	     lets iOS OPEN THE APP with the file instead of running an extension that is
	     forbidden from opening it. This is the mechanism ChatGPT uses when a shared
	     file opens the app directly; there is no equivalent for a web URL, which is
	     why links still go through the extension.

	     LSHandlerRank = Alternate: beanies handles these types but does not claim to
	     own them, so it never displaces Photos, Files or Preview as the default.

	     LSSupportsOpeningDocumentsInPlace is deliberately ABSENT (i.e. false). beanies
	     copies what it is given into its own inbox and never edits the original, so
	     in-place access would be a permission we ask for and do not use. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Image</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.image</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PDF</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
			</array>
		</dict>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>family.beanies.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>family.beanies.app</string>
			</array>
		</dict>
	</array>
	<!-- Export compliance: beanies uses only standard, exempt cryptography —
	     AES-GCM / AES-KW via the Web Crypto API and HTTPS/TLS. No proprietary or
	     custom crypto ships. `false` declares "no non-exempt encryption" so App
	     Store Connect stops prompting for export compliance on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<!-- iPhone: portrait-locked to match the PWA manifest (orientation:
	     'portrait') and the Android activity. The app is designed phone-first
	     and every layout is portrait. iPad keeps all orientations below. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
