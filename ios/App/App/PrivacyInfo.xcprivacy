<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App-level privacy manifest (Apple requirement for new-app submissions).

  Authored from the single data-collection source of truth in
  docs/runbooks/native-store-submission.md. If you change what the app transmits
  (src/utils/diagnosticContext.ts ALLOWED_CONTEXT_KEYS, errorReporter.ts, or the
  telemetry firehose), update that table AND this manifest AND the store
  Data-Safety/App-Privacy answers AND web/src/pages/privacy.astro together.

  What beanies collects (nothing for ads or tracking):
    - Email + Name: ONLY on the low-volume critical-error path to the maintainer's
      alerting channel (so we can contact the family about a data-at-risk failure).
    - Crash + Other Diagnostic Data: crash/error reports + a diagnostic firehose
      used solely to keep the app working. The firehose itself is PII-free
      (correlated by a random family_id); the critical-error path additionally
      carries the owner email, so these types are marked Linked.
      Includes (2026-08) recurring-series occurrence dates: the calendar date of
      a repeating session being edited, the date it resolved to, the chosen edit
      scope, and counts — dates and closed enums only, never a title, member
      name or amount. Declared here under Other Diagnostic Data; no new
      NSPrivacyCollectedDataType is required.
    - User ID (family_id): a random per-family UUID used to correlate diagnostics.
    - Product Interaction, from TWO surfaces, both analytics, neither ever for ads
      or tracking:
        (a) the family registry — last-login date, approx .beanpod size, and (2026-08,
            #71) signupPlatform: the fixed enum web/ios/android, stamped write-once
            when the row is created. Linked to family_id.
        (b) Plausible Analytics (2026-08, #71) — the app now loads the same cookieless
            plausible.io script the marketing site uses, reporting a fixed event name
            (signup / login / feature_used / nudge shown+dismissed / …) plus the closed
            props feature, method, action, surface, platform — PLUS autocaptured
            screen views (the in-app route path, referrer, UA-derived device/OS).
            Note a few route paths embed a random on-device UUID (/pod/:memberId,
            /pod/cookbook/:recipeId), never joined to a name or email. No cookies
            and nothing stored on the device; no cross-app or cross-site linkage —
            so it is NOT tracking under Apple's definition and NSPrivacyTracking
            correctly stays false with no NSPrivacyTrackingDomains entry. Do not
            flip either. See docs/runbooks/native-store-submission.md note 3.
      Apple's manifest allows ONE entry per data type, so both surfaces are declared
      by the single ProductInteraction entry below. It is marked Linked because (a) is
      — the never-under-declare answer — even though (b) on its own is not.
  Family CONTENT (accounts, activities, documents) never leaves the device to us —
  it lives in the user's own encrypted .beanpod / their Google Drive.

  NSPrivacyAccessedAPITypes: required-reason declarations for APIs the statically
  linked Capacitor plugins reach (Capacitor's own frameworks ship manifests with
  empty API lists; the installed plugins ship none). Final validation is App Store
  Connect's automated check at the first TestFlight upload.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCrashData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
