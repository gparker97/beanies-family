<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The widget extension reads the snapshot the app writes into this group, and nothing else.
  It must match `App.entitlements` exactly and be enabled on the
  family.beanies.app.BeaniesWidgets App ID in the Developer portal, or signing cannot
  resolve it. scripts/check-ios-entitlements.sh fails the release if any shipped .appex
  lacks it.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.family.beanies.app</string>
	</array>
</dict>
</plist>
