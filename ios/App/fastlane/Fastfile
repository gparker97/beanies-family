# Fastlane — iOS release lanes for the Capacitor app (ADR-029).
#
# Two lanes, chosen by the workflow's `destination` input:
#   `beta`    → build a signed Release IPA and upload it to TestFlight (internal).
#   `release` → build the same signed IPA and SUBMIT it to the App Store for review,
#               with a post-approval release mode from IOS_DESTINATION.
#
# Both lanes sign with MANUAL signing, using a distribution certificate and App Store
# profiles held by `match` in a private repo. This replaced cloud-managed automatic
# signing on 2026-08-27, and the reason is recorded in full above `build_ipa`: automatic
# signing cannot sign an ARCHIVE for distribution, and an unsigned archive silently loses
# every entitlement, which shipped three iOS builds that could not share at all.
#
# The App Store Connect API key is still used - for match (creating/downloading
# certificates and profiles) and for the upload steps. It needs the Admin role, which it
# already has.
#
# Env provided by .github/workflows/mobile-ios-release.yml:
#   APP_STORE_CONNECT_API_KEY_ID, APP_STORE_CONNECT_API_ISSUER_ID,
#   ASC_API_KEY_P8_PATH (decoded .p8 on disk), APPLE_TEAM_ID,
#   BUILD_NUMBER (CI run number), MARKETING_VERSION, and (for `release`) IOS_DESTINATION.
#   match: MATCH_GIT_URL, MATCH_PASSWORD, MATCH_GIT_BASIC_AUTHORIZATION, and
#   MATCH_BOOTSTRAP (only for the very first run - see `build_ipa`).

default_platform(:ios)

# The built IPA path, defined once. `build_app` takes the directory and name as
# SEPARATE args, so we split this — never pass the combined string to either, or you
# get build/build/beanies.ipa. Both upload steps pass the whole path as `ipa:`.
IPA_PATH = "build/beanies.ipa"

platform :ios do
  # ── Shared building blocks ────────────────────────────────────────────────

  # The App Store Connect API key, used by both lanes' upload step. `build_app` does
  # NOT use it — it authenticates via the `-authenticationKey*` xcargs below — so this
  # is only consumed by upload_to_testflight / upload_to_app_store.
  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      # DELIBERATELY NOT named APP_STORE_CONNECT_API_KEY_PATH. That name is the env var
      # fastlane maps onto the `api_key_path` option of match/sigh/deliver/pilot, so
      # setting it made match see both an implicit `api_key_path` AND the explicit
      # `api_key` passed below and abort with "Unresolved conflict between options". It
      # would have failed even alone: `api_key_path` expects a JSON descriptor, while this
      # is a raw .p8.
      key_filepath: ENV["ASC_API_KEY_P8_PATH"],
      duration: 1200,
      in_house: false
    )
  end

  # The two bundle identifiers that must be signed. The extension is a SEPARATE,
  # separately-signed target with its own App ID, its own profile and its own copy of the
  # app-group entitlement - one side having it is no use, since the group is the only
  # channel between the two processes.
  APP_ID = "family.beanies.app"
  EXTENSION_ID = "family.beanies.app.ShareExtension"

  # Build the signed Release IPA for App Store distribution. Identical for both lanes
  # (TestFlight and App Store both use the `app-store` export), so it lives here once.
  #
  # ── WHY MANUAL SIGNING VIA match, AND NOT AUTOMATIC ─────────────────────────────
  #
  # The archive MUST be signed, because entitlements are embedded BY the code signature
  # rather than written alongside it. An unsigned archive cannot carry them at all, and
  # `-exportArchive` derives its set from what the binary already has. This was measured,
  # not assumed: builds 33-35 shipped with four entitlements and neither the app group nor
  # associated-domains, while the profile granted both, and iPhone sharing was dead the
  # whole time with nothing anywhere reporting it.
  #
  # Automatic signing cannot sign an archive for distribution - Xcode says so itself
  # ("automatically signed for development, but a conflicting code signing identity ...
  # has been manually specified"). It insists on a DEVELOPMENT profile, which needs a
  # registered device, AND a development certificate, which - unlike distribution certs -
  # is NOT cloud-managed and so is absent from every fresh runner. That is the whole
  # reason `skip_codesigning: true` was reached for in the first place, on 2026-08-06.
  #
  # match solves both halves: it holds ONE distribution certificate and the App Store
  # profiles for both bundle IDs, encrypted in a private repo, and installs them on the
  # runner each build. No devices, no cloud-signing dependency, nothing to renew by hand.
  private_lane :build_ipa do
    # Fail on a missing OR PLACEHOLDER credential, with a sentence naming which one and
    # where it goes. Two distinct failure modes, both otherwise confusing:
    #
    #   unset            -> match reports a decryption failure several steps later, which
    #                       reads like a corrupt certificates repo rather than an unset
    #                       secret.
    #   still REPLACE_ME -> the secrets were created as placeholders so they could be
    #                       filled in later. A placeholder is NOT empty, so an
    #                       emptiness-only check would happily pass one through and fail
    #                       identically to the above. Checking for it is the difference
    #                       between "you have not set MATCH_PASSWORD yet" and half an hour
    #                       of debugging git.
    PLACEHOLDER = "REPLACE_ME"
    {
      "MATCH_GIT_URL" => "repository variable MATCH_GIT_URL (the private certificates repo)",
      "MATCH_PASSWORD" => "secret MATCH_PASSWORD (the match encryption passphrase)",
      "MATCH_GIT_BASIC_AUTHORIZATION" => "secret MATCH_GIT_BASIC_AUTHORIZATION (base64 of \"<github-user>:<PAT>\")"
    }.each do |var, where|
      value = ENV[var].to_s.strip
      UI.user_error!(
        "#{var} is not set. iOS signing needs it - add the #{where} on the beanies-family " \
        "repo. See the match setup notes above `build_ipa`."
      ) if value.empty?
      UI.user_error!(
        "#{var} is still the placeholder #{PLACEHOLDER}. Replace it with the real value - " \
        "the #{where}."
      ) if value == PLACEHOLDER
    end

    # A temporary, unlocked keychain for the imported certificate. Without this the
    # import has nowhere to go and signing fails on a GitHub runner. No-op off CI.
    setup_ci

    # Install the certificate + both profiles.
    #
    # READONLY unless explicitly bootstrapping. fastlane recommends readonly on CI, and
    # here it is load-bearing: Apple caps distribution certificates at a small number, so
    # a run that silently decided to mint a new one on every build would exhaust the
    # account. Read-only fails loudly instead, which is the behaviour we want when a
    # profile has been revoked or the repo is unreachable.
    bootstrap = ENV["MATCH_BOOTSTRAP"].to_s == "true"
    UI.important("MATCH_BOOTSTRAP is set - match may CREATE a certificate/profiles.") if bootstrap
    match(
      type: "appstore",
      app_identifier: [APP_ID, EXTENSION_ID],
      api_key: asc_api_key,
      readonly: !bootstrap
    )

    # Point each target at its own profile and switch it off automatic signing.
    #
    # Done here rather than committed into project.pbxproj because the profile NAMES are
    # match's to choose, and because xcargs cannot express this: build settings passed on
    # the command line apply to every target at once, and these two targets need
    # different profiles. match exports the names it installed as `sigh_<id>_<type>`.
    [[APP_ID, "App"], [EXTENSION_ID, "ShareExtension"]].each do |identifier, target|
      profile = ENV["sigh_#{identifier}_appstore_profile-name"] || ENV["sigh_#{identifier}_appstore"]
      UI.user_error!(
        "match did not report a profile for #{identifier}. Expected the env var " \
        "sigh_#{identifier}_appstore_profile-name to be set. Check the match step above."
      ) if profile.to_s.empty?

      update_code_signing_settings(
        path: "App.xcodeproj",
        use_automatic_signing: false,
        team_id: ENV["APPLE_TEAM_ID"],
        targets: [target],
        code_sign_identity: "Apple Distribution",
        profile_name: profile,
        bundle_identifier: identifier
      )
    end

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_team_id: ENV["APPLE_TEAM_ID"],
      # Manual signing end to end now, so the export uses the same profiles the archive
      # was signed against rather than re-resolving anything.
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          APP_ID => ENV["sigh_#{APP_ID}_appstore_profile-name"],
          EXTENSION_ID => ENV["sigh_#{EXTENSION_ID}_appstore_profile-name"]
        }
      },
      # Version stamping only. No `-allowProvisioningUpdates` and no auth flags: nothing
      # here talks to Apple any more, because match already installed everything.
      xcargs: "CURRENT_PROJECT_VERSION=#{ENV['BUILD_NUMBER']} " \
              "MARKETING_VERSION=#{ENV['MARKETING_VERSION']}",
      output_directory: File.dirname(IPA_PATH),
      output_name: File.basename(IPA_PATH)
    )
  end

  # Assert the SHIPPED binaries still carry the app-group entitlement.
  #
  # Runs BEFORE either upload, so a build that cannot share never consumes a TestFlight
  # build number and never costs a test cycle. It is here rather than as a workflow step
  # because build and upload are one `fastlane` invocation — a step after it would only
  # ever run once the broken build was already on TestFlight.
  #
  # This exists because the entitlement can be silently dropped between the .entitlements
  # file and the user's phone (the archive is built with CODE_SIGN_ENTITLEMENTS='' and the
  # profile is resolved at export), and nothing else on the path checks. See the script
  # header — three builds shipped before CloudWatch caught it.
  private_lane :verify_entitlements do
    # The escape hatch is opt-IN and says plainly what it costs, so an urgent unrelated
    # release is not held hostage by a signing problem — but nobody reaches for it by
    # accident, which is the only way this check keeps its value.
    if ENV["SKIP_ENTITLEMENT_CHECK"].to_s == "true"
      UI.important("SKIPPING the entitlement check by request — sharing and Universal Links will NOT work in this build.")
      next
    end
    # ABSOLUTE paths, resolved from this file's own location: `sh` runs in the Fastfile's
    # directory (ios/App/fastlane), which is three levels below the repo root, and a
    # relative path that is wrong by one level fails the release for the wrong reason.
    script = File.expand_path("../../../scripts/check-ios-entitlements.sh", __dir__)
    ipa = File.expand_path("../#{IPA_PATH}", __dir__)
    sh("bash '#{script}' '#{ipa}'")
  end

  # ── Lanes ─────────────────────────────────────────────────────────────────

  desc "Build the Release IPA and upload it to TestFlight (internal testers)"
  lane :beta do
    build_ipa
    verify_entitlements
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: IPA_PATH,
      # Don't block the CI job on Apple's async build processing; check status in
      # App Store Connect / TestFlight.
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build the Release IPA and submit it to the App Store for review"
  lane :release do
    # IOS_DESTINATION carries the workflow's full `destination` value (e.g.
    # "appstore-automatic"). The workflow already routed us here by matching the
    # `appstore-` prefix (see the run: step in mobile-ios-release.yml); here we strip
    # that same prefix to resolve the post-approval release mode. That prefix is the
    # ONLY cross-file coupling — adding a destination option means updating both the
    # workflow's `options:` list AND this case. Unset defaults to the safest hold
    # (manual); it only bites on a bare local `fastlane release`, since the workflow
    # always sets the env.
    raw = ENV["IOS_DESTINATION"] || "appstore-manual"
    release_opts =
      case raw.sub(/^appstore-/, "")
      when "manual" then { automatic_release: false, phased_release: false }
      when "automatic" then { automatic_release: true }
      # phased => 7-day staged rollout. VERIFY ON FIRST RUN whether ASC starts the
      # rollout automatically on approval or waits for a manual Release click; if it
      # holds, add automatic_release: true here.
      when "phased" then { phased_release: true }
      else
        UI.user_error!(
          "IOS_DESTINATION must be appstore-manual|appstore-automatic|appstore-phased, got '#{raw}'"
        )
      end

    # Apple requires a "What's New" note on every update version — without it the new
    # version record stays in an unsubmittable state and submit_for_review fails with
    # "appStoreVersions ... is not in valid state" (learned the hard way on the first
    # 0.9.12 submit). Fail loud rather than upload a build that then can't be submitted.
    whats_new = ENV["WHATS_NEW"].to_s.strip
    UI.user_error!(
      "WHATS_NEW is required for an App Store submission (Apple requires a 'What's New' note on every update). " \
      "Pass it via the workflow's `whats_new` input."
    ) if whats_new.empty?

    # Promotional text (optional, ≤170 chars). UNLIKE "What's New", it is NOT tied to
    # a version and needs no App Store review, so it is safe to refresh on any release.
    # When the input is empty we omit it entirely, leaving the current App Store value
    # untouched. Keyed to the real "en-US" locale for the same reason as release_notes.
    promo_text = ENV["PROMOTIONAL_TEXT"].to_s.strip
    promo_opts = promo_text.empty? ? {} : { promotional_text: { "en-US" => promo_text } }

    build_ipa
    verify_entitlements
    upload_to_app_store(
      api_key: asc_api_key,
      ipa: IPA_PATH,
      submit_for_review: true,
      force: true,                      # no interactive HTML preview on CI
      run_precheck_before_submit: false, # avoids a flaky ASC round-trip
      # We set ONLY the version "What's New" note. Passing release_notes as a direct
      # option (not a metadata dir) is surgical — deliver uploads just this field and
      # leaves the app's approved name/description/keywords/screenshots untouched.
      # Key it to the REAL locale ("en-US"), NOT deliver's "default" pseudo-locale:
      # "default" uploads the note but does NOT create the concrete version
      # localization the review submission validates, so submit_for_review then fails
      # with "appStoreVersions … is not in valid state / missing attribute 'whatsNew'"
      # (learned the hard way on the 0.9.13 submit). If a new App Store locale is ever
      # added, add its key here (and to promo_opts above) too.
      skip_screenshots: true,
      release_notes: { "en-US" => whats_new },
      # Cancel a submission that is already in review so this build can replace it.
      #
      # An App Store version in "Waiting for Review" is NOT editable, so `select_build`
      # cannot swap in the new binary: the 0.16 release uploaded and processed fine, then
      # died on "The specified pre-release build could not be added" because build 65 was
      # still pending. deliver cancels the submission and polls until it clears (runner.rb
      # `reject_version_if_possible`), which is exactly the manual App Store Connect dance
      # that unblocked it.
      #
      # OPT-IN, never the default: Apple does not distinguish "waiting for review" from
      # "in review" here, and cancelling the latter pulls the build out from under a
      # reviewer and returns it to the back of the queue. The preflight
      # (assert-no-pending-submission.mjs) fails the run early and names this flag rather
      # than letting a routine release silently torpedo a review in flight.
      reject_if_possible: ENV["REPLACE_PENDING_SUBMISSION"].to_s.strip == "true",
      # Belt-and-braces to Info.plist's ITSAppUsesNonExemptEncryption=false so a
      # submission never stalls on the export-compliance prompt.
      submission_information: { export_compliance_uses_encryption: false },
      **promo_opts,
      **release_opts
    )
  end
end
