{
  "name": "beanies-family",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "web",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:web": "npm --workspace=@beanies/web run dev",
    "dev:all": "concurrently --names 'vue,astro' --prefix-colors 'cyan,magenta' --kill-others-on-fail 'npm:dev' 'npm:dev:web'",
    "build": "vue-tsc -b && vite build",
    "build:web": "npm --workspace=@beanies/web run build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:report": "playwright show-report",
    "promo:record": "playwright test -c playwright.video.config.ts",
    "promo:compose": "bash scripts/promo-video/compose.sh",
    "store:screenshots": "playwright test -c playwright.screenshots.config.ts",
    "translate": "node scripts/updateTranslations.mjs --all",
    "translate:zh": "node scripts/updateTranslations.mjs zh",
    "update-airports": "node scripts/updateAirports.mjs",
    "generate:holidays": "node scripts/generateHolidays.mjs",
    "lint": "npm run lint:eslint && npm run lint:style",
    "lint:eslint": "eslint .",
    "lint:style": "stylelint \"src/**/*.{vue,css}\"",
    "lint:fix": "npm run lint:eslint -- --fix && npm run lint:style -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "vue-tsc -b --noEmit",
    "validate": "npm run type-check && npm run lint && npm run format:check && npm run test:run && npm run build",
    "security:check": "npm run security:audit; npm run security:lint",
    "security:audit": "npm audit --audit-level=moderate",
    "security:audit:fix": "npm audit fix",
    "security:lint": "eslint . --config eslint.security.config.js",
    "security:full": "npm run security:lint && npm run type-check",
    "prepare": "husky",
    "promo:studio": "remotion studio promo/index.ts",
    "promo:render": "remotion render promo/index.ts promo scripts/promo-video/.out/promo.mp4"
  },
  "dependencies": {
    "@automerge/automerge": "^3.2.6",
    "@beanies/brand": "*",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "chart.js": "^4.5.1",
    "idb": "^8.0.3",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^4.0.2",
    "qrcode": "^1.5.4",
    "vue": "^3.5.40",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1090.0",
    "@aws-sdk/util-dynamodb": "^3.996.7",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^9.39.2",
    "@heroicons/vue": "^2.2.0",
    "@microsoft/eslint-plugin-sdl": "^1.1.0",
    "@playwright/test": "^1.61.1",
    "@remotion/cli": "^4.0.494",
    "@remotion/google-fonts": "^4.0.494",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.3",
    "date-holidays": "^3.33.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-vue": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "postcss": "^8.5.20",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remotion": "^4.0.487",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-order": "^8.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "overrides": {
    "serialize-javascript": "^7.0.3"
  }
}
