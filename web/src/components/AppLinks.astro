---
// AppLinks (#118, docs/plans/2026-10-02-utm-attribution-carry-through.md, Section B).
//
// This component is the SINGLE OWNER of every app-bound-link concern on the site:
//   1. tag capture: the landing URL's campaign tag is kept on the device for 30 days
//      (first touch wins), via `readStoredAttribution` (`lib/storedAttribution.ts`);
//   2. the first-party `landing` event: one beacon per entry pageview (`lib/marketingEvents.ts`);
//   3. href decoration: every link into the app (`APP_URL`) AND the site's own /ios and
//      /android badge links carries that tag, so the app can record which of our own ads or
//      posts brought a family, and the redirect page can record it on the `store_tap`;
//   4. the CTA click event: the delegated Plausible listener for every `data-cta` element.
//
// The `store_tap` event is NOT sent here: the /ios and /android redirect pages own it
// (`lib/storeRedirect.ts`), so a tap is counted once however the visitor reached the page.
//
// The CTA listener lives here BECAUSE its `attributed` prop reads the same `fields` the
// decorator uses. Do not split this back into per-host inline copies (BaseLayout and
// /download each used to carry one). Render `<AppLinks />` immediately after the
// Plausible loader + stub queue, which stay `is:inline` in each host.
//
// A bare (hoisted, bundled) script tag, not an `is:inline` one: it has to import the shared module.
// The build-time guard (`src/lib/assert-cta-tagged.mjs`) checks `data-cta` only; the query
// string is added here at runtime, so the guard cannot and should not look for it.
---

<script>
  import { appendAttribution, type Attribution } from '@beanies/brand/attribution';
  import { APP_URL } from '@beanies/brand/nav';
  import { isEntryPageview, sendMarketingEvent } from '../lib/marketingEvents';
  import { readStoredAttribution } from '../lib/storedAttribution';

  /** The site's own store redirect pages: decorated with the tag so they can record it. */
  const STORE_PATHS = new Set(['/ios', '/android']);

  type PlausibleFn = (name: string, opts?: { props?: Record<string, string> }) => void;

  // 1. Capture (first touch wins) and the entry-pageview event. Computed once, so a tag
  //    captured on this very page decorates its links and reports `attributed: yes`.
  const fields: Attribution | null = readStoredAttribution(location.search);
  if (isEntryPageview()) sendMarketingEvent({ kind: 'landing', fields, loc: location.pathname });

  // 2. Decoration. Idempotent: `appendAttribution` never overwrites a parameter already on
  //    the link and returns off-origin hrefs unchanged. The allowed origin is the site's own for
  //    a /ios or /android link, the app's for everything else.
  function decorateAnchor(a: HTMLAnchorElement): void {
    if (!fields) return;
    const origin =
      STORE_PATHS.has(a.pathname) && a.origin === location.origin ? location.origin : APP_URL;
    const next = appendAttribution(a.href, fields, origin);
    if (next !== a.href) a.href = next;
  }

  // One pass on load (so hover preview, copy-link, ctrl-click and open-in-new-tab carry the
  // tag) plus the clicked anchor in the listener below (covers a late-inserted link). The
  // origin is quoted: the `:` in `http://` breaks an unquoted attribute selector. There is
  // no ClientRouter/ViewTransitions on the site, so one pass per page load is enough.
  function decorateAll(): void {
    if (!fields) return;
    document
      .querySelectorAll<HTMLAnchorElement>(
        `a[href^="${APP_URL}"], a[href="/ios"], a[href="/android"]`
      )
      .forEach(decorateAnchor);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', decorateAll, { once: true });
  } else {
    decorateAll();
  }

  // 3. CTA click tracking.
  //    ONE delegated listener rather than a handler per button: CTAs live across the
  //    homepage, the download page, guides, help and the beanstalk footer, and a
  //    per-call-site handler is how three of them end up untracked after the next redesign.
  //    Any element carrying data-cta fires; adding a CTA anywhere is a one-attribute change.
  //
  //    Distinct goal names (not one "CTA Click" with a prop) because Plausible funnels and
  //    the goal list key on the event NAME; a single event with properties cannot be a
  //    funnel step. `location` rides along as a property so the same CTA can be compared
  //    across placements; `attributed` makes a dropped tag visible as a ratio.
  //
  //    Uses closest(), so a click on the <img> inside a store badge still resolves to the
  //    anchor that carries the attribute.
  document.addEventListener(
    'click',
    (e) => {
      const target = e.target instanceof Element ? e.target : null;
      if (!target) return;
      const anchor = target.closest('a[href]');
      if (anchor instanceof HTMLAnchorElement) decorateAnchor(anchor);
      const el = target.closest('[data-cta]');
      const name = el?.getAttribute('data-cta');
      if (!el || !name) return;
      const plausible = (window as unknown as { plausible?: PlausibleFn }).plausible;
      plausible?.(name, {
        props: {
          location: el.getAttribute('data-cta-loc') || 'unknown',
          attributed: fields ? 'yes' : 'no',
        },
      });
    },
    // Capture phase: these anchors navigate away, and a bubble-phase listener can lose the
    // race with the unload on a slow connection.
    true
  );
</script>
