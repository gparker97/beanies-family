<style is:global>
  /* NAMESPACED-GLOBAL: every selector is prefixed hsx- (or scoped under .hsx), so
     this stylesheet is collision-safe with the marketing site's global classes
     (.card/.tag/.btn-primary). It must be GLOBAL, not Astro-scoped, because the
     cluster, carousel, scaleboxes and dots are created in JS — and Astro scoped
     styles only reach server-rendered elements. */
  .hsx {
    --hsx-orange: #f15d22;
    --hsx-terracotta: #e67e22;
    --hsx-slate: #2c3e50;
    --hsx-slate2: #3d5368;
    --hsx-sky: #aed6f1;
    --hsx-cloud: #f8f9fa;
    --hsx-green: #27ae60;
    --hsx-purple: #9b59b6;
    --hsx-teal: #00b4d8;
    --hsx-hair: rgba(44, 62, 80, 0.09);
    --hsx-greg: #3b82f6;
    --hsx-sarah: #ec4899;
    --hsx-emma: #f59e0b;
    --hsx-liam: #10b981;
    width: 100%;
    max-width: 1160px;
    margin: 16px auto 0;
    font-family: Inter, system-ui, sans-serif;
    color: var(--hsx-slate);
    /* decorative preview — never selectable (also avoids drag-to-scroll selecting text) */
    user-select: none;
    -webkit-user-select: none;
  }
  .hsx *,
  .hsx *::before,
  .hsx *::after { box-sizing: border-box; }
  .hsx b,
  .hsx .hsx-mchip,
  .hsx .hsx-badge-cd { font-weight: 700; }

  .hsx-stage { position: relative; min-width: 0; }
  /* Desktop cluster: a browser-framed desktop on the left, two phones to its
     right with a clear gap (only the two phones lightly overlap, for depth).
     Content spans x:0..962 inside a 970-wide box that the script scales to fill
     the stage (up to 1.18x on wide screens) and centers via translateX(-50%). */
  .hsx-inner { position: absolute; top: 0; left: 50%; width: 970px; height: 478px; transform-origin: top center; }
  .hsx-anchor { position: absolute; }
  .hsx-anchor--d { top: 30px; left: 0; z-index: 2; }
  .hsx-anchor--a { top: 4px; left: 566px; z-index: 4; }
  .hsx-anchor--b { top: 26px; left: 742px; z-index: 5; }
  .hsx-scalebox { position: relative; }
  .hsx-scalebox > .hsx-device { position: absolute; top: 0; left: 0; transform-origin: top left; }

  /* desktop stepper arrows (hidden on the mobile carousel; that swipes instead) */
  .hsx-arrow {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 20;
    width: 42px; height: 42px; border-radius: 50%; background: #fff;
    border: 1px solid var(--hsx-hair); box-shadow: 0 6px 18px rgba(44, 62, 80, 0.16);
    color: var(--hsx-slate); font-family: Outfit, sans-serif; font-size: 1.5rem; line-height: 1;
    display: flex; align-items: center; justify-content: center; cursor: pointer;
    opacity: 0; transition: opacity 0.2s ease, transform 0.15s ease; padding: 0 0 3px;
  }
  .hsx-stage:hover .hsx-arrow, .hsx-arrow:focus-visible { opacity: 0.92; }
  .hsx-arrow:hover { opacity: 1; }
  .hsx-arrow--prev { left: 2px; }
  .hsx-arrow--next { right: 2px; }
  .hsx-arrow:hover { transform: translateY(-50%) scale(1.08); }

  .hsx-carousel { display: flex; gap: 18px; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
  .hsx-carousel::-webkit-scrollbar { display: none; }
  .hsx-carcell { flex: 0 0 auto; scroll-snap-align: center; }
  .hsx-dots { display: flex; gap: 7px; justify-content: center; margin-top: 12px; }
  .hsx-dots b { width: 7px; height: 7px; border-radius: 50%; background: rgba(44, 62, 80, 0.18); cursor: pointer; transition: width 0.2s, background 0.2s; display: block; }
  .hsx-dots b.hsx-on { background: var(--hsx-orange); width: 20px; border-radius: 4px; }

  /* ---- device shells ---- */
  .hsx-device { background: #fff; position: relative; }
  .hsx-device--desktop { width: 760px; border-radius: 13px; overflow: hidden; box-shadow: 0 28px 64px rgba(44,62,80,0.22), 0 5px 14px rgba(44,62,80,0.08); border: 1px solid var(--hsx-hair); }
  .hsx-device--phone { width: 290px; border-radius: 34px; background: #1c2733; padding: 9px; box-shadow: 0 30px 56px rgba(44,62,80,0.28), 0 6px 16px rgba(44,62,80,0.12); }

  .hsx-bbar { display: flex; align-items: center; gap: 12px; padding: 9px 13px; background: #eef1f4; border-bottom: 1px solid var(--hsx-hair); }
  .hsx-bbar__dots { display: flex; gap: 6px; }
  .hsx-bbar__dots i { width: 10px; height: 10px; border-radius: 50%; display: block; }
  .hsx-bbar__url { flex: 1; background: #fff; border-radius: 7px; font-size: 0.64rem; color: #7b8894; padding: 5px 12px; display: flex; align-items: center; gap: 6px; border: 1px solid var(--hsx-hair); }
  .hsx-bbar__url b { color: var(--hsx-slate); font-weight: 600; }
  .hsx-bbar__url span { color: #b3bcc5; }

  .hsx-shell { display: grid; grid-template-columns: 172px 1fr; height: 452px; }
  .hsx-main { display: flex; flex-direction: column; }
  .hsx-sb { background: var(--hsx-slate); color: #fff; padding: 13px 9px; overflow: hidden; }
  .hsx-sb__logo { display: flex; align-items: center; gap: 7px; padding: 0 4px 12px; }
  .hsx-mark { width: 26px; height: 26px; border-radius: 8px; background: linear-gradient(135deg, var(--hsx-orange), var(--hsx-terracotta)); display: flex; align-items: center; justify-content: center; font-size: 0.9rem; }
  .hsx-sb__logo b { font-family: Outfit, sans-serif; font-weight: 800; font-size: 0.84rem; }
  .hsx-sb__logo b em { color: var(--hsx-orange); font-style: normal; }
  .hsx-sb__sec { font-size: 0.55rem; letter-spacing: 0.09em; text-transform: uppercase; font-weight: 800; margin: 11px 6px 5px; display: flex; align-items: center; gap: 5px; }
  .hsx-sb__sec--tree { color: #f8b78f; }
  .hsx-sb__sec--pig { color: #7fd6a1; }
  .hsx-sb__item { display: flex; align-items: center; gap: 8px; padding: 6px 8px; border-radius: 8px; font-size: 0.7rem; color: rgba(255,255,255,0.72); margin-bottom: 1px; position: relative; }
  .hsx-sb__item i { width: 15px; text-align: center; font-size: 0.78rem; font-style: normal; }
  .hsx-sb__item.hsx-on { background: linear-gradient(90deg, rgba(241,93,34,0.95), rgba(230,126,34,0.85)); color: #fff; font-weight: 600; box-shadow: inset 3px 0 0 #fff3; }
  .hsx-sb__item.hsx-badge::after { content: ''; margin-left: auto; width: 6px; height: 6px; border-radius: 50%; background: var(--hsx-orange); }

  .hsx-hd { height: 52px; display: flex; align-items: center; justify-content: space-between; padding: 0 16px; border-bottom: 1px solid var(--hsx-hair); background: #fff; }
  .hsx-hd__title b { font-family: Outfit, sans-serif; font-weight: 700; font-size: 0.94rem; color: var(--hsx-slate); display: block; line-height: 1.1; }
  .hsx-hd__title span { font-size: 0.6rem; color: var(--hsx-orange); font-weight: 600; }
  .hsx-hd__ctrls { display: flex; align-items: center; gap: 7px; }
  .hsx-ctl { height: 26px; min-width: 26px; padding: 0 7px; border-radius: 8px; background: #fff; border: 1px solid var(--hsx-hair); box-shadow: 0 1px 3px rgba(44,62,80,0.06); display: flex; align-items: center; justify-content: center; gap: 3px; font-size: 0.62rem; color: #6b7a89; }
  .hsx-ctl--on { background: var(--hsx-orange); color: #fff; border-color: var(--hsx-orange); font-weight: 700; }
  .hsx-av { width: 24px; height: 24px; border-radius: 7px; background: linear-gradient(135deg, var(--hsx-greg), #6ea8ff); color: #fff; font-family: Outfit, sans-serif; font-weight: 700; font-size: 0.66rem; display: flex; align-items: center; justify-content: center; }

  .hsx-board { background: var(--hsx-cloud); padding: 15px 16px; overflow: hidden; display: flex; flex-direction: column; gap: 11px; }

  .hsx-nw { background: linear-gradient(135deg, var(--hsx-slate), var(--hsx-slate2)); border-radius: 15px; padding: 15px 16px; color: #fff; position: relative; overflow: hidden; }
  .hsx-nw::after { content: ''; position: absolute; width: 220px; height: 220px; border-radius: 50%; right: -80px; top: -90px; background: radial-gradient(circle, rgba(241,93,34,0.5), transparent 68%); }
  .hsx-nw__lbl { font-size: 0.56rem; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.6); font-weight: 700; }
  .hsx-nw__amt { font-family: Outfit, sans-serif; font-weight: 800; font-size: 2rem; letter-spacing: -0.01em; line-height: 1.05; }
  .hsx-nw__chg { font-size: 0.62rem; color: #6ee7b7; font-weight: 600; }
  .hsx-nw__pills { position: absolute; top: 14px; right: 15px; display: flex; gap: 3px; z-index: 2; }
  .hsx-nw__pills b { font-size: 0.5rem; font-weight: 700; padding: 3px 7px; border-radius: 6px; background: rgba(255,255,255,0.12); color: rgba(255,255,255,0.7); }
  .hsx-nw__pills b.hsx-on { background: var(--hsx-orange); color: #fff; }
  .hsx-nw__chart { margin-top: 9px; height: 42px; }

  .hsx-tiles { display: grid; grid-template-columns: repeat(5, 1fr); gap: 7px; }
  .hsx-tile { background: #fff; border: 1px solid var(--hsx-hair); border-radius: 10px; padding: 8px; position: relative; overflow: hidden; }
  .hsx-tile::before { content: ''; position: absolute; left: 0; top: 0; height: 3px; width: 100%; background: var(--accent, var(--hsx-orange)); }
  .hsx-tile i { font-size: 0.78rem; font-style: normal; }
  .hsx-tile .hsx-k { font-size: 0.5rem; text-transform: uppercase; color: #90a0ad; font-weight: 700; margin-top: 2px; }
  .hsx-tile .hsx-v { font-family: Outfit, sans-serif; font-weight: 800; font-size: 0.82rem; color: var(--hsx-slate); }
  .hsx-tile .hsx-pct { font-size: 0.5rem; font-weight: 700; color: var(--accent, var(--hsx-orange)); }

  .hsx-srow { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .hsx-stat { background: #fff; border: 1px solid var(--hsx-hair); border-radius: 11px; padding: 9px 10px; }
  .hsx-stat--dark { background: linear-gradient(135deg, var(--hsx-slate), var(--hsx-slate2)); border: none; color: #fff; }
  .hsx-si { width: 22px; height: 22px; border-radius: 7px; display: flex; align-items: center; justify-content: center; font-size: 0.68rem; }
  .hsx-sk { font-size: 0.5rem; text-transform: uppercase; color: #90a0ad; font-weight: 700; margin-top: 5px; }
  .hsx-stat--dark .hsx-sk { color: rgba(255,255,255,0.55); }
  .hsx-sv { font-family: Outfit, sans-serif; font-weight: 800; font-size: 0.92rem; }
  .hsx-sc { font-size: 0.5rem; color: var(--hsx-green); font-weight: 600; }

  .hsx-row { display: flex; align-items: center; gap: 8px; padding: 5px 0; }
  .hsx-ic { width: 26px; height: 26px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 0.78rem; flex: none; }
  .hsx-nm { font-size: 0.64rem; font-weight: 600; color: var(--hsx-slate); }
  .hsx-sub { font-size: 0.52rem; color: #97a3ae; }

  .hsx-prog { height: 5px; background: rgba(44,62,80,0.07); border-radius: 3px; overflow: hidden; }
  .hsx-prog i { display: block; height: 100%; border-radius: 3px; background: linear-gradient(90deg, var(--hsx-orange), var(--hsx-terracotta)); }
  .hsx-lbl { font-size: 0.56rem; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; color: #90a0ad; }
  .hsx-see { font-size: 0.56rem; color: var(--hsx-orange); font-weight: 700; }
  .hsx-card { background: #fff; border: 1px solid var(--hsx-hair); border-radius: 13px; padding: 11px 12px; }
  .hsx-card--l { border-left: 4px solid var(--hsx-sky); }
  .hsx-card--lo { border-left: 4px solid var(--hsx-orange); }

  .hsx-mchip { display: inline-flex; align-items: center; gap: 4px; font-size: 0.56rem; padding: 3px 8px; border-radius: 999px; background: #fff; border: 1px solid var(--hsx-hair); color: #64717d; }
  .hsx-dot { width: 14px; height: 14px; border-radius: 50%; color: #fff; font-size: 0.5rem; font-weight: 800; display: inline-flex; align-items: center; justify-content: center; font-family: Outfit, sans-serif; flex: none; }

  /* calendar */
  .hsx-nav { display: flex; gap: 3px; }
  .hsx-nav b { width: 18px; height: 18px; border-radius: 6px; background: #fff; border: 1px solid var(--hsx-hair); display: flex; align-items: center; justify-content: center; font-size: 0.62rem; color: #7b8894; }
  .hsx-today { font-size: 0.54rem; color: var(--hsx-orange); font-weight: 700; padding: 3px 8px; border-radius: 7px; background: rgba(241,93,34,0.08); }
  .hsx-vtog { display: flex; background: #fff; border: 1px solid var(--hsx-hair); border-radius: 9px; overflow: hidden; }
  .hsx-vtog b { font-size: 0.54rem; font-weight: 700; padding: 4px 9px; color: #90a0ad; }
  .hsx-vtog b.hsx-on { background: linear-gradient(135deg, var(--hsx-orange), var(--hsx-terracotta)); color: #fff; }
  .hsx-cal { background: #fff; border: 1px solid var(--hsx-hair); border-radius: 13px; padding: 11px; }
  .hsx-cal__wk { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; margin-bottom: 5px; }
  .hsx-cal__wk span { text-align: center; font-size: 0.5rem; color: #b3bcc5; font-weight: 800; }
  .hsx-cal__grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
  .hsx-cell { min-height: 40px; border-radius: 7px; padding: 3px; background: #fcfdfe; border: 1px solid rgba(44,62,80,0.04); display: flex; flex-direction: column; gap: 2px; }
  .hsx-cell .hsx-d { font-size: 0.5rem; color: #8a97a4; font-weight: 700; text-align: center; }
  .hsx-cell.hsx-wknd { background: #fafbfc; }
  .hsx-cell.hsx-tdy .hsx-d { background: linear-gradient(135deg, var(--hsx-orange), var(--hsx-terracotta)); color: #fff; border-radius: 50%; width: 14px; height: 14px; line-height: 14px; margin: 0 auto; }
  .hsx-ev { font-size: 0.46rem; padding: 1px 3px; border-radius: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; border-left: 2px solid var(--c, var(--hsx-orange)); background: color-mix(in srgb, var(--c, var(--hsx-orange)) 13%, #fff); color: var(--hsx-slate); font-weight: 600; }
  .hsx-vac { font-size: 0.46rem; background: color-mix(in srgb, var(--hsx-teal) 16%, #fff); color: #0077b6; border-radius: 4px; padding: 1px 4px; font-weight: 700; }

  /* travel */
  .hsx-hand { font-family: Caveat, cursive; color: var(--hsx-orange); font-size: 0.86rem; font-weight: 700; }
  .hsx-trip { border-radius: 14px; border: 1px solid var(--hsx-hair); overflow: hidden; background: #fff; }
  .hsx-trip__hero { height: 46px; background: linear-gradient(120deg, color-mix(in srgb, var(--hsx-teal) 22%, #fff), color-mix(in srgb, #ffd93d 30%, #fff)); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
  .hsx-trip__b { padding: 9px 11px; }
  .hsx-trip__nm { font-family: Outfit, sans-serif; font-weight: 700; font-size: 0.76rem; color: var(--hsx-slate); }
  .hsx-trip__dt { font-size: 0.54rem; color: #97a3ae; margin-bottom: 5px; }
  .hsx-badge-cd { display: inline-block; font-size: 0.5rem; color: #fff; padding: 2px 8px; border-radius: 999px; background: linear-gradient(135deg, var(--hsx-teal), #0077b6); }
  .hsx-badge-warn { font-size: 0.5rem; font-weight: 700; color: #b8860b; background: #fff6da; padding: 2px 7px; border-radius: 999px; }

  /* todo */
  .hsx-todo-lbl { font-size: 0.6rem; font-weight: 800; margin: 2px 0 5px; }
  .hsx-todo { display: flex; align-items: flex-start; gap: 8px; background: #fff; border: 1px solid var(--hsx-hair); border-radius: 11px; padding: 8px 10px; }
  .hsx-box { width: 17px; height: 17px; border-radius: 5px; border: 2.5px solid var(--hsx-orange); flex: none; margin-top: 1px; }
  .hsx-box.hsx-red { border-color: #e74c3c; }
  .hsx-box.hsx-sky { border-color: var(--hsx-sky); }
  .hsx-tt { font-size: 0.64rem; font-weight: 600; color: var(--hsx-slate); }
  .hsx-meta { display: flex; gap: 4px; margin-top: 3px; flex-wrap: wrap; }
  .hsx-ttag { font-size: 0.48rem; font-weight: 700; padding: 2px 6px; border-radius: 999px; }
  .hsx-ttag--over { background: var(--hsx-orange); color: #fff; }
  .hsx-ttag--due { background: rgba(241,93,34,0.12); color: var(--hsx-orange); }
  .hsx-ttag--date { color: var(--hsx-orange); }

  /* nook */
  .hsx-greet { font-family: Outfit, sans-serif; font-weight: 800; font-size: 1rem; color: var(--hsx-slate); }
  .hsx-greet span { color: var(--hsx-orange); }
  .hsx-toast { background: linear-gradient(135deg, var(--hsx-orange), var(--hsx-terracotta) 70%, #d4701e); border-radius: 14px; padding: 11px 12px; color: #fff; box-shadow: 0 8px 20px rgba(241,93,34,0.28); }
  .hsx-toast__h { display: flex; align-items: center; gap: 8px; }
  .hsx-toast__ic { width: 30px; height: 30px; border-radius: 9px; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; font-size: 0.95rem; }
  .hsx-toast__t { font-family: Outfit, sans-serif; font-weight: 700; font-size: 0.72rem; }
  .hsx-toast__s { font-size: 0.52rem; opacity: 0.85; font-style: italic; }
  .hsx-toast__row { display: flex; align-items: center; gap: 6px; background: rgba(255,255,255,0.15); border-radius: 8px; padding: 5px 7px; margin-top: 6px; font-size: 0.56rem; }
  .hsx-beans { display: flex; gap: 10px; }
  .hsx-bean { display: flex; flex-direction: column; align-items: center; gap: 3px; }
  .hsx-bean .hsx-a { width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-family: Outfit, sans-serif; font-weight: 800; font-size: 0.8rem; border: 2px solid #fff; box-shadow: 0 2px 6px rgba(44,62,80,0.15); position: relative; }
  .hsx-bean .hsx-a::after { content: ''; position: absolute; right: 0; bottom: 0; width: 8px; height: 8px; border-radius: 50%; background: var(--hsx-green); border: 1.5px solid #fff; }
  .hsx-bean .hsx-nm { font-size: 0.5rem; font-weight: 700; color: var(--hsx-slate); }
  .hsx-bean .hsx-rl { font-size: 0.44rem; color: #97a3ae; }
  .hsx-bean .hsx-add { border: 1.5px dashed #c3ccd4; color: #97a3ae; box-shadow: none; }
  .hsx-bean .hsx-add::after { display: none; }

  /* phone chrome */
  .hsx-ph { background: var(--hsx-cloud); border-radius: 26px; overflow: hidden; height: 574px; display: flex; flex-direction: column; position: relative; }
  .hsx-ph__status { height: 26px; display: flex; align-items: center; justify-content: space-between; padding: 0 18px 0 20px; font-family: Outfit, sans-serif; font-weight: 700; font-size: 0.66rem; color: var(--hsx-slate); flex: none; }
  .hsx-sigs { display: flex; align-items: center; gap: 3px; }
  .hsx-sigs b { width: 15px; height: 8px; border: 1px solid var(--hsx-slate); border-radius: 2px; display: inline-block; position: relative; }
  .hsx-sigs b::after { content: ''; position: absolute; inset: 1px; right: 4px; background: var(--hsx-slate); border-radius: 1px; }
  .hsx-ph__hd { height: 42px; display: flex; align-items: center; justify-content: space-between; padding: 0 13px; flex: none; }
  .hsx-burger { display: flex; flex-direction: column; gap: 3px; }
  .hsx-burger i { width: 15px; height: 2px; background: var(--hsx-slate); border-radius: 2px; }
  .hsx-ph__hd .hsx-t { font-family: Outfit, sans-serif; font-weight: 700; font-size: 0.8rem; color: var(--hsx-slate); }
  .hsx-ph__hd .hsx-t span { color: var(--hsx-orange); }
  .hsx-ph__hd .hsx-r { display: flex; align-items: center; gap: 8px; font-size: 0.82rem; }
  .hsx-ph__hd .hsx-r .hsx-av { width: 22px; height: 22px; }
  .hsx-ph__body { flex: 1; overflow: hidden; padding: 4px 11px 8px; display: flex; flex-direction: column; gap: 8px; }
  .hsx-ph__body > * { flex: 0 0 auto; }

  .hsx-tabs { flex: none; height: 54px; background: #fff; border-top: 1px solid var(--hsx-hair); display: flex; align-items: flex-start; justify-content: space-around; padding-top: 7px; position: relative; }
  .hsx-tab { display: flex; flex-direction: column; align-items: center; gap: 2px; font-size: 0.5rem; font-weight: 600; color: rgba(44,62,80,0.4); width: 46px; }
  .hsx-tab i { font-size: 1.05rem; font-style: normal; line-height: 1; }
  .hsx-tab.hsx-on { color: var(--hsx-orange); }
  .hsx-tab.hsx-on span { color: var(--hsx-orange); }
  .hsx-tab.hsx-on.hsx-tab--pill i { background: rgba(241,93,34,0.1); border-radius: 9px; padding: 3px 8px; }
  .hsx-tab--hero { position: relative; }
  .hsx-tab--hero .hsx-bub { position: absolute; top: -20px; width: 44px; height: 44px; border-radius: 50%; background: linear-gradient(135deg, var(--hsx-orange), var(--hsx-terracotta)); border: 3px solid #fff; box-shadow: 0 6px 14px rgba(241,93,34,0.4); display: flex; align-items: center; justify-content: center; font-size: 1.15rem; }
  .hsx-tab--hero span { margin-top: 26px; color: var(--hsx-orange); }

  .hsx-pool { position: absolute; }

  /* desktop calendar command bar + meal board (for the varying laptop screens) */
  .hsx-cmdtitle { font-family: Outfit, sans-serif; font-weight: 800; font-size: 1rem; color: var(--hsx-slate); }
  .hsx-pillbtn { background: linear-gradient(135deg, var(--hsx-orange), var(--hsx-terracotta)); color: #fff; font-family: Outfit, sans-serif; font-weight: 700; font-size: 0.6rem; padding: 5px 11px; border-radius: 10px; box-shadow: 0 3px 8px rgba(241, 93, 34, 0.3); }
  .hsx-nudge { display: flex; align-items: center; gap: 8px; margin-top: 9px; background: rgba(174, 214, 241, 0.18); border: 1px solid rgba(174, 214, 241, 0.5); border-radius: 10px; padding: 8px 12px; font-size: 0.62rem; color: #3a7bad; font-weight: 600; }
  .hsx-mealwrap { display: grid; grid-template-columns: 128px 1fr; gap: 9px; align-items: start; }
  .hsx-rail { background: #fff; border: 1px solid var(--hsx-hair); border-radius: 12px; padding: 9px; }
  .hsx-rail h4 { font-family: Outfit, sans-serif; font-size: 0.66rem; color: var(--hsx-slate); }
  .hsx-recipe { display: flex; align-items: center; gap: 6px; background: var(--hsx-cloud); border-radius: 8px; padding: 5px; margin-top: 5px; }
  .hsx-recipe .hsx-th { width: 22px; height: 22px; border-radius: 6px; background: #fde3c8; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; }
  .hsx-recipe .hsx-rn { font-size: 0.54rem; font-weight: 600; color: var(--hsx-slate); }
  .hsx-alt { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 7px; }
  .hsx-alt b { font-size: 0.46rem; font-weight: 700; padding: 2px 6px; border-radius: 6px; background: var(--hsx-cloud); border: 1px solid var(--hsx-hair); color: #64717d; }
  .hsx-mgrid { background: #fff; border: 1px solid var(--hsx-hair); border-radius: 12px; overflow: hidden; }
  .hsx-mgrid__days { display: grid; grid-template-columns: 42px repeat(4, 1fr); }
  .hsx-mgrid__days b { font-size: 0.5rem; font-weight: 700; color: #90a0ad; text-align: center; padding: 6px 2px; }
  .hsx-mgrid__days b.hsx-tdy { background: linear-gradient(135deg, var(--hsx-orange), var(--hsx-terracotta)); color: #fff; }
  .hsx-mgrid__r { display: grid; grid-template-columns: 42px repeat(4, 1fr); border-top: 1px solid var(--hsx-hair); }
  .hsx-slot-l { font-size: 0.44rem; font-weight: 800; color: #90a0ad; padding: 8px 3px; letter-spacing: 0.03em; }
  .hsx-mgrid__c { border-left: 1px solid var(--hsx-hair); padding: 4px; min-height: 34px; }
  .hsx-meal { background: #fff; border: 1px solid var(--hsx-hair); border-radius: 7px; padding: 3px 4px; font-size: 0.46rem; font-weight: 600; color: var(--hsx-slate); display: flex; align-items: center; gap: 3px; }
  .hsx-meal .hsx-st { width: 5px; height: 5px; border-radius: 50%; margin-left: auto; }
  .hsx-meal--out { background: color-mix(in srgb, var(--hsx-sky) 20%, #fff); }

  @media (prefers-reduced-motion: reduce) {
    .hsx-dots b { transition: none; }
  }
</style>

<script is:inline>
  (() => {
    const NATIVE = { desktop: [760, 496], phone: [290, 594] };
    const DES_W = 970, DES_H = 478;
    // Each combo = [laptop screen, phone, phone]. The laptop varies too.
    const COMBOS = [
      ['overview', 'nook', 'calendar'],
      ['d-calendar', 'travel', 'todo'],
      ['d-meals', 'nook', 'money'],
      ['overview', 'todo', 'travel'],
      ['d-calendar', 'money', 'nook'],
      ['d-meals', 'calendar', 'travel'],
    ];
    const PHONE_ORDER = ['nook', 'calendar', 'travel', 'todo', 'money'];
    function shuffle(a) { for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); const t = a[i]; a[i] = a[j]; a[j] = t; } return a; }

    document.querySelectorAll('.hsx').forEach((root) => {
      const stage = root.querySelector('[data-hsx-stage]');
      const inner = root.querySelector('[data-hsx-inner]');
      const pool = root.querySelector('[data-hsx-pool]');
      const ad = root.querySelector('[data-hsx-ad]');
      const aa = root.querySelector('[data-hsx-aa]');
      const ab = root.querySelector('[data-hsx-ab]');
      const prevBtn = root.querySelector('[data-hsx-prev]');
      const nextBtn = root.querySelector('[data-hsx-next]');
      const dotsEl = root.querySelector('[data-hsx-dots]');
      if (!stage || !inner || !pool || !ad || !aa || !ab || !dotsEl) return;

      const screens = {};
      pool.querySelectorAll('[data-screen]').forEach((el) => { screens[el.getAttribute('data-screen')] = el; });
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      // Shuffle the order each load, but always OPEN at the beginning (index 0).
      const combos = shuffle(COMBOS.slice());
      const phoneOrder = shuffle(PHONE_ORDER.slice());
      let mode = '', comboIdx = 0;
      let carEls = [], carIndex = 0, autoTimer = null, track = null, userInteracted = false;

      function box(node, scale) {
        const kind = node.classList.contains('hsx-device--phone') ? 'phone' : 'desktop';
        const dims = NATIVE[kind];
        const b = document.createElement('div');
        b.className = 'hsx-scalebox';
        b.style.width = dims[0] * scale + 'px';
        b.style.height = dims[1] * scale + 'px';
        node.style.transform = 'scale(' + scale + ')';
        b.appendChild(node);
        return b;
      }
      function toPool() {
        for (const id in screens) {
          const el = screens[id];
          el.style.transform = '';
          if (el.parentElement && el.parentElement.classList.contains('hsx-scalebox')) pool.appendChild(el);
        }
        stage.querySelectorAll('.hsx-scalebox').forEach((b) => b.remove());
      }
      function setDots(active, count, onClick) {
        if (dotsEl.children.length !== count) {
          dotsEl.innerHTML = '';
          for (let i = 0; i < count; i++) { const d = document.createElement('b'); d.addEventListener('click', () => onClick(i)); dotsEl.appendChild(d); }
        }
        Array.prototype.forEach.call(dotsEl.children, (d, i) => d.classList.toggle('hsx-on', i === active));
      }

      // ---------- desktop: stepper through combos ----------
      function paintCombo() {
        const c = combos[comboIdx];
        ad.innerHTML = ''; aa.innerHTML = ''; ab.innerHTML = '';
        toPool();
        ad.appendChild(box(screens[c[0]], 0.7));
        aa.appendChild(box(screens[c[1]], 0.66));
        ab.appendChild(box(screens[c[2]], 0.76));
        setDots(comboIdx, combos.length, (i) => stepCombo(i, true));
      }
      function layoutDesktop() {
        const s = Math.min(1.18, stage.clientWidth / DES_W);
        inner.style.transform = 'translateX(-50%) scale(' + s + ')';
        stage.style.height = DES_H * s + 'px';
      }
      function stepCombo(i, fade) {
        const target = (i + combos.length) % combos.length;
        if (target === comboIdx && dotsEl.children.length) return;
        comboIdx = target;
        if (fade && !reduceMotion) { inner.style.opacity = '0'; window.setTimeout(() => { paintCombo(); inner.style.opacity = '1'; }, 170); }
        else paintCombo();
      }
      function renderDesktop() {
        stage.querySelectorAll('.hsx-carousel').forEach((e) => e.remove());
        inner.style.display = '';
        inner.style.transition = 'opacity 0.18s ease';
        if (prevBtn) prevBtn.style.display = '';
        if (nextBtn) nextBtn.style.display = '';
        paintCombo();
        layoutDesktop();
      }

      // ---------- mobile: swipe carousel ----------
      function nearestIndex() {
        const center = track.scrollLeft + track.clientWidth / 2;
        let best = 0, bd = 1e9;
        carEls.forEach((c, i) => { const cc = c.offsetLeft + c.offsetWidth / 2; const dd = Math.abs(cc - center); if (dd < bd) { bd = dd; best = i; } });
        return best;
      }
      function scrollToCar(i) {
        if (!track || !carEls.length) return;
        i = (i + carEls.length) % carEls.length;
        const cell = carEls[i];
        track.scrollTo({ left: cell.offsetLeft - (track.clientWidth - cell.offsetWidth) / 2, behavior: reduceMotion ? 'auto' : 'smooth' });
      }
      function startAuto() { stopAuto(); if (userInteracted || reduceMotion) return; autoTimer = window.setInterval(() => scrollToCar(carIndex + 1), 3600); }
      function stopAuto() { if (autoTimer) { window.clearInterval(autoTimer); autoTimer = null; } }
      function renderMobile() {
        inner.style.display = 'none';
        if (prevBtn) prevBtn.style.display = 'none';
        if (nextBtn) nextBtn.style.display = 'none';
        stage.querySelectorAll('.hsx-carousel').forEach((e) => e.remove());
        toPool();
        const avail = stage.clientWidth;
        const scale = Math.min(0.85, (avail * 0.72) / NATIVE.phone[0]);
        track = document.createElement('div');
        track.className = 'hsx-carousel';
        carEls = [];
        for (const id of phoneOrder) {
          const cell = document.createElement('div');
          cell.className = 'hsx-carcell';
          cell.appendChild(box(screens[id], scale));
          track.appendChild(cell);
          carEls.push(cell);
        }
        const pad = Math.max(8, (avail - NATIVE.phone[0] * scale) / 2);
        track.style.paddingLeft = pad + 'px';
        track.style.paddingRight = pad + 'px';
        stage.appendChild(track);
        stage.style.height = NATIVE.phone[1] * scale + 12 + 'px';

        track.addEventListener('scroll', () => { const b = nearestIndex(); carIndex = b; setDots(b, carEls.length, (i) => scrollToCar(i)); }, { passive: true });

        // Mouse click-drag: follow the cursor 1:1 (snap off), smooth-snap on release.
        let down = false, startX = 0, startScroll = 0;
        track.addEventListener('pointerdown', (e) => {
          userInteracted = true; stopAuto();
          if (e.pointerType !== 'mouse') return;
          down = true; startX = e.clientX; startScroll = track.scrollLeft;
          track.style.scrollSnapType = 'none';
          try { track.setPointerCapture(e.pointerId); } catch (_) {}
          track.style.cursor = 'grabbing';
        });
        track.addEventListener('pointermove', (e) => { if (down) track.scrollLeft = startScroll - (e.clientX - startX); });
        const endDrag = () => {
          if (!down) return;
          down = false; track.style.cursor = '';
          const b = nearestIndex();
          scrollToCar(b); carIndex = b; setDots(b, carEls.length, (i) => scrollToCar(i));
          window.setTimeout(() => { track.style.scrollSnapType = ''; }, reduceMotion ? 0 : 450);
        };
        track.addEventListener('pointerup', endDrag);
        track.addEventListener('pointercancel', endDrag);

        // open at the beginning (index 0); order is already shuffled
        setDots(0, carEls.length, (i) => scrollToCar(i));
        track.scrollLeft = 0;
        carIndex = 0;
        startAuto();
      }

      function render() {
        stopAuto();
        if (window.innerWidth < 820) { mode = 'mobile'; renderMobile(); }
        else { mode = 'desktop'; renderDesktop(); }
      }

      if (prevBtn) prevBtn.addEventListener('click', () => stepCombo(comboIdx - 1, true));
      if (nextBtn) nextBtn.addEventListener('click', () => stepCombo(comboIdx + 1, true));

      let dragX = null;
      stage.addEventListener('pointerdown', (e) => { if (mode === 'desktop') dragX = e.clientX; });
      window.addEventListener('pointerup', (e) => {
        if (mode === 'desktop' && dragX !== null) { const dx = e.clientX - dragX; dragX = null; if (Math.abs(dx) > 50) stepCombo(comboIdx + (dx < 0 ? 1 : -1), true); }
      });

      let raf = 0;
      window.addEventListener('resize', () => { window.cancelAnimationFrame(raf); raf = window.requestAnimationFrame(render); });
      render();
    });
  })();
</script>
