  .hsx-todo { display: flex; align-items: flex-start; gap: 8px; background: #fff; border: 1px solid var(--hsx-hair); border-radius: 11px; padding: 8px 10px; }
  .hsx-box { width: 17px; height: 17px; border-radius: 5px; border: 2.5px solid var(--hsx-orange); flex: none; margin-top: 1px; }
  .hsx-box.hsx-red { border-color: #e74c3c; }
  .hsx-box.hsx-sky { border-color: var(--hsx-sky); }
  .hsx-tt { font-size: 0.64rem; font-weight: 600; color: var(--hsx-slate); }
  .hsx-meta { display: flex; gap: 4px; margin-top: 3px; flex-wrap: wrap; }
  .hsx-ttag { font-size: 0.48rem; font-weight: 700; padding: 2px 6px; border-radius: 999px; }
  .hsx-ttag--over { background: var(--hsx-orange); color: #fff; }
  .hsx-ttag--due { background: rgba(241,93,34,0.12); color: var(--hsx-orange); }
  .hsx-ttag--date { color: var(--hsx-orange); }

  /* nook */
  .hsx-greet { font-family: Outfit, sans-serif; font-weight: 800; font-size: 1rem; color: var(--hsx-slate); }
  .hsx-greet span { color: var(--hsx-orange); }
  .hsx-toast { background: linear-gradient(135deg, var(--hsx-orange), var(--hsx-terracotta) 70%, #d4701e); border-radius: 14px; padding: 11px 12px; color: #fff; box-shadow: 0 8px 20px rgba(241,93,34,0.28); }
  .hsx-toast__h { display: flex; align-items: center; gap: 8px; }
  .hsx-toast__ic { width: 30px; height: 30px; border-radius: 9px; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; font-size: 0.95rem; }
  .hsx-toast__t { font-family: Outfit, sans-serif; font-weight: 700; font-size: 0.72rem; }
  .hsx-toast__s { font-size: 0.52rem; opacity: 0.85; font-style: italic; }
  .hsx-toast__row { display: flex; align-items: center; gap: 6px; background: rgba(255,255,255,0.15); border-radius: 8px; padding: 5px 7px; margin-top: 6px; font-size: 0.56rem; }
  .hsx-beans { display: flex; gap: 10px; }
  .hsx-bean { display: flex; flex-direction: column; align-items: center; gap: 3px; }
  .hsx-bean .hsx-a { width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-family: Outfit, sans-serif; font-weight: 800; font-size: 0.8rem; border: 2px solid #fff; box-shadow: 0 2px 6px rgba(44,62,80,0.15); position: relative; }
  .hsx-bean .hsx-a::after { content: ''; position: absolute; right: 0; bottom: 0; width: 8px; height: 8px; border-radius: 50%; background: var(--hsx-green); border: 1.5px solid #fff; }
  .hsx-bean .hsx-nm { font-size: 0.5rem; font-weight: 700; color: var(--hsx-slate); }
  .hsx-bean .hsx-rl { font-size: 0.44rem; color: #97a3ae; }
  .hsx-bean .hsx-add { border: 1.5px dashed #c3ccd4; color: #97a3ae; box-shadow: none; }
  .hsx-bean .hsx-add::after { display: none; }

  /* phone chrome */
  .hsx-ph { background: var(--hsx-cloud); border-radius: 26px; overflow: hidden; height: 574px; display: flex; flex-direction: column; position: relative; }
  .hsx-ph__status { height: 26px; display: flex; align-items: center; justify-content: space-between; padding: 0 18px 0 20px; font-family: Outfit, sans-serif; font-weight: 700; font-size: 0.66rem; color: var(--hsx-slate); flex: none; }
  .hsx-sigs { display: flex; align-items: center; gap: 3px; }
  .hsx-sigs b { width: 15px; height: 8px; border: 1px solid var(--hsx-slate); border-radius: 2px; display: inline-block; position: relative; }
  .hsx-sigs b::after { content: ''; position: absolute; inset: 1px; right: 4px; background: var(--hsx-slate); border-radius: 1px; }
  .hsx-ph__hd { height: 42px; display: flex; align-items: center; justify-content: space-between; padding: 0 13px; flex: none; }
  .hsx-burger { display: flex; flex-direction: column; gap: 3px; }
  .hsx-burger i { width: 15px; height: 2px; background: var(--hsx-slate); border-radius: 2px; }
  .hsx-ph__hd .hsx-t { font-family: Outfit, sans-serif; font-weight: 700; font-size: 0.8rem; color: var(--hsx-slate); }
  .hsx-ph__hd .hsx-t span { color: var(--hsx-orange); }
  .hsx-ph__hd .hsx-r { display: flex; align-items: center; gap: 8px; font-size: 0.82rem; }
  .hsx-ph__hd .hsx-r .hsx-av { width: 22px; height: 22px; }
  .hsx-ph__body { flex: 1; overflow: hidden; padding: 4px 11px 8px; display: flex; flex-direction: column; gap: 8px; }
  .hsx-ph__body > * { flex: 0 0 auto; }

  .hsx-tabs { flex: none; height: 54px; background: #fff; border-top: 1px solid var(--hsx-hair); display: flex; align-items: flex-start; justify-content: space-around; padding-top: 7px; position: relative; }
  .hsx-tab { display: flex; flex-direction: column; align-items: center; gap: 2px; font-size: 0.5rem; font-weight: 600; color: rgba(44,62,80,0.4); width: 46px; }
  .hsx-tab i { font-size: 1.05rem; font-style: normal; line-height: 1; }
  .hsx-tab.hsx-on { color: var(--hsx-orange); }
  .hsx-tab.hsx-on span { color: var(--hsx-orange); }
  .hsx-tab.hsx-on.hsx-tab--pill i { background: rgba(241,93,34,0.1); border-radius: 9px; padding: 3px 8px; }
  .hsx-tab--hero { position: relative; }
  .hsx-tab--hero .hsx-bub { position: absolute; top: -20px; width: 44px; height: 44px; border-radius: 50%; background: linear-gradient(135deg, var(--hsx-orange), var(--hsx-terracotta)); border: 3px solid #fff; box-shadow: 0 6px 14px rgba(241,93,34,0.4); display: flex; align-items: center; justify-content: center; font-size: 1.15rem; }
  .hsx-tab--hero span { margin-top: 26px; color: var(--hsx-orange); }

  /* meal board (unused on homepage cluster but kept for parity) */
  .hsx-pool { position: absolute; }

  @media (prefers-reduced-motion: reduce) {
    .hsx-dots b { transition: none; }
  }
</style>

<script is:inline>
  (() => {
    const NATIVE = { desktop: [760, 496], phone: [290, 594] };

    document.querySelectorAll('.hsx').forEach((root) => {
      const stage = root.querySelector('[data-hsx-stage]');
      const inner = root.querySelector('[data-hsx-inner]');
      const pool = root.querySelector('[data-hsx-pool]');
      const ad = root.querySelector('[data-hsx-ad]');
      const aa = root.querySelector('[data-hsx-aa]');
      const ab = root.querySelector('[data-hsx-ab]');
      if (!stage || !inner || !pool || !ad || !aa || !ab) return;

      const DES_W = 720, DES_H = 470;
      const screens = {};
      pool.querySelectorAll('[data-screen]').forEach((el) => { screens[el.getAttribute('data-screen')] = el; });
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let carEls = [], carIndex = 0, autoTimer = null, track = null, userInteracted = false;

      function box(node, scale) {
        const kind = node.classList.contains('hsx-device--phone') ? 'phone' : 'desktop';
        const dims = NATIVE[kind];
        const b = document.createElement('div');
        b.className = 'hsx-scalebox';
        b.style.width = dims[0] * scale + 'px';
        b.style.height = dims[1] * scale + 'px';
        node.style.transform = 'scale(' + scale + ')';
        b.appendChild(node);
        return b;
      }
      function toPool() {
        for (const id in screens) {
          const el = screens[id];
          el.style.transform = '';
          if (el.parentElement && el.parentElement.classList.contains('hsx-scalebox')) pool.appendChild(el);
        }
        stage.querySelectorAll('.hsx-scalebox').forEach((b) => b.remove());
      }
      function scrollToCar(i) {
        if (!track || !carEls.length) return;
        i = (i + carEls.length) % carEls.length;
        const cell = carEls[i];
        track.scrollTo({ left: cell.offsetLeft - (track.clientWidth - cell.offsetWidth) / 2, behavior: reduceMotion ? 'auto' : 'smooth' });
      }
      function setDot(i) {
        carIndex = i;
        const dots = stage.querySelector('.hsx-dots');
        if (dots) Array.prototype.forEach.call(dots.children, (d, j) => d.classList.toggle('hsx-on', j === i));
      }
      function startAuto() { stopAuto(); if (userInteracted || reduceMotion) return; autoTimer = window.setInterval(() => scrollToCar(carIndex + 1), 3600); }
      function stopAuto() { if (autoTimer) { window.clearInterval(autoTimer); autoTimer = null; } }

      function renderDesktop() {
        stage.querySelectorAll('.hsx-carousel, .hsx-dots').forEach((e) => e.remove());
        inner.style.display = '';
        ad.innerHTML = ''; aa.innerHTML = ''; ab.innerHTML = '';
        toPool();
        ad.appendChild(box(screens.overview, 0.66));
        aa.appendChild(box(screens.nook, 0.74));
        ab.appendChild(box(screens.calendar, 0.82));
        const s = Math.min(1, stage.clientWidth / DES_W);
        inner.style.transform = 'translateX(-50%) scale(' + s + ')';
        stage.style.height = DES_H * s + 'px';
      }

      function renderMobile() {
        inner.style.display = 'none';
        stage.querySelectorAll('.hsx-carousel, .hsx-dots').forEach((e) => e.remove());
        toPool();
        const order = ['nook', 'calendar', 'travel', 'todo', 'money'];
        const avail = stage.clientWidth;
        const scale = Math.min(0.85, (avail * 0.72) / NATIVE.phone[0]);
        track = document.createElement('div');
        track.className = 'hsx-carousel';
        carEls = [];
        for (const id of order) {
          const cell = document.createElement('div');
          cell.className = 'hsx-carcell';
          cell.appendChild(box(screens[id], scale));
          track.appendChild(cell);
          carEls.push(cell);
        }
        const pad = Math.max(8, (avail - NATIVE.phone[0] * scale) / 2);
        track.style.paddingLeft = pad + 'px';
        track.style.paddingRight = pad + 'px';
        stage.appendChild(track);
        const dots = document.createElement('div');
        dots.className = 'hsx-dots';
        order.forEach((_, i) => { const d = document.createElement('b'); d.addEventListener('click', () => scrollToCar(i)); dots.appendChild(d); });
        stage.appendChild(dots);
        stage.style.height = NATIVE.phone[1] * scale + 34 + 'px';
        track.addEventListener('scroll', () => {
          const center = track.scrollLeft + track.clientWidth / 2;
          let best = 0, bd = 1e9;
          carEls.forEach((c, i) => { const cc = c.offsetLeft + c.offsetWidth / 2; const dd = Math.abs(cc - center); if (dd < bd) { bd = dd; best = i; } });
          setDot(best);
        }, { passive: true });
        track.addEventListener('pointerdown', () => { userInteracted = true; stopAuto(); });
        carIndex = 0; setDot(0); startAuto();
      }

      function render() {
        stopAuto();
        if (window.innerWidth < 820) renderMobile();
        else renderDesktop();
      }

      let raf = 0;
      window.addEventListener('resize', () => { window.cancelAnimationFrame(raf); raf = window.requestAnimationFrame(render); });
      render();
    });
  })();
</script>
