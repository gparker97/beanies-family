        <path id="vine-center" d="M540 0 C 540 240 380 360 440 620 C 500 840 760 900 660 1180 C 588 1400 340 1500 440 1780 C 505 1990 560 2120 540 2260" stroke="rgba(62,142,82,0.10)" stroke-width="22"></path>
        <path class="grow" id="vine-trunk" d="M540 0 C 540 240 380 360 440 620 C 500 840 760 900 660 1180 C 588 1400 340 1500 440 1780 C 505 1990 560 2120 540 2260" stroke="url(#trunkGrad)" stroke-width="26"></path>
        <path class="grow" id="vine-core" d="M540 0 C 540 240 380 360 440 620 C 500 840 760 900 660 1180 C 588 1400 340 1500 440 1780 C 505 1990 560 2120 540 2260" stroke="url(#coreGrad)" stroke-width="8"></path>
        <path class="grow braid" id="braidA" stroke="url(#strandA)" stroke-width="5.5"></path>
        <path class="grow braid" id="braidB" stroke="url(#strandB)" stroke-width="5.5"></path>
