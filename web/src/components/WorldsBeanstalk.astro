          dockOffset();
        }
      } else if (!launchedState) {
        // First frame past the launch point: pin to the TOP (gVisual=0) and hop the
        // beanie UP from its docked spot onto the stalk top. The descent only begins
        // once the hop lands (hopping cleared on animationend), so no matter how fast
        // the user scrolled, it visibly starts at the top and travels down.
        launchedState = true;
        gVisual = 0;
        if (docked) {
          docked = false;
          climber!.classList.remove('docked');
          hopping = true;
          climber!.classList.remove('launching');
          void (climber as HTMLElement).offsetWidth; // restart the keyframe if re-launching
          climber!.classList.add('launching');
        }
      }
      if (hint) hint.style.opacity = launched ? '0' : '0.95';
    }

    // Draw everything at the EASED position gVisual (never straight from scroll).
    function render() {
      var g = gVisual;
      grows.forEach(function (path: any) { path.style.strokeDashoffset = path._len * (1 - g); });

      if (launchedState) {
        var pt = frontierPoint(g);   // the braids' leading tip — the seed leads the stalk down
        (climber as HTMLElement).style.left = (pt.x / VBW * 100) + '%';
        (climber as HTMLElement).style.top = (pt.y / VBH * 100) + '%';
        (climber as HTMLElement).style.opacity = (g < 0.995) ? '1' : '0';
      }

      // leaves unfurl ONLY as the seed passes their point on the vine
      leaves.forEach(function (leaf: HTMLElement) {
        var f = parseFloat(leaf.getAttribute('data-frac') || '0') || 0;
        leaf.classList.toggle('sprout', g >= f);
      });
      // cards appear as the seed reaches them and STAY visible going down;
      // they hide again only when scrolling back UP past their entry point
      scenes.forEach(function (s: HTMLElement) {
        var c = parseFloat(s.getAttribute('data-center') || '0') || 0;
        s.classList.toggle('in', g >= (c - 0.05));
      });
      if (g > 0.95 && !celebrated) { celebrated = true; root!.classList.add('celebrate'); }
      if (g < 0.86 && celebrated) { celebrated = false; root!.classList.remove('celebrate'); }
    }

    function frame() {
      rafPending = false;
      readScroll();
      // While the hop is in flight, hold at the top so the seed always LANDS at the
      // top before it starts descending.
      var target = hopping ? 0 : gTarget;
      var diff = target - gVisual;
      if (Math.abs(diff) > 0.0008) {
        var step = diff * EASE;                         // ease toward target…
        if (step > MAXSTEP) step = MAXSTEP;             // …but cap the speed so a far
        else if (step < -MAXSTEP) step = -MAXSTEP;      // scroll jump can't lurch the seed
        gVisual += step;
        render();
        schedule();
      } else {
        gVisual = target;
        render();
        if (hopping || Math.abs(gTarget - gVisual) > 0.0008) schedule();
      }
    }
    function schedule() { if (!rafPending) { rafPending = true; requestAnimationFrame(frame); } }
    function onScroll() { schedule(); }
    function onResize() {
      buildBraid(); measure();
      grows.forEach(function (p: any) { p.style.strokeDasharray = p._len; });
      positionLeaves(); if (docked) dockOffset(); schedule();
    }

    try {
      buildBraid();
      measure();
      positionLeaves();
      if (prefersReduced) { renderStatic(); return; }
      grows.forEach(function (p: any) { p.style.strokeDasharray = p._len; p.style.strokeDashoffset = p._len; });
      dockOffset();
      // The launch hop finished → let the eased descent from the top begin.
      climber!.addEventListener('animationend', function (e) {
        if ((e as AnimationEvent).animationName === 'climberHop') {
          hopping = false;
          climber!.classList.remove('launching');
          schedule();
        }
      });
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onResize);
      schedule();
    } catch (err) {
      console.warn(
        '[worlds] animation setup failed — falling back to the static beanstalk. ' +
        'Fix guidance: verify the SVG path #vine-center is present and getTotalLength/getPointAtLength are available.',
        err,
      );
      renderStatic();
    }
  })();
</script>
