            <stop offset="0" stop-color="#4e9e63" /><stop offset="0.55" stop-color="#2f7a44" /><stop offset="1" stop-color="#405525" />
          </linearGradient>
          <linearGradient id="strandC" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="2260">
            <stop offset="0" stop-color="#63b478" /><stop offset="0.55" stop-color="#367e49" /><stop offset="1" stop-color="#4a5f28" />
          </linearGradient>
          <linearGradient id="trunkGrad" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="2260">
