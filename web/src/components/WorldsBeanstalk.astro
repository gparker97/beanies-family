            <stop offset="0.82" stop-color="#4e7a30" /><stop offset="1" stop-color="#4a5f28" />
          </linearGradient>
          <linearGradient id="strandA" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="2260">
