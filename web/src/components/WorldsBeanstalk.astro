---
/**
 * WorldsBeanstalk — the homepage "three worlds" scroll-grown beanstalk section.
 *
 * FAITHFUL PORT of the approved, copy-final mockup:
 *   docs/mockups/homepage-worlds-beanstalk-blend-2026-07-16.html (commit c037bdf5)
 * Plan: docs/plans/2026-07-16-homepage-worlds-beanstalk-section.md
 *
 * ⚠️ LOAD-BEARING CONSTANTS. The SVG path, braid params (step/wl/phases/amp),
 * the growth remap (P0 / g), the seed dock/launch, leaf data-frac values, and the
 * animation timings below are interdependent and were tuned by eye in the mockup.
 * Do NOT "clean them up", rename them, or refactor the generators in place. To change
 * the design: edit the mockup first, re-verify it, then re-port here.
 *
 * The only deviations from the mockup (all per the plan): font-family stacks mapped to
 * the site's loaded fonts (Caveat is a CIG accent font, imported by this component —
 * see the import below), the family image uses the /brand/ public path, the mockup's
 * :root brand tokens are inherited from .landing-page (only --vine-green(-light) are
 * declared here), the grass is pre-rendered deterministically at build time (Astro can't
 * scope styles onto JS-created nodes), and decorative emoji get aria-hidden.
 */

// Caveat — the CIG handwritten accent face, used by `.root-note` below and by
// nothing else on the site. Imported HERE rather than in BaseLayout so the other
// 90 pages don't carry its @font-face rules; colocating it with its only consumer
// also means it cannot be orphaned if this section is ever removed. Mirrors the
// existing per-page Fraunces pattern.
import '@fontsource-variable/caveat';

// --- Deterministic grass generator (build-time; reproduces the mockup's buildGrass()
//     distribution with a fixed seed so builds are reproducible). Call order matches
//     the mockup exactly: curl, x, y, h, rot, delay, sw, sd. ---
const makeSeededRand = (seed: number) => {
  let s = seed >>> 0;
  return () => {
    s = (s * 1664525 + 1013904223) >>> 0;
    return s / 4294967296;
  };
};
const seeded = makeSeededRand(20260716);
const rnd = (a: number, b: number) => a + seeded() * (b - a);

interface BladeOpts {
  spread: number; depth: number; hMin: number; hMax: number; w: number;
  rot: number; curlRot: number; span: number; c1: string; c2: string;
}
function makeBlades(n: number, o: BladeOpts) {
  const blades: { curl: boolean; style: string }[] = [];
  for (let i = 0; i < n; i++) {
    const curl = seeded() < 0.42;
    const x = rnd(-o.spread, o.spread);
    const y = rnd(0, o.depth);
    const depthF = 1 - y / (o.depth + 8);
    const h = rnd(o.hMin, o.hMax) * (0.7 + depthF * 0.5);
    const rot = rnd(-1, 1) * (curl ? o.curlRot : o.rot);
    const delay = rnd(0, o.span);
    const sw = rnd(2.4, 4);
    const sd = (rot > 0 ? -1 : 1) * Number(rnd(4, 8).toFixed(0));
    blades.push({
      curl,
      style:
        `--x:${x.toFixed(0)}px;--y:${y.toFixed(0)}px;--h:${h.toFixed(0)}px;--w:${o.w}px;` +
        `--rot:${rot.toFixed(0)}deg;--d:${delay.toFixed(2)}s;--sw:${sw.toFixed(1)}s;` +
        `--sd:${sd.toFixed(0)}deg;--c1:${o.c1};--c2:${o.c2};`,
    });
  }
  return blades;
}

// back row: behind the family, wider + a touch lighter for depth
const backBlades = makeBlades(20, { spread: 150, depth: 44, hMin: 26, hMax: 54, w: 10, rot: 16, curlRot: 34, span: 2.6, c1: '#3a8a4f', c2: '#79c98d' });
// front row: in front of the family's feet, taller + darker
const frontBlades = makeBlades(24, { spread: 158, depth: 30, hMin: 34, hMax: 72, w: 12, rot: 18, curlRot: 40, span: 3.0, c1: '#245f34', c2: '#4fa066' });
// a few little bean sprouts popping among the grass (fixed positions in the mockup)
const gbeans = ([['🌱', -118, 8, 1.5], ['🫘', -34, 2, 1.9], ['🌱', 80, 10, 2.3], ['🫘', 128, 4, 1.2]] as [string, number, number, number][])
  .map((g, i) => ({ emoji: g[0], style: `--x:${g[1]}px;--y:${g[2]}px;--rot:${i % 2 ? 8 : -8}deg;--d:${g[3]}s;` }));
---

<section id="features" class="worlds" aria-label="what's inside beanies">
