    <span class="vine-leaf" data-frac="0.09" data-side="l" style="--r:-6deg"><span class="t">to-dos</span></span>
    <span class="vine-leaf" data-frac="0.12" data-side="r" style="--r:7deg"><span class="t">family lists</span></span>
    <span class="vine-leaf" data-frac="0.30" data-side="l" style="--r:7deg"><span class="t">bank accounts</span></span>
    <span class="vine-leaf" data-frac="0.335" data-side="r" style="--r:-6deg"><span class="t">family budget</span></span>
    <span class="vine-leaf" data-frac="0.37" data-side="l" style="--r:6deg"><span class="t">savings goals</span></span>
    <span class="vine-leaf" data-frac="0.40" data-side="r" style="--r:-7deg"><span class="t">net worth</span></span>
    <span class="vine-leaf" data-frac="0.59" data-side="r" style="--r:-6deg"><span class="t">family scrapbook</span></span>
    <span class="vine-leaf" data-frac="0.63" data-side="l" style="--r:7deg"><span class="t">secret recipes</span></span>
    <span class="vine-leaf" data-frac="0.67" data-side="r" style="--r:-7deg"><span class="t">beanie milestones</span></span>
    <span class="vine-leaf" data-frac="0.70" data-side="l" style="--r:6deg"><span class="t">care &amp; safety</span></span>

    <div class="scene" data-i="0" data-center="0.20">
      <div class="card">
        <span class="card__vine card__vine--top"></span>
        <span class="card__vine card__vine--bottom"></span>
        <span class="card__vine card__vine--left"></span>
        <span class="card__vine card__vine--right"></span>
        <div class="card__head">
          <span class="card__glyph" style="background: rgba(174,214,241,0.42)">📅</span>
          <div><p class="card__kicker">world 1 - the treehouse</p><h3 class="card__name">your beanie plans</h3></div>
        </div>
        <p class="card__lead">who's picking up joey tomorrow? now you know.</p>
        <div class="mini">
          <div class="drow"><span class="who">🎹 piano lesson · thu</span><span class="tag" style="background:rgba(174,214,241,0.5);color:var(--deep-slate)">5:30 pm</span></div>
          <div class="drow"><span class="who">🚗 school drop-off</span><span class="tag" style="background:rgba(241,93,34,0.12);color:var(--heritage-orange)">greg's turn</span></div>
          <div class="drow"><span class="who">✈️ tokyo family trip</span><span class="tag" style="background:rgba(39,174,96,0.12);color:var(--soft-green)">12 sleeps</span></div>
        </div>
      </div>
    </div>

    <div class="scene" data-i="1" data-center="0.48">
      <div class="card">
        <span class="card__vine card__vine--top"></span>
        <span class="card__vine card__vine--bottom"></span>
        <span class="card__vine card__vine--left"></span>
        <span class="card__vine card__vine--right"></span>
        <div class="card__head">
          <span class="card__glyph" style="background: rgba(230,126,34,0.14)">🐷</span>
          <div><p class="card__kicker">world 2 - the piggy bank</p><h3 class="card__name">your money</h3></div>
        </div>
        <p class="card__lead">manage your money, throw away the spreadsheets</p>
        <div class="mini">
          <div class="money-row">
            <div class="ring"><span>62%</span></div>
            <div><div class="money-big">$48,210</div><div class="money-lbl">net worth · emergency fund 62%</div></div>
          </div>
