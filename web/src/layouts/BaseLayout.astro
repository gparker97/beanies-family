---
import { SEO } from 'astro-seo';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { ORGANIZATION, WEBSITE } from '@beanies/brand/schema';
import { SITE_URL } from '@beanies/brand/nav';
import '../styles/global.css';
// Self-hosted variable fonts (shipped with the build, no third-party request).
// Variable fonts are a single file per family, covering all weights 300-800.
import '@fontsource-variable/outfit';
import '@fontsource-variable/inter';
// Do NOT add <link rel="preload"> for these. Measured 2026-07-22: preloading
// Outfit alone takes homepage CLS to a clean 0, but costs a hard +377ms of LCP
// (2714ms -> 3088ms), busting the 3000ms budget. fetchpriority="low" does not
// help. The hero mascot has only ~290ms of LCP headroom, so any extra
// critical-path request breaks it. The fix that gets CLS to 0 without a network
// request is a size-adjust metric-matched fallback face — see
// docs/plans/2026-07-22-lighthouse-gate-honesty-and-homepage-cls.md.
// NOTE: Caveat (the CIG handwritten accent face) is deliberately NOT imported here.
// Exactly one component uses it, so it is imported by that component instead —
// see WorldsBeanstalk.astro. Same per-page pattern as Fraunces, which the blog,
// guides and help pages import themselves. Outfit and Inter stay global because
// every page uses them (global.css sets them as the heading/body faces).

interface Props {
  title: string;
  description: string;
  /** Canonical path starting with "/" (the site URL is prepended). Defaults to current pathname. */
  canonicalPath?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Article-specific OG fields (used on blog posts). */
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  /** Tags rendered as article:tag OG meta. */
  tags?: string[];
  /** Additional per-page JSON-LD nodes merged into the @graph. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Mark the page as noindex (e.g. staging preview, utility pages). */
  noindex?: boolean;
  /**
   * Path to the page's LCP (Largest Contentful Paint) image. When set,
   * a `<link rel="preload" as="image">` is rendered in `<head>` so the
   * browser starts the request before discovering the `<img>` tag in the
   * body — measurably improves LCP on image-heavy hero pages and resolves
   * Lighthouse's `lcp-discovery-insight` audit.
   *
   * Pass the served path (e.g. `/brand/foo.webp`), not a `src/` import.
   */
  lcpImage?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  ogImage = `${SITE_URL}/brand/beanies-logo.png`,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  author,
  tags,
  jsonLd,
  noindex = false,
  lcpImage,
} = Astro.props;

const canonical = new URL(canonicalPath, SITE_URL).toString();
const globalLd = [ORGANIZATION, WEBSITE];
const extraLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Favicon set matches the Vue app 1:1 so the tab icon is identical
         across prod (apex) and this site during Phase B / after cutover. -->
    <link rel="icon" type="image/png" href="/brand/beanies_small_bean_favicon_32x32.png" />
    <link rel="apple-touch-icon" href="/brand/beanies_father_son_icon_192x192.png" />
    {lcpImage && <link rel="preload" as="image" href={lcpImage} fetchpriority="high" />}
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      noindex={noindex}
      openGraph={{
        basic: { title, type: ogType, image: ogImage, url: canonical },
        optional: { description, siteName: 'beanies.family', locale: 'en_US' },
        article:
          ogType === 'article'
            ? {
                publishedTime,
                modifiedTime,
                authors: author ? [author] : undefined,
                tags,
              }
            : undefined,
      }}
      twitter={{
        card: 'summary_large_image',
        title,
        description,
        image: ogImage,
      }}
    />
    <JsonLd data={[...globalLd, ...extraLd]} />

    <!-- Plausible analytics (cookie-free, privacy-first) -->
    <script is:inline async src="https://plausible.io/js/pa-3pxexgz2YF03NyMDucQKN.js"></script>
    <script is:inline>
      ((window.plausible =
        window.plausible ||
        function () {
          (plausible.q = plausible.q || []).push(arguments);
        }),
        (plausible.init =
          plausible.init ||
          function (i) {
            plausible.o = i || {};
          }));
      plausible.init();
    </script>

    <!-- CTA click tracking.
         ONE delegated listener rather than a handler per button: CTAs live across the
         homepage, the download page, guides, help and the beanstalk footer, and a per-call-site
         handler is how three of them end up untracked after the next redesign. Any element
         carrying data-cta fires; adding a CTA anywhere is a one-attribute change.

         Distinct goal names (not one "CTA Click" with a prop) because Plausible funnels and
         the goal list key on the event NAME — a single event with properties cannot be a
         funnel step. `location` rides along as a property so the same CTA can be compared
         across placements.

         Uses closest(), so a click on the <img> inside a store badge still resolves to the
         anchor that carries the attribute. -->
    <script is:inline>
      document.addEventListener(
        'click',
        function (e) {
          var el = e.target && e.target.closest && e.target.closest('[data-cta]');
          if (!el) return;
          var name = el.getAttribute('data-cta');
          if (!name) return;
          window.plausible(name, {
            props: { location: el.getAttribute('data-cta-loc') || 'unknown' },
          });
        },
        // Capture phase: these anchors navigate away, and a bubble-phase listener can lose
        // the race with the unload on a slow connection.
        true
      );
    </script>

    <!-- PWA-install escape hatch (#167): users who installed the Vue PWA
         pre-cutover have start_url: '/' baked into the install, so every
         launch lands here. Detect standalone display-mode and redirect
         them to app.beanies.family preserving the path. Regular browser
         visits never match (display-mode is 'browser') and see the
         marketing site normally. `is:inline` + placing this at the top of
         <body> ensures it runs before any other script or content paints.

         Loop guard: if `from-stale-pwa=1` is already present, we've already
         bounced once and the app sent us back (e.g. the app's /help, /privacy,
         /terms external-redirects point here, and an in-place standalone nav
         would otherwise ping-pong forever). Render the marketing page instead
         of redirecting again. The genuine stale-PWA launch hits the apex
         without the param, so it still bounces exactly once.

         Marketing-only guard: sections that live ONLY on this site (help, blog,
         guides, about, privacy, terms) have no counterpart on app.beanies.family,
         so bouncing them yields the app's 404 page. This is what broke the in-app
         AI-consent link to /help/security/... when tapped from the iOS PWA. Never
         bounce these — a genuine stale-PWA launch always starts at the apex '/',
         which is not in the list and still bounces exactly once. -->
    <script is:inline>
      (function () {
        try {
          var isStandalone =
            window.matchMedia &&
            window.matchMedia('(display-mode: standalone)').matches;
          var isIOS = window.navigator.standalone === true;
          var alreadyBounced =
            new URLSearchParams(window.location.search).get('from-stale-pwa') === '1';
          var path = window.location.pathname;
          var MARKETING_ONLY = ['/help', '/blog', '/guides', '/about', '/privacy', '/terms'];
          var isMarketingOnly = MARKETING_ONLY.some(function (p) {
            return path === p || path.indexOf(p + '/') === 0;
          });
          if ((isStandalone || isIOS) && !alreadyBounced && !isMarketingOnly) {
            var url = new URL(
              'https://app.beanies.family' +
                window.location.pathname +
                window.location.search +
                window.location.hash
            );
            url.searchParams.set('from-stale-pwa', '1');
            window.location.replace(url.toString());
          }
        } catch (e) {
          // No-op — matchMedia unsupported, fall through to marketing page.
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-[#f8f9fa] text-secondary-500">
    <Nav />
    <slot />
    <Footer />
  </body>
</html>
