---
// Stable redirect to the beanies.family Discord. Every in-app "join Discord"
// CTA points at /discord (via DISCORD_URL) so the actual invite can be rotated
// here (a small web deploy) without an app/PWA release, and a dead invite can
// never ship inside a bundle.
//
// To change the invite: edit INVITE_URL below and deploy the web site.
import ForwardPage from '../components/ForwardPage.astro';

const INVITE_URL = 'https://discord.gg/NE4grWzjxV';
---

<ForwardPage
  to={INVITE_URL}
  title="Joining the beanies.family Discord…"
  message="taking you to our discord… 🫘"
  linkText="tap here to join us on discord"
/>
