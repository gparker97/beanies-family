---
// Stable short link that sends the visitor to the right app store for their
// device. One URL (beanies.family/download) works on any phone and is safe to
// print on a QR code: iOS visitors land on the App Store, Android visitors on
// Google Play, and anyone on desktop sees both choices.
//
// Redirects are done in JS (no meta-refresh) because desktop should NOT redirect
// — it should show both options. The per-store destinations live in /ios and
// /android; this page forwards to those (carrying `location.search`) so there is a single
// source of truth AND a single place that records the `store_tap` event and builds the
// tagged store URL.
//
// Deliberately a minimal standalone page (NOT BaseLayout): no nav/footer.
import { SITE_URL } from '@beanies/brand/nav';
import AppLinks from '../components/AppLinks.astro';

const DESCRIPTION =
  'one app to manage your family\u2019s money, activities, and all the little beans. private, encrypted, no ads.';
const OG_IMAGE = new URL('/brand/og-default.png', SITE_URL).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Get the beanies.family app</title>
    <meta name="description" content={DESCRIPTION} />
    <!-- This page is standalone (no BaseLayout), so its social card is
         declared by hand. The link is printed on QR codes and shared
         directly, so without these it previews as a bare URL. -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Get the beanies.family app" />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:url" content={new URL('/download', SITE_URL).toString()} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="the beanies family, hugging" />
    <meta property="og:site_name" content="beanies.family" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Get the beanies.family app" />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <meta name="twitter:image:alt" content="the beanies family, hugging" />
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 20px;
        background: #f8f9fa;
        color: #2c3e50;
        font-family: Outfit, system-ui, sans-serif;
        text-align: center;
        padding: 24px;
      }
      h1 {
        font-size: 1.4rem;
        margin: 0;
      }
      h1 span {
        color: #f15d22;
      }
      .choices {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: center;
      }
      .choices a {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #2c3e50;
        color: #fff;
        text-decoration: none;
        font-weight: 600;
        padding: 12px 20px;
        border-radius: 14px;
      }
      .choices a:hover {
        background: #f15d22;
      }
      .muted {
        color: #6b7a89;
        font-size: 0.9rem;
      }
    </style>
    <!-- Plausible + the CTA listener (in <AppLinks />). This page is deliberately standalone
         (no BaseLayout), which meant it carried NO analytics at all — so the two store buttons
         that are the page's entire purpose were invisible. Same event names as the homepage
         badges, with a different `location`, so the two placements can be compared. -->
    <script is:inline async src="https://plausible.io/js/pa-3pxexgz2YF03NyMDucQKN.js"></script>
    <script is:inline>
      ((window.plausible =
        window.plausible ||
        function () {
          (plausible.q = plausible.q || []).push(arguments);
        }),
        (plausible.init = plausible.init || function (i) { plausible.o = i || {}; }));
      plausible.init();
    </script>
    <AppLinks />
  </head>
  <body>
    <h1>get <span>beanies.family</span> on your phone</h1>
    <div class="choices">
      <a href="/ios" rel="noopener" data-cta="CTA: App Store (iOS)" data-cta-loc="download-page">📱 App Store — iPhone &amp; iPad</a>
      <a href="/android" rel="noopener" data-cta="CTA: App Store (Android)" data-cta-loc="download-page">🤖 Google Play — Android</a>
    </div>
    <p class="muted">no phone handy? open <strong>app.beanies.family</strong> in your browser — it works there too.</p>
    <!-- Hoisted (bundled module) script, NOT `is:inline`, on purpose: an inline script runs during
         parsing, before AppLinks' module script, so the phone redirect would leave the page before
         the `landing` beacon was sent (and /ios would then see a same-origin referrer and send
         none). Module scripts run in document order, and AppLinks (above) already sends the
         landing, so this one only redirects. -->
    <!-- Fallback if the bundled module above never loads (stale CDN chunk, blocked script): after
         2s, send phones on unless the module already redirected. -->
    <script is:inline>
      setTimeout(function () {
        if (window.__beaniesStoreRedirected) return;
        var ua = navigator.userAgent || '';
        if (/iPhone|iPad|iPod/i.test(ua)) location.replace('/ios' + location.search);
        else if (/Android/i.test(ua)) location.replace('/android' + location.search);
      }, 2000);
    </script>
    <script>
      // On a phone, skip the chooser and go straight to the right store.
      const ua = navigator.userAgent || '';
      const flagAndGo = (path: string) => {
        (window as unknown as { __beaniesStoreRedirected?: boolean }).__beaniesStoreRedirected = true;
        location.replace(path + location.search);
      };
      if (/iPhone|iPad|iPod/i.test(ua)) flagAndGo('/ios');
      else if (/Android/i.test(ua)) flagAndGo('/android');
      // Desktop / unknown: leave the two choices visible.
    </script>
  </body>
</html>
