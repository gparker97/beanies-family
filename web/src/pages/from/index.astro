---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { APP_URL } from '@beanies/brand/nav';
// Caveat — the CIG handwritten accent face, imported per-page (same pattern as
// WorldsBeanstalk.astro and /from/maple).
import '@fontsource-variable/caveat';

/**
 * The switching hub. Each entry becomes a card; `href` null means the page
 * isn't written yet and the card renders as a non-link (never a 404).
 */
const SOURCES = [
  {
    glyph: '🍁',
    name: 'maple',
    hook: 'shutting down on december 31, 2026, and taking your family data with it.',
    href: '/from/maple',
    urgent: true,
  },
  {
    glyph: '🗓️',
    name: 'cozi',
    hook: 'free, as long as you don’t mind ads sitting in front of your family’s schedule.',
    href: '/from/cozi',
    urgent: false,
  },
  {
    glyph: '🖼️',
    name: 'skylight',
    hook: 'a lovely wall calendar, for the price of a tablet you already own plus a subscription.',
    href: null,
    urgent: false,
  },
];
---

<BaseLayout
  title="switching to beanies.family"
  description="coming from maple, cozi, or skylight? beanies.family does the same job - calendars, to-dos, meals, and even finances - except your family's data lives in your own encrypted file, on your own storage."
  canonicalPath="/from"
>
  <div class="welcome-page">
    <header class="hub-hero">
      <div class="wrap narrow">
        <Breadcrumbs items={[{ label: 'home', href: '/' }, { label: 'switching', href: '/from' }]} />
        <p class="kicker kicker--pill"><i aria-hidden="true">👋</i> switching?</p>
        <h1>coming from somewhere else?<br /><em>come on in.</em></h1>
        <p class="sub">
          Family apps come and go. Some get shut down, some start showing you ads, some want you to buy a
          tablet you already own. Whichever one brought you here, the welcome mat is out. Bring your
          family's stuff across, and this time it stays yours.
        </p>
        <div class="mat" aria-hidden="true"><span>wipe your feet, come on in 👋</span></div>
      </div>
    </header>

    <section class="section section--tight">
      <div class="wrap">
        <ul class="cards">
          {
            SOURCES.map((s) => (
              <li>
                {s.href ? (
                  <a class="card card--live" href={s.href}>
                    <span class="card__glyph" aria-hidden="true">{s.glyph}</span>
                    <h2>from {s.name}</h2>
                    <p>{s.hook}</p>
                    {s.urgent && <span class="pill pill--urgent">deadline: dec 31, 2026</span>}
                    <span class="card__go">the {s.name} moving guide →</span>
                    <span class="card__path" aria-hidden="true">
                      <span class="bean b1" /><span class="bean b2" />
                      <span class="bean b3" /><span class="bean b4" />
                    </span>
                  </a>
                ) : (
                  <div class="card card--soon">
                    <span class="card__glyph" aria-hidden="true">{s.glyph}</span>
                    <h2>from {s.name}</h2>
                    <p>{s.hook}</p>
                    <span class="pill">writing this one now</span>
                  </div>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="closing">
      <div class="wrap narrow">
        <p class="kicker">whichever door you came through</p>
        <h2 class="closing__title">your data comes with you, and it stays yours.</h2>
        <p class="sub">
          Everything lives in a single encrypted file on your own storage. I never see it, so I can't read
          it, sell it, or lose it. No ads, no deletion date, and nobody reading your family's business but
          your family.
        </p>
        <ul class="trust">
          <li>🔒 end-to-end encrypted</li>
          <li>📂 your file, your storage</li>
          <li>🚫 no ads, ever</li>
          <li>🆓 free (for now)</li>
        </ul>
        <a
          href={APP_URL}
          data-cta="CTA: Create Pod"
          data-cta-loc="from-hub"
          class="btn btn-primary">start counting beans 🫘</a
        >
      </div>
    </section>
  </div>
</BaseLayout>

<style>
.welcome-page {
  --deep-slate: #2c3e50;
  --heritage-orange: #f15d22;
  --sky-silk: #aed6f1;
  --terracotta: #e67e22;
  --cloud-white: #f8f9fa;
  --body-text: #4a5568;
  /* AA-safe muted shade, matching the homepage (the lighter slate it replaced
     measured ~2.9:1 on cloud-white and failed the contrast audit). */
  --muted-text: #4d5d6c;
  --sq: 24px;
  --card-shadow: 0 4px 20px rgb(44 62 80 / 5%);
  --card-hover-shadow: 0 8px 32px rgb(44 62 80 / 10%);

  background: var(--cloud-white);
  color: var(--body-text);
  font-family: 'Inter Variable', Inter, sans-serif;
  line-height: 1.7;
  overflow-x: hidden;
}

.wrap { margin: 0 auto; max-width: 1040px; padding: 0 24px; }
.narrow { max-width: 680px; }

.hub-hero {
  background:
    radial-gradient(680px 420px at 12% 0%, rgb(241 93 34 / 10%), transparent 68%),
    radial-gradient(560px 380px at 88% 18%, rgb(174 214 241 / 32%), transparent 70%),
    var(--cloud-white);
  overflow: hidden;
  padding: 104px 0 12px;
  text-align: center;
}

.kicker {
  color: var(--heritage-orange);
  font-family: 'Outfit Variable', Outfit, sans-serif;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.kicker--pill {
  align-items: center;
  background: rgb(241 93 34 / 10%);
  border-radius: 999px;
  display: inline-flex;
  gap: 8px;
  margin-top: 22px;
  padding: 7px 16px 7px 12px;
}

.kicker--pill i { font-size: 0.95rem; font-style: normal; line-height: 1; }

.hub-hero h1 {
  color: var(--deep-slate);
  font-size: clamp(2.1rem, 4.6vw, 3.1rem);
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 1.06;
  margin: 0.9rem 0 0;
  text-wrap: balance;
}

.hub-hero h1 em { color: var(--heritage-orange); font-style: italic; }
.sub { color: var(--muted-text); margin: 1.15rem auto 0; max-width: 56ch; }

/* the mat — the hub's echo of the welcome idea. The lit doorway is deliberately
   NOT repeated here; that belongs to the destination pages. */
.mat {
  background: repeating-linear-gradient(90deg, #e8b98a 0 10px, #e2ad78 10px 20px);
  border: 6px solid #c98d55;
  border-radius: 12px;
  box-shadow: 0 18px 28px rgb(44 62 80 / 16%);
  margin: 34px auto 0;
  max-width: 330px;
  padding: 14px 12px 16px;
  transform: perspective(560px) rotateX(44deg);
}

.mat span {
  color: #7a4a1d;
  font-family: 'Caveat Variable', Caveat, Outfit, cursive;
  font-size: 1.5rem;
  font-weight: 700;
  white-space: nowrap;
}

.section { padding: 72px 0; }
.section--tight { padding-top: 56px; }

.cards {
  display: grid;
  gap: 22px;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  list-style: none;
  margin: 0;
  padding: 0;
}

.card {
  background: #fff;
  border-radius: var(--sq);
  box-shadow: var(--card-shadow);
  display: block;
  height: 100%;
  padding: 28px 26px 24px;
  position: relative;
  text-decoration: none;
}

.card__glyph { font-size: 1.9rem; line-height: 1; }

.card h2 {
  color: var(--deep-slate);
  font-size: 1.15rem;
  font-weight: 700;
  margin: 10px 0 6px;
}

.card p { color: var(--muted-text); font-size: 0.9rem; margin: 0; }

.card--live { transition: transform 200ms ease, box-shadow 200ms ease; }
.card--live:hover { box-shadow: var(--card-hover-shadow); transform: translateY(-2px); }

.card__go {
  color: var(--heritage-orange);
  display: block;
  font-family: 'Outfit Variable', Outfit, sans-serif;
  font-size: 0.88rem;
  font-weight: 700;
  margin-top: 16px;
}

/* The Pod, in its mandated order, as a path leading into the live card. */
.card__path { display: flex; gap: 11px; margin-top: 16px; }
.bean { border-radius: 50% 50% 48% 48% / 62% 62% 38% 38%; flex: none; height: 15px; width: 12px; }
.b1 { background: var(--deep-slate); }
.b2 { background: var(--terracotta); }
.b3 { background: var(--heritage-orange); }
.b4 { background: var(--sky-silk); }

.card--soon { opacity: 0.72; }

.pill {
  background: var(--tint-slate-5, rgb(44 62 80 / 5%));
  border-radius: 999px;
  color: var(--muted-text);
  display: inline-block;
  font-family: 'Outfit Variable', Outfit, sans-serif;
  font-size: 0.72rem;
  font-weight: 600;
  margin-top: 16px;
  padding: 5px 13px;
}

.pill--urgent { background: rgb(241 93 34 / 10%); color: var(--heritage-orange); }

.closing {
  background: radial-gradient(520px 320px at 50% 0%, rgb(241 93 34 / 8%), transparent 70%), var(--cloud-white);
  padding: 24px 0 96px;
  text-align: center;
}

.closing__title {
  color: var(--deep-slate);
  font-size: clamp(1.5rem, 3.4vw, 2.1rem);
  font-weight: 800;
  margin: 0.4rem 0 0;
  text-wrap: balance;
}

.trust {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  justify-content: center;
  list-style: none;
  margin: 26px 0 30px;
  padding: 0;
}

.trust li {
  align-items: center;
  background: #fff;
  border-radius: 999px;
  box-shadow: var(--card-shadow);
  color: var(--muted-text);
  display: inline-flex;
  font-size: 0.78rem;
  gap: 7px;
  padding: 8px 15px;
}

.btn {
  border-radius: 16px;
  display: inline-block;
  font-family: 'Outfit Variable', Outfit, sans-serif;
  font-size: 0.95rem;
  font-weight: 700;
  padding: 14px 26px;
  text-decoration: none;
  transition: transform 180ms ease, box-shadow 180ms ease;
}

.btn-primary {
  background: linear-gradient(135deg, var(--heritage-orange), var(--terracotta));
  box-shadow: 0 8px 24px rgb(241 93 34 / 32%);
  color: #fff;
}

.btn-primary:hover { box-shadow: 0 14px 32px rgb(241 93 34 / 38%); transform: translateY(-2px); }

@media (prefers-reduced-motion: reduce) {
  .card--live, .btn { transition: none; }
}
</style>
