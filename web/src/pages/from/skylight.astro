---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { APP_URL } from '@beanies/brand/nav';
// Caveat - the CIG handwritten accent face. Imported per-page rather than in
// BaseLayout, matching /from/maple and WorldsBeanstalk.astro: only the pages that
// actually use the accent should pay for the font.
import '@fontsource-variable/caveat';
import '../../styles/switch-page.css';
// The kitchen-wall scene. Imported AFTER the shared sheet so its `wall-` classes
// layer on top of the furniture rather than fighting it.
import '../../styles/skylight-wall.css';
import TrustBetaFree from '../../components/TrustBetaFree.astro';

/**
 * /from/skylight - the switching page for people who own, or are pricing, a
 * Skylight Calendar.
 *
 * ⚠️ EVERY FACTUAL CLAIM ABOUT SKYLIGHT ON THIS PAGE WAS VERIFIED ON 2026-09-09,
 * and the ones that could not be verified were CUT rather than softened. An
 * earlier draft carried six "quotes" presented as reviewers' own words; only one
 * was verbatim, two were recast from real sources, one was a real number cited to
 * the wrong place, and two could not be substantiated at all (a sync-lag claim
 * contradicted by every dated source, and a line attributed to Skylight itself
 * that appears nowhere in their release notes). Publishing invented reviewer
 * quotes, or putting words in a named company's mouth, is not a risk worth any
 * amount of copy. If you add a claim here, source it or leave it out.
 *
 * Prices are LIST prices seen on 2026-09-09 and they move. Skylight's own store
 * is the citation, because retailers run $20-$40 above it on the Calendar 2 and
 * the Max, which is the opposite of the usual pattern and makes any retailer
 * figure look wrong against the direct one.
 */

const PRICE_15 = '$299.99';
const PRICE_MAX = '$599.99';
const PLUS_YEAR = '$79';
---

<BaseLayout
  title="skylight alternative - keep the wall, bring your own tablet"
  description="Skylight's Calendar 2 is $299.99 and the 27in wall-mounted Max is $599.99, before the $79 a year subscription. beanies.family does the same job in wall mode on a tablet you already own, with everything included and your family's data in your own encrypted file."
  canonicalPath="/from/skylight"
>
  <div class="welcome-page">
    <header class="hero">
      <div class="wrap wall-hero">
        <Breadcrumbs
          items={[
            { label: 'home', href: '/' },
            { label: 'switching', href: '/from' },
            { label: 'from skylight', href: '/from/skylight' },
