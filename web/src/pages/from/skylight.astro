<script>
  /* The tablet cycles the four real wall views. It is the page's argument, so it
     runs on its own, but the switcher is a real control: touch it and the page
     stops deciding for you. Reduced motion holds it on the week. */
  (function () {
    const views = Array.from(document.querySelectorAll<HTMLElement>('.wall-view'));
    const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('.wall-switcher button'));
    if (!views.length || !btns.length) return;

    const order = ['days', 'lanes', 'today', 'jobs'];
    let i = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');

    function show(name: string) {
      for (const v of views) {
        if (v.dataset.view === name) v.setAttribute('data-on', '');
        else v.removeAttribute('data-on');
      }
      for (const b of btns) b.setAttribute('aria-pressed', String(b.dataset.go === name));
      i = order.indexOf(name);
    }
    function tick() {
      show(order[(i + 1) % order.length]);
    }
    function start() {
      if (!still.matches && !timer) timer = setInterval(tick, 4200);
    }
    function stop() {
      if (timer) clearInterval(timer);
      timer = null;
    }

    for (const b of btns) {
      b.addEventListener('click', () => {
        stop();
        show(b.dataset.go ?? 'days');
      });
    }
    /* Don't animate a screen nobody is looking at. */
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });
    still.addEventListener('change', () => {
      stop();
      if (!still.matches) start();
    });
    start();
  })();
</script>
