---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorldsBeanstalk from '../components/WorldsBeanstalk.astro';
import HeroShowcase from '../components/HeroShowcase.astro';
import { SOFTWARE_APPLICATION } from '@beanies/brand/schema';
import { APP_URL } from '@beanies/brand/nav';

// The LCP element. Single source of truth: this same path feeds BOTH the
// `<link rel="preload" as="image">` (via BaseLayout's `lcpImage`) and the
// `<img src>` below. They MUST stay identical — if they drift, the browser
// preloads a file it never uses, the real LCP image silently loses its
// preload, and the only signal is a console notice. Hoisted 2026-07-21 to
// make that drift unrepresentable.
//
// 512 is the RIGHT size, not an oversight: the box is 180 CSS px
// (`.hero__mascot`, at every breakpoint) and device pixel ratios of
// 2.625 (the profile Lighthouse emulates) to 3 need 473-540px. Shrinking
// this to "match" the 180px box would make it visibly soft on most phones.
// See docs/plans/2026-07-21-homepage-lcp-critical-css.md § Step 1a.
const HERO_MASCOT = '/brand/beanies_family_hugging_transparent_512x512.webp';
---

<BaseLayout
  title="beanies.family - every bean counts"
  description="one app to manage your family's money, activities, and all the little beans. open source and fully encrypted. no ads, no tracking, no nonsense."
  canonicalPath="/"
  jsonLd={SOFTWARE_APPLICATION}
  lcpImage={HERO_MASCOT}
>
  <div class="landing-page">
    <!-- HERO -->
    <section id="top" class="hero">
      <!-- Decorative layer. Every child is position:absolute with percentage
           anchors; this wrapper gives them a viewport-sized containing block so
           those percentages cannot follow the hero's content height. See the
           .hero__deco-layer rule below for why that matters. -->
      <div class="hero__deco-layer">
      <div class="hero__bean" style="left: 6%; top: 10%; transform: rotate(-15deg)">🫘</div>
      <div class="hero__bean" style="font-size: 1.6rem; right: 8%; top: 25%; transform: rotate(20deg)">🫘</div>
      <div class="hero__bean" style="bottom: 18%; font-size: 1.5rem; left: 12%; transform: rotate(-30deg)">🫘</div>
      <div class="hero__bean" style="font-size: 1.3rem; right: 5%; top: 60%; transform: rotate(10deg)">🫘</div>
      <div class="hero__bean" style="bottom: 35%; font-size: 1.8rem; right: 18%; transform: rotate(-20deg)">🫘</div>

      <img src="/brand/beanies_small_bean_favicon_512x512.webp" alt="" width="512" height="512" loading="lazy" decoding="async" class="hero__deco-img" style="animation: decoFloat1 8s ease-in-out infinite; opacity: 0.06; right: 12%; top: 8%; transform: rotate(12deg); width: 40px; height: auto" />
      <img src="/brand/beanies_open_eyes_transparent_512x512.webp" alt="" width="512" height="512" loading="lazy" decoding="async" class="hero__deco-img" style="bottom: 15%; opacity: 0.04; right: 6%; transform: rotate(-8deg); width: 50px; height: auto" />
      <img src="/brand/beanies_impact_bullet_transparent_192x192.webp" alt="" width="192" height="192" loading="lazy" decoding="async" class="hero__deco-img" style="animation: decoFloat2 10s ease-in-out infinite; left: 4%; opacity: 0.05; top: 45%; transform: rotate(15deg); width: 35px; height: auto" />

      <div class="hero__deco" style="background: var(--sky-silk); height: 400px; right: -150px; top: -100px; width: 400px"></div>
      <div class="hero__deco" style="background: radial-gradient(circle, var(--heritage-orange) 0%, var(--heritage-orange) 18%, transparent 72%); bottom: calc(10% - 300px); height: 900px; left: -420px; width: 900px"></div>
      <div class="hero__deco" style="background: radial-gradient(circle, var(--terracotta) 0%, var(--terracotta) 20%, transparent 74%); height: 680px; opacity: 0.04; right: calc(5% - 240px); top: calc(40% - 240px); width: 680px"></div>
      </div>

      <div class="hero__mascot">
        <img
          src={HERO_MASCOT}
          alt="the beanies family"
          width="512"
          height="512"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <h1 class="hero__headline">every. bean.<br /><em>counts.</em></h1>
      <p class="hero__sub">
        one app to manage your family's money, activities, and all the little beans. open source and
        fully encrypted. no ads, no tracking, no nonsense.
      </p>

      <div class="hero__privacy">
        <span class="hero__privacy-line">
          <span class="hero__privacy-muted">your data never leaves your hands.</span>
          <a class="hero__privacy-em" href="#security" data-scroll-to="security"
            >privacy, guaranteed. <span class="hero__privacy-arrow" aria-hidden="true">↓</span></a
          >
        </span>
      </div>

      <div class="hero__cta-group">
        <a
          data-testid="homepage-get-started"
          data-cta="CTA: Create Pod"
          data-cta-loc="homepage-hero"
          class="btn-primary"
          href={`${APP_URL}/welcome`}
        >
          start counting beans 🫘
        </a>
        <a class="hero__jump-link" href="#features" data-scroll-to="features">see what's inside ↓</a>
      </div>

      <div class="hero__stores">
        <span class="hero__stores-label">or get the app</span>
        <div class="hero__stores-badges">
          <a href="/ios" data-cta="CTA: App Store (iOS)" data-cta-loc="homepage-hero" aria-label="Download beanies.family on the App Store">
            <img src="/badges/app-store.svg" alt="Download on the App Store" width="120" height="40" loading="lazy" decoding="async" />
          </a>
          <a href="/android" data-cta="CTA: App Store (Android)" data-cta-loc="homepage-hero" aria-label="Get beanies.family on Google Play">
            <img src="/badges/google-play.svg" alt="Get it on Google Play" width="239" height="71" loading="lazy" decoding="async" />
          </a>
        </div>
      </div>

      <!-- App preview: browser-framed desktop + two phones on desktop; a swipe
           carousel of the app screens on mobile. Pure-CSS (no images) so it adds
           no LCP/CLS weight. See src/components/HeroShowcase.astro. -->
      <HeroShowcase />

      <div class="trust-row">
        <div class="trust-badge"><div class="trust-icon">🔒</div>encrypted everything</div>
        <div class="trust-badge"><div class="trust-icon">🏦</div>we (I) can't read your data</div>
        <div class="trust-badge"><div class="trust-icon">❤️</div>made by a real dad (me)</div>
        <div class="trust-badge"><div class="trust-icon">🚫</div>no ads. no tracking.</div>
      </div>

      <div class="scroll-cue">
        <span>scroll</span>
        <div class="scroll-line"></div>
      </div>
    </section>

    <div class="section-fade section-fade--hero-out"></div>

    <!-- WHAT'S INSIDE — three-worlds scroll-grown beanstalk (Notion #56) -->
    <WorldsBeanstalk />

    <div class="section-fade section-fade--to-dark"></div>

    <!-- SECURITY -->
    <section id="security" class="security-section">
      <div class="ambient-orb ambient-orb--1"></div>
      <div class="ambient-orb ambient-orb--2"></div>
      <img src="/brand/beanies_small_bean_favicon_512x512.webp" alt="" width="512" height="512" loading="lazy" decoding="async" class="security-section__deco-accent" />
      <div class="container">
        <p class="section-label reveal">privacy &amp; security</p>
        <h2 class="section-title reveal">seriously, I don't want your data</h2>
        <p class="section-subtitle reveal">
          your family's data never touches our servers. we built it that way on purpose, because I
          wouldn't trust my data with you, either. no offense.
        </p>

        <div class="security-grid">
          <div class="security-card reveal reveal-delay-1">
            <div class="security-card__icon">🔐</div>
            <p class="security-card__title">real encryption, not marketing talk</p>
            <p class="security-card__text">
              <a href="/help/glossary#aes-gcm" class="story__link">AES-256-GCM</a> on everything, at rest and in transit. your data is genuinely unreadable
              to anyone without your key - including me.
            </p>
          </div>
          <div class="security-card reveal reveal-delay-2">
            <div class="security-card__icon">🔑</div>
            <p class="security-card__title">you hold the keys</p>
            <p class="security-card__text">
              each family member gets their own password-derived key (<a href="/help/glossary#pbkdf2" class="story__link">PBKDF2</a>) that wraps a shared
              family key (<a href="/help/glossary#aes-kw" class="story__link">AES-KW</a>). lost your password? I can't help you. that's kinda the whole point.
            </p>
          </div>
          <div class="security-card reveal reveal-delay-3">
            <div class="security-card__icon">📦</div>
            <p class="security-card__title">your storage, your rules</p>
            <p class="security-card__text">
              it's called <a href="/guides/local-first-family-finance-planning-tools" class="story__link">local-first</a>: your encrypted data file lives in your own personal storage
              and travels directly to your browser - we never see it, touch it, or store it.
            </p>
          </div>
          <div class="security-card reveal reveal-delay-1">
            <div class="security-card__icon">🚫</div>
            <p class="security-card__title">we don't even own a (real) database</p>
            <p class="security-card__text">
              one lookup table in the cloud maps your family ID to your encrypted data file. that's
              literally it. no analytics, no tracking, no selling your info.
            </p>
          </div>
          <div class="security-card reveal reveal-delay-2">
            <div class="security-card__icon">🌐</div>
            <p class="security-card__title">go ahead, read the code</p>
            <p class="security-card__text">
              it's all on <a href="https://github.com/gparker97/beanies-family" target="_blank" class="story__link">GitHub</a>. audit it, fork it, run it on your own machine. if you find something sketchy, open an issue. you won't, but I appreciate that you at least thought about it.
            </p>
          </div>
          <div class="security-card reveal reveal-delay-3">
            <div class="security-card__icon">🧹</div>
            <p class="security-card__title">sign out = cache gone (if you want)</p>
            <p class="security-card__text">
              your browser keeps an encrypted cache for speed. wipe it clean anytime you want. no
              breadcrumbs, no leftover beans.
            </p>
          </div>
        </div>

        <img src="/brand/beanies_covering_eyes_transparent_512x512.webp" alt="" width="512" height="512" loading="lazy" decoding="async" class="security-section__watermark" />
      </div>
    </section>

    <div class="section-fade section-fade--to-light"></div>
    <div class="section-fade section-fade--to-story" style="margin-top: -1px"></div>

    <!-- STORY -->
    <section id="story" class="story-section">
      <div class="ambient-orb ambient-orb--1"></div>
      <div class="ambient-orb ambient-orb--2"></div>
      <img src="/brand/beanies_celebrating_circle_transparent_300x300.webp" alt="" width="300" height="300" loading="lazy" decoding="async" class="story-section__deco-accent" />
      <div class="story-header reveal">
        <img src="/brand/beanies_father_son_icon_512x512.webp" alt="Beanies father and son" width="512" height="512" loading="lazy" decoding="async" class="story-header__illustration" />
        <p class="section-label">the beanies story</p>
        <h2 class="section-title">okay, here's the deal</h2>
      </div>

      <div class="story__body">
        <p class="story__greeting reveal">Hey, guys! <span class="beanie-emoji">🫘</span></p>

        <p class="reveal">
          Yes, it's <em>actually</em> me. Even AI could not come up with a greeting as mundane as
          "Hey, guys!" Indeed, there are still some things humans are better at than robots, such as
          glorious, unadulterated, deliciously spontaneous non-sequiturs, like how I like to fart
          outside taco trucks on wednesday afternoons. But getting back to the point...
        </p>

        <p class="reveal">
          Since the day I "graduated" college for a real job, put in a solid month of (let's call
          it) work, and witnessed my first paycheck direct-deposited to my bank account,
          <span class="story__highlight">this is the app I've wanted to create.</span> I gazed
          lovingly at the glorious $2,867 (minus taxes) in my account, and dreamt about the day I
          would definitely become a billionaire. Or at least when I wouldn't be a starving student anymore.
        </p>

        <p class="reveal">
          It started with a janky spreadsheet. I added formulas, tables, charts. I wanted to keep
          track of how much I spent and saved, and project it forward. I might have even written
          some VB macros, toying with my precious sheet for months (maybe years) trying to get it to
          work the way I wanted.
        </p>

        <p class="reveal">
          Then, the world changed (in, let's say, 2008), and I said to myself, "Hey, self! Why do
          you keep trying to re-invent the wheel (the wheel having been invented earlier that year)?
          There's a million personal finance apps out there! Just download one, you numbskull."
        </p>

        <p class="reveal">
          So I did, and I fiddled with those fickle banking connectors that sync your transactions,
          but always fail. They ask for your online banking credentials 10 times in a row, and
          proceed to not work anyway. Lots of my important transactions were in cash or paid on
          cards. Some banks and cards don't provide reliable APIs. When things did work, it was
          temporary and only tracked what you <em>did</em> spend, not what you <em>planned</em> to spend.
        </p>

        <p class="reveal">
          Well, at least I didn't divulge the secret key for all my bank accounts to some nameless
          software corporation. Wait... nevermind.
        </p>

        <p class="reveal">
          In any case, my goal was never to record every last transaction and track my budget down
          to the penny. If that's yours, this app probably isn't for you.
          <span class="story__emphasis">I just wanted a rough idea</span>, <a href="/guides/family-finance-basics" class="story__link">so I would know if I was
          going to end up as a hobo</a> in 6 months.
        </p>

        <p class="reveal">
          Then, we had kids. With one (1) child, we could generally manage. After 2 kids, life got crazier.
          <span class="story__highlight">Bump that up to 3 (at school age) and welcome to the insane world of chaos and confusion and writing readmes to dumb personal family planning apps you vibe coded on a whim at 3am.</span>
          Or, <a href="/guides/overwhelmed-family-planning" class="story__link">whatever</a>.
        </p>

        <p class="reveal">
          Soccer practice, piano lessons, math tutor, gymnastics (2 types), chinese classes,
          taekwondo, and don't forget your actual school fees, your rent (or mortgage), and the list
          goes on. Who has to pay for what, and when, and how, and to who? Or is it whom? Also,
          while you were obsessing over the proper application of archaic English grammar rules, you
          realized you forgot to pick up your kid from his baseball tryouts. And it's raining. At
          least he has his umbrella. (Cue glance to the floor to spot the umbrella that fell out of
          his sports bag).
        </p>

        <p class="reveal">
          When my youngest was about 6 months old, my wife started calling him
          <span class="story__pinyin-wrap"><ruby class="story__orange story__pinyin">小豆豆<rp>(</rp><rt>xiǎo dòu dou</rt><rp>)</rp></ruby></span>. Which in Chinese sounds endearing, but just means
          <span class="story__orange">little bean</span>. Cuz he sort of looked like one. It sounds
          cute in English too, so I called him <span class="story__orange">beanie</span>, and it stuck.
        </p>

        <p class="reveal">
          I built this app to track all that stuff I mentioned above: your family finances, what you
          spent and received, what you plan to spend and receive (roughly), and to know how much
          you'll have in the future - in short, your "wealth".
        </p>

        <p class="reveal">
          But also, <a href="/guides/family-organization" class="story__link">I built this to track your <em>actual</em> family life</a>: piano lessons,
          schoolwork, sports practice, ballet class, family vacations (we may even give you advice),
          and, of course, who will pick up whom (yes, <em>whom</em>). In short,
          <span class="story__highlight">anything we can help you with, even in a small way, as you navigate the joys and sorrows of a complicated, crowded, chaotic, stressful, but of course, rewarding?</span>
          (sorry, I meant, rewarding) <span class="story__highlight">family life.</span>
        </p>

        <p class="reveal">
          It's not a perfect app. It doesn't pull in stuff from google calendar
          (<a href="/blog/google-calendar-integration" class="story__link">but we do <em>push</em> stuff to google calendar</a>) or sync with
          banks (I doubt it ever will). But it gives you a rough idea of how much you have, how much
          you will have, and what in this heavenly world you actually have to do <em>today</em>. (Of
          course, only if you tell it that stuff first. It's not magic.)
        </p>

        <p class="reveal">
          Treat <a href={`${APP_URL}/create`} class="story__link" data-cta="CTA: Create Pod" data-cta-loc="story-inline">beanies.family</a> like a
          friend, and it will reward you in spades. Maybe it'll even buy you a beer the next time
          you can spare 22 minutes after work and have $7 saved from meticulously tracking your
          budget every month. (Is that how much beers cost nowadays? I wouldn't know.)
        </p>

        <p class="reveal">
          You can clone and install it for free if you want to run it locally. <a href="/blog/have-your-cake-and-eat-it-too" class="story__link">The data never leaves
          your machine</a> if you don't want it to. We don't even own a database (well, not a real one).
          I don't want your janky finance data anyway, and I'm not picking up your kid for you.
        </p>

        <p class="reveal">
          If you want the cloud version so you can share it with your family (don't worry, your data
          still stays with you), <a href={`${APP_URL}/create`} class="story__link" data-cta="CTA: Create Pod" data-cta-loc="story-inline">create your family's private beanpod</a>. You could also set
          up the infra by yourself (and pay for it), but that's a pain and you know it.
        </p>

        <p class="reveal" style="margin-bottom: 0.8em">Here's the fun stuff:</p>

        <ul class="story__tech-list reveal">
          <li><span class="story__tech-icon">🤖</span><span><strong>Claude Max / Opus</strong> - Mostly. I may have pitched in a line or 2.</span></li>
          <li><span class="story__tech-icon">💻</span><span><strong>Vue 3 / TypeScript</strong> + Vite / Tailwind / Pinia</span></li>
          <li><span class="story__tech-icon">💾</span><span><strong><a href="/help/glossary#indexeddb" class="story__link">IndexedDB</a></strong> - to cache encrypted family data in your local browser, which you can clear at anytime</span></li>
          <li><span class="story__tech-icon">🔒</span><span><strong><a href="/help/glossary#web-crypto-api" class="story__link">Web Crypto API</a></strong> - Your data is fully encrypted in transit and at rest (AES-256-GCM), each family member gets their own password-derived key (PBKDF2) that wraps a shared family key (AES-KW), and data <em>never</em> leaves your personal storage location, except to travel directly to (and from) your browser's (encrypted) cache</span></li>
          <li><span class="story__tech-icon">🔀</span><span><strong>Automerge</strong> - for CRDTs <a href="/guides/local-first-family-finance-planning-tools#crdts-how-local-first-apps-stay-in-sync-without-a-server-telling-them-what-to-do" class="story__link">(click here if you think that's a made-up acronym)</a>.. adds a bit of heft to the package, but we tried rolling our own merge algorithms and trust me, it's not worth it. Keeping your data safe is what matters</span></li>
          <li><span class="story__tech-icon">🧪</span><span><strong>Vitest + Playwright + Dependabot</strong> - unit tests, E2E tests, and automated dependency updates to keep things secure (seriously, how cool is Dependabot!?)</span></li>
          <li><span class="story__tech-icon">☁️</span><span><strong>One single, stupid, plain vanilla DynamoDB</strong> - in the cloud to map your family ID to your (encrypted) data file, so we can locate it in your personal location that only you can access. Nothing else. Anywhere. Ever.</span></li>
        </ul>

        <p class="reveal">
          So there it is. If you're a techie nerd like me, run it locally. If you don't want to deal
          with the bs, use <a href={`${APP_URL}/create`} class="story__link" data-cta="CTA: Create Pod" data-cta-loc="story-inline">beanies.family</a>.
        </p>

        <p class="reveal">
          I'm using <a href={`${APP_URL}/create`} class="story__link" data-cta="CTA: Create Pod" data-cta-loc="story-inline">beanies</a> to track our
          money, our various (1) houses, our (0) boats, my wife's (currently missing) diamond ring
          (ask my wife where she lost hers.. unfortunately beanies can't tell you that), and more.
          I'll use it even more for their piano lessons, soccer practices, school plays that, as a
          respectable father, I really should attend, and to make sure we don't forget to pick up
          our son from his after school math tutor (again). All while keeping our data safe and
          secure on my family's personal storage (unless I open read access on my data file to the
          world and tell everyone the key. Which I won't. Probably.).
        </p>

        <p class="reveal">
          If you have a question, comment, suggestion, or just wanna say hi, reach me on the <a href="/discord" target="_blank" rel="noopener" class="story__link">beanies.family discord</a>, where we discuss anything and everything related to this app and family organization in general. If you're using beanies for free and wanna drop me a satoshi for my time (or just cuz you like the app), that's cool too (1beanks5zbnAcptUeSdrepxqrCzxEuA2z).
        </p>

        <div class="story__signoff reveal">
          <p class="story__signoff-tagline">simplify your family life. every bean counts.</p>
          <p class="story__signoff-name">peace out, my beans.</p>
          <p class="story__signoff-name">greg</p>
        </div>

        <div class="story__signoff-row reveal">
          <img src="/brand/beanies_father_son_icon_512x512.webp" alt="greg and beanie" width="512" height="512" loading="lazy" decoding="async" class="story__signoff-img" />
          <a href="/blog/accidentally-built-greatest-family-app" class="story__next-post">
            <p class="story__next-post-text">want to read more? here's my next post!</p>
            <div class="story__next-post-arrow">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </div>
          </a>
        </div>

        <p class="reveal" style="color: var(--muted-text); font-size: 0.78rem; margin-top: 32px; opacity: 0.7; text-align: center;">
          beanies.family is open source. see
          <a href="https://github.com/gparker97/beanies-family/blob/main/LICENSE" class="story__link" style="font-size: inherit">LICENSE</a>
          and
          <a href="https://github.com/gparker97/beanies-family/blob/main/TRADEMARK.md" class="story__link" style="font-size: inherit">TRADEMARK.md</a>
          for details.
        </p>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="final-cta">
      <div class="ambient-orb ambient-orb--1"></div>
      <div class="ambient-orb ambient-orb--2"></div>
      <img src="/brand/beanies_celebrating_circle_transparent_300x300.webp" alt="" width="300" height="300" loading="lazy" decoding="async" class="final-cta__hero-img" />
      <img src="/brand/beanies_neutral_icon_transparent_350x350.webp" alt="" width="350" height="350" loading="lazy" decoding="async" class="final-cta__deco-accent" />
      <div class="container">
        <h2 class="final-cta__title reveal">so... ready to count some beans? <em>🫘</em></h2>
        <p class="final-cta__sub reveal">
          it's free. run it locally or login below. yes, it's really free. probably not forever.
        </p>
        <div style="display: flex; flex-wrap: wrap; gap: 14px; justify-content: center" class="reveal">
          <a
            class="btn-primary"
            href={`${APP_URL}/welcome`}
            data-cta="CTA: Create Pod"
            data-cta-loc="homepage-final">create your bean pod 🫘</a
          >
          <a href="https://github.com/gparker97/beanies-family" target="_blank" rel="noopener" class="btn-secondary">view on GitHub</a>
        </div>
      </div>
    </section>

    <!-- BACK TO TOP -->
    <button id="back-to-top" class="back-to-top" aria-label="Back to top" hidden>↑</button>

    <!-- CONTACT MODAL -->
    <div id="contact-overlay" class="contact-overlay">
      <div class="contact-modal">
        <button class="contact-modal__close" id="close-contact">&times;</button>
        <p class="contact-modal__title">🫘 say hi</p>
        <p class="contact-modal__sub">
          got a question, idea, bug report, or just want to chat? I actually read these.
        </p>
        <form id="contact-form" class="contact-form">
          <div class="contact-form__field">
            <label class="contact-form__label">your name <span class="contact-form__required">*</span></label>
            <input id="contact-name" class="contact-form__input" type="text" placeholder="e.g. fellow bean counter" required />
          </div>
          <div class="contact-form__field">
            <label class="contact-form__label">email <span class="contact-form__required">*</span></label>
            <input id="contact-email" class="contact-form__input" type="email" placeholder="so I can write back" required />
          </div>
          <div class="contact-form__field">
            <label class="contact-form__label">what's on your mind?</label>
            <textarea id="contact-message" class="contact-form__textarea" placeholder="bugs, ideas, compliments, roasts... all welcome"></textarea>
          </div>
          <p id="contact-error" class="contact-form__error" hidden></p>
          <button type="submit" id="contact-submit" class="contact-form__submit">
            send it 🫘
          </button>
        </form>
        <div id="contact-success" class="contact-form__success" hidden>
          <div class="contact-form__success-icon">🫘</div>
          <p class="contact-form__success-msg">message sent!</p>
          <p class="contact-form__success-sub">we'll (I'll) get back to you soon. probably.</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // NOTE: Set PUBLIC_CONTACT_WEBHOOK_URL at build time via .env or the GitHub Actions
  // repository VARIABLE `CONTACT_WEBHOOK_URL` (see .github/workflows/deploy-web.yml).
  // It is a repo variable, not a secret: the value is inlined into this client-side
  // bundle at build time and is therefore public either way — a secret only added
  // rotation friction. Treat the webhook as public and rate-limited accordingly.
  const WEBHOOK_URL = import.meta.env.PUBLIC_CONTACT_WEBHOOK_URL as string | undefined;

  const backToTop = document.getElementById('back-to-top') as HTMLButtonElement | null;

  function onScroll() {
    const sy = window.scrollY;
    if (backToTop) {
      if (sy > 400) backToTop.removeAttribute('hidden');
      else backToTop.setAttribute('hidden', '');
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  function scrollTop() {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  backToTop?.addEventListener('click', scrollTop);

  // Reveal observer
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -40px 0px' },
  );
  document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));

  // Contact modal
  const overlay = document.getElementById('contact-overlay') as HTMLElement | null;
  const openBtn = document.getElementById('open-contact');
  const closeBtn = document.getElementById('close-contact');
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const nameInput = document.getElementById('contact-name') as HTMLInputElement | null;
  const emailInput = document.getElementById('contact-email') as HTMLInputElement | null;
  const msgInput = document.getElementById('contact-message') as HTMLTextAreaElement | null;
  const errorEl = document.getElementById('contact-error') as HTMLElement | null;
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const successEl = document.getElementById('contact-success') as HTMLElement | null;

  function openContact() {
    overlay?.classList.add('active');
    if (successEl) successEl.setAttribute('hidden', '');
    if (form) form.removeAttribute('hidden');
  }
  function closeContact() {
    overlay?.classList.remove('active');
  }

  openBtn?.addEventListener('click', openContact);
  closeBtn?.addEventListener('click', closeContact);
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeContact();
  });

  if (window.location.hash === '#contact') {
    openContact();
    history.replaceState(null, '', window.location.pathname);
  }

  function showError(msg: string) {
    if (errorEl) {
      errorEl.textContent = msg;
      errorEl.removeAttribute('hidden');
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (errorEl) errorEl.setAttribute('hidden', '');
    const name = nameInput?.value.trim() || '';
    const email = emailInput?.value.trim() || '';
    const message = msgInput?.value.trim() || '';
    if (!name || !email) {
      showError('name and email are required.');
      return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showError('please enter a valid email address.');
      return;
    }
    if (!WEBHOOK_URL) {
      showError('contact form is not configured yet. please try again later.');
      return;
    }
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'sending...';
    }
    try {
      await fetch(WEBHOOK_URL, {
        method: 'POST',
        mode: 'no-cors',
        body: JSON.stringify({
          text: `*New Contact Message (Landing Page)*\n*Name:* ${name}\n*Email:* ${email}\n*Message:* ${message}`,
        }),
      });
      form?.setAttribute('hidden', '');
      successEl?.removeAttribute('hidden');
    } catch {
      showError('Something went wrong. Please try again.');
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'send it 🫘';
      }
    }
  });
</script>

<style>
