---
// Stable short link to the beanies.family App Store listing. Every "get the iOS
// app" CTA (homepage badge, Pinterest pins, print collateral) points at
// beanies.family/ios so the destination can be rotated here — a small web
// deploy — without touching the app.
//
// This page is also the SINGLE PATH to the store (badges, pins, print collateral and /download's
// phone redirect all land here), so it records the first-party `store_tap` event and builds the
// final store URL with the visitor's campaign tag (`lib/storeRedirect.ts`; see
// docs/plans/2026-10-03-marketing-events-ledger-inferred-attribution.md). The meta refresh lives
// in <noscript> (plus a 2s fallback meta) so it cannot navigate away before the script has queued the beacon.
//
// Deliberately a minimal standalone page (NOT BaseLayout): no nav/footer, a pure
// forward. Mirrors src/pages/discord.astro.
//
// To change the destination: edit STORE_URL in packages/brand/nav.ts (one copy,
// shared with the Vue app's update prompt) and deploy the web site.
// Region-less Apple link (/app/id…) resolves to each visitor's local storefront.
import { STORE_URL } from '@beanies/brand/nav';
const APP_STORE_URL = STORE_URL.ios;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- No-JS: forward immediately. JS-enabled: a 2-second meta refresh is the fallback if the
         bundled module chunk never loads (stale CDN edge, blocked script, flaky in-app browser).
         2s is deliberate: the module runs well before that, queues the beacon and navigates
         first via location.replace, so the meta only fires when the script could not run. -->
    <noscript><meta http-equiv="refresh" content={`0; url=${APP_STORE_URL}`} /></noscript>
    <meta http-equiv="refresh" content={`2; url=${APP_STORE_URL}`} />
    <link rel="canonical" href={APP_STORE_URL} />
    <meta name="robots" content="noindex" />
    <title>Opening beanies.family on the App Store…</title>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        background: #f8f9fa;
        color: #2c3e50;
        font-family: Outfit, system-ui, sans-serif;
        text-align: center;
        padding: 24px;
      }
      a {
        color: #f15d22;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <p>taking you to the app store… 🫘</p>
    <p>
      not redirected? <a id="store-fallback" href={APP_STORE_URL} rel="noopener">tap here to open the app store</a>.
    </p>
    <script>
      import { redirectToStore } from '../lib/storeRedirect';
      redirectToStore('ios');
    </script>
  </body>
</html>
