---
// beanies.family/musical: the marketing short link to "the morning routine musical". It forwards
// to the homepage scrolled to the film card, untagged; see MUSICAL_SHORT_TARGET in ../lib/films.ts
// (and /yt-musical for the tagged YouTube link).
import { SITE_URL } from '@beanies/brand/nav';
import ForwardPage from '../components/ForwardPage.astro';
import { MUSICAL, MUSICAL_SHORT_TARGET } from '../lib/films';
---

<ForwardPage
  to={MUSICAL_SHORT_TARGET}
  canonical={`${SITE_URL}/`}
  title={`${MUSICAL.title} | beanies.family`}
  message="taking you to the morning routine musical… 🫘"
  linkText="tap here to watch it on beanies.family"
/>
