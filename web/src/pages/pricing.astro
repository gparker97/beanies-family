  }

  .pricing-page .trial p {
    flex: 1;
    margin: 0;
    min-width: 260px;
  }

  .pricing-page .trial b {
    color: var(--deep-slate);
  }

  /* the plans */
  .pricing-page .plans {
    display: grid;
    gap: 22px;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    margin: 0 auto;
    max-width: 900px;
  }

  .pricing-page .plan {
    background: #fff;
    border-radius: var(--sq);
    box-shadow: var(--card-shadow);
    display: flex;
    flex-direction: column;
    padding: 30px 26px 26px;
    position: relative;
  }

  .pricing-page .plan-free {
    border-top: 6px solid var(--sky-silk);
  }

  .pricing-page .plan-paid {
    border-top: 6px solid var(--heritage-orange);
  }

  .pricing-page .plan h3 {
    color: var(--deep-slate);
    font-family: 'Outfit Variable', Outfit, sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
