---
/**
 * /pricing
 *
 * A pricing page for v1: the cloud plans, the v1 coupon, and a quiet note that
 * self-hosting stays free and open source. It follows the switching-page kit
 * (`switch-page.css` + `.welcome-page`) so it looks like it already lived here.
 *
 * Every number on this page comes from `lib/pricing.ts`. Do not type a price
 * into this file.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { APP_URL, GITHUB_URL, SITE_URL } from '@beanies/brand/nav';
import {
  DEFAULT_CURRENCY,
  FULL_BEANS_FALLBACK,
  FULL_BEANS_LIVE_TEMPLATE,
  PRICES,
  PRICING_FAQS,
  TRIAL_DAYS,
  V1_COUPON,
  faqAnswerText,
  splitFaqAnswer,
} from '../lib/pricing';
// Caveat: the CIG handwritten accent, for the tape label and the sign-off only.
import '@fontsource-variable/caveat';
import '../styles/switch-page.css';
import ProofNote from '../components/ProofNote.astro';
import { proofQuote } from '../lib/proof';

const canonicalPath = '/pricing';
const p = PRICES[DEFAULT_CURRENCY];
const currencies = Object.entries(PRICES).map(([code, t]) => ({ code, label: t.label }));

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${SITE_URL}${canonicalPath}#faq`,
  mainEntity: PRICING_FAQS.map((f) => ({
    '@type': 'Question',
    '@id': `${SITE_URL}${canonicalPath}#${f.id}`,
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: faqAnswerText(f.a) },
  })),
};
---
    <BaseLayout
      title="pricing - beanies.family"
      description="beanies.family v1 is here: 90 days of the whole app free, then beanies basic from $30 a year, or the magic beans plan with the ai included. free and open source if you host it yourself. no ads, and your data stays in your own encrypted file."
      canonicalPath={canonicalPath}
  jsonLd={faqSchema}
>
      <div class="welcome-page pricing-page">
        <header class="hero">
          <div class="hero-inner">
            <div class="hero-copy">
              <!-- No kicker pill here. On the switching pages it earns its place
                   ("switching from cozi" is news); on /pricing it just tells you
                   the name of the page you already chose. The shared
                   `.kicker-pill` style stays — those pages still use it. -->
              <h1>no ads. no data. <em>no surprises.</em></h1>
              <p class="hero-sub">
                beanies.family is free and open source if you're a nerd like me (no offense) and
                host it yourself. the cloud version costs money, but i promise it won't burn a hole
                in your wallet. your doggie may even find a couple bucks in the corner of the sofa
                to cover the first month.
              </p>
              <div class="hero-cta">
                <a
                  class="btn btn-primary"
                  href={`${APP_URL}/welcome`}
                  data-cta="CTA: Create Pod"
                  data-cta-loc="pricing-hero">start counting beans 🫘</a
                >
                <a class="btn btn-ghost" href="#plans">see the plans</a>
              </div>
            </div>
            <div class="hero-art" aria-hidden="true">
              <div class="hero-halo"></div>
              <img
                src="/brand/beanies-pricing-pockets.webp"
                alt=""
                width="340"
                height="348"
                loading="eager"
              />
            </div>
          </div>
        </header>

        <section class="dark-section">
          <p class="section-label">before we talk money</p>
          <h2 class="section-title">three things a price won't change</h2>
          <div class="promises">
            <div class="promise">
              <div class="promise-icon">🚫</div>
              <h3>no ads at any tier</h3>
              <p>
                there are no advertisers to answer to because there are no ads, period. annoying
                popups be gone!
              </p>
            </div>
            <div class="promise">
              <div class="promise-icon">🔒</div>
              <h3>you are not the product</h3>
              <p>
                your data lives in your own encrypted file. i can't read it, so i couldn't sell it
                even if i wanted to.
              </p>
            </div>
            <div class="promise">
              <div class="promise-icon">📬</div>
              <h3>you'll hear it here first</h3>
              <p>if anything changes, it lands here and in your inbox. you'll know when i do.</p>
            </div>
          </div>
        </section>

        <section class="section" id="plans">
          <div class="wrap">
            <p class="section-label">what you pay</p>
            <h2 class="section-title">
              {TRIAL_DAYS} days of everything, 100% free. then three dollars a month.
            </h2>
            <p class="section-subtitle">
              we don't run ads or sell your data. so after {TRIAL_DAYS} days, if you want to stick
              around, it's three bucks a month for beanies basic. you can also self-host, which
              will always be free.
            </p>

            <div class="trial">
              <div class="trial-num">{TRIAL_DAYS}<small>days</small></div>
              <p>
                <b>a generous (if i do say so myself) free trial.</b> every feature, every family member, the
                beanie wall, the finances, and more. the only limitation is one magic bean per
                day, because i have to pay for those. after that, beanies goes read-only until you
                pick a plan. no hard feelings either way: your data is
                always yours, exportable any time.
              </p>
            </div>

            <div class="currency" role="group" aria-label="currency">
              <span class="currency-label">show prices in</span>
              <div class="seg" id="currency-seg">
                {
                  currencies.map((c) => (
                    <button
                      type="button"
                      data-currency={c.code}
                      aria-pressed={c.code === DEFAULT_CURRENCY ? 'true' : 'false'}
                    >
                      {c.label}
                    </button>
                  ))
                }
              </div>
            </div>

            <div class="plans plans--two plans--proof">
              <div class="plan plan-free">
                <h3>beanies basic</h3>
                <p class="who">the whole app, except ai</p>
                <p class="price">
                  <span data-price="basicYearly">{p.basicYearly}</span><span class="per">/ year</span>
                </p>
                <p class="price-note">
                  paid yearly, which works out to
                  <span data-price="basicPerMonth">{p.basicPerMonth}</span> / mo
                </p>
                <ul>
                  <li><span>✅</span><span>every feature, every bean</span></li>
                  <li><span>✅</span><span>your whole family, no seat limits</span></li>
                  <li><span>✅</span><span>your data in your own encrypted file</span></li>
                  <li><span>✅</span><span>export the lot, any time</span></li>
                  <li class="muted">
                    <span>🧪</span><span>one magic bean per month, so it's there when you need it</span>
                  </li>
                  <li class="muted">
                    <span>🔑</span><span>or bring your own openai key and use it as much as you like</span>
                  </li>
                </ul>
                <a
                  class="btn btn-ghost"
                  href={`${APP_URL}/welcome`}
                  data-cta="CTA: Create Pod"
                  data-cta-loc="pricing-plan-basic">start counting beans 🫘</a
                >
              </div>

              <div class="plan plan-paid">
                <span class="tape">where most families land</span>
                <h3>magic beans</h3>
                <p class="who">
                  the whole app, plus ai. you probably could have worked that out for yourself.
                </p>
                <p class="price">
                  <span data-price="fullMonthly">{p.fullMonthly}</span><span class="per">/ mo</span>
                </p>
                <p class="price-note">
                  or <span data-price="fullYearly">{p.fullYearly}</span> / year, which works out to
                  ~<span data-price="fullPerMonth">{p.fullPerMonth}</span>/mo
                </p>
                <ul>
                  <li><span>✅</span><span>everything in beanies basic</span></li>
                  <li>
                    <span>✅</span
                    ><span
                      ><span data-bean-limit="full" data-live="up to {count} magic beans"
                        >plenty of magic beans</span
                      > <em>every day</em></span
                    >
                  </li>
                  <li><span>✅</span><span>early access to exclusive new features</span></li>
                </ul>
                <a
                  class="btn btn-primary"
                  href={`${APP_URL}/welcome`}
                  data-cta="CTA: Create Pod"
                  data-cta-loc="pricing-plan-full">start counting beans 🫘</a
                >
              </div>

              <div class="plan-proof">
                <div><ProofNote quote={proofQuote('aherndon-replaced-apps')} stem="left" tilt={1.4} mascot loc="pricing-plan-basic" /></div>
                <div><ProofNote quote={proofQuote('miss-cowboy-everything')} stem="left" tilt={-1.2} loc="pricing-plan-full" /></div>
              </div>
            </div>

            <div class="aibox">
              <h3><span aria-hidden="true">✨</span> what are magic beans?</h3>
              <p class="aibox-lede">
                they're what jack traded his cow for, carefully grown and cultivated to reduce
                mental load by using
                <a href="/help/security/how-beanies-ai-handles-your-photos"><em>private and
                secure ai</em></a> to input your data auto-magically:
              </p>
              <ul class="ailist">
                <li><span>📸</span><span>your invites or activities, in any form</span></li>
                <li><span>✈️</span><span>your travel plans and itineraries</span></li>
                <li>
                  <span>🍳</span><span>your recipes (you can even share a url or youtube link)</span>
                </li>
                <li>
                  <span>🏦</span><span>your bank statements, read into transactions (pdf, screenshot or csv)</span>
                </li>
                <li>
                  <span>✅</span><span>your to-dos, pulled out of school notes and emails, with who and when already filled in</span>
                </li>
                <li class="soon">
                  <span>💬</span><span>provides support and answers your questions about the app
                  <b>coming soon</b></span>
                </li>
                <li class="soon"><span>🌱</span><span>lots more on the way</span></li>
              </ul>
            </div>

            <!-- Deliberately quiet: one line under the plans, never a third plan card. -->
            <div class="foss">
              <p>
                <b>free and open source, always.</b> rather run beanies.family yourself? the code
                is all on github, and self-hosting will never cost you a bean.
              </p>
              <a
                class="foss-link"
                href={GITHUB_URL}
                target="_blank"
                rel="noopener"
                data-cta="CTA: GitHub"
                data-cta-loc="pricing-foss">host it yourself ↗</a
              >
            </div>
          </div>
        </section>

        <section class="whopays">
          <div class="wrap">
            <p class="section-label">a note from me (greg)</p>
            <h2 class="section-title">let's get down to brass tacks</h2>
            <div class="handout letter">
              <p>
                Hi there, beanies - here are my thoughts on pricing. And for those who are sick
                of hearing my thoughts, well... too bad.
              </p>
              <p>
                First things first: beanies.family will <span class="highlight">always be FOSS
                (free and open source)</span> for those techie self-hosters out there - we (well,
                I - I can't speak for my <em>claude-bot</em>) love you. For the rest of us, the
                hosting, tokens, and lots of other stuff costs real money (yes, MY real money).
              </p>
              <p>
                As I may have mentioned (once or twice), we don't generate revenue with your
                private data or ads, so, like all good things, at some point the free ride has to
                come to an end. One thing I can promise, though - it'll be worth
                it (meaning beanies.family - I won't actually give your kid a free ride. I'm pretty
                sure I made that clear in <a href="/blog/welcome-to-the-beanstalk">my first
                blog</a>).
              </p>
              <p>
                My plans for pricing are listed right here on this page. If they change, you'll be
                the first to know.
              </p>
              <p>
                beanies.family will be priced competitively. We may not always be the cheapest, but
                if we're not, it's because <span class="highlight">buying privacy costs more than
                selling ads</span>. Rest assured, I'll keep prices reasonable, and always offer a
                basic tier at a low price.
              </p>
              <p>
                For all my wonderful beanie families who've made beanies better just by being
                here, know that I appreciate everything you do, and your contributions are what
                make beanies.family awesome. Please keep the feedback coming through all the
                feedback channels. You have my eternal gratitude (and
                don't miss <a href="#early">the section below</a> for some special rewards).
              </p>
              <p>
                Together, we can make <a href="/">beanies.family</a> the best software it can
                possibly be.
                Remember - <em>with our powers combined, we are:</em> <b>CAPTAIN BEANIE</b>!
              </p>
              <p>
                Sorry, I got my signals crossed there for a minute. I meant:
                <em class="tagline">every bean counts</em>
              </p>
              <p>Stay cool, my beans.</p>
              <p class="signoff"><span class="g">greg</span></p>
            </div>
          </div>
        </section>

        <section class="section section-tight" id="early">
          <div class="wrap">
            <p class="section-label">while you're early</p>
            <h2 class="section-title">a little something for being an early bean</h2>
            <p class="section-subtitle">a special surprise for my v1 beanies</p>
            <div class="offers">
              <div class="offer offer-v1">
                <p class="who">for the first {V1_COUPON.families} v1 beanie families</p>
                <p class="deal"><em>{V1_COUPON.pctOff}% off</em> your first {V1_COUPON.months} months</p>
                <p>
                  when your trial period is up, use coupon code
                  <code class="coupon">{V1_COUPON.code}</code> for {V1_COUPON.pctOff}% off your
                  first {V1_COUPON.months} months on the monthly magic beans plan. just for being
                  here and being awesome.
                </p>
              </div>
            </div>
          </div>
        </section>

        <section class="section section-tight" id="faq">
          <div class="wrap">
            <p class="section-label">fair questions</p>
            <h2 class="section-title">anything else you'd like to know?</h2>
            {
              PRICING_FAQS.map((f, i) => (
                <details id={f.id} open={i === 0}>
                  <summary>{f.q}</summary>
                  <p>
                    {splitFaqAnswer(f.a).before}{splitFaqAnswer(f.a).after !== null && <span data-bean-limit="full" data-live={FULL_BEANS_LIVE_TEMPLATE}>{FULL_BEANS_FALLBACK}</span>}{splitFaqAnswer(f.a).after}
                  </p>
                </details>
              ))
            }
          </div>
        </section>

        <section class="final">
          <h2 class="final-title">so... ready to count some beans? 🫘</h2>
          <p class="hero-sub">
            don't forget your <a href="#early">v1 coupon</a>, and <em>get in while the gettin's
            good.</em>
          </p>
          <div class="hero-cta">
            <a
              class="btn btn-primary"
              href={`${APP_URL}/welcome`}
              data-cta="CTA: Create Pod"
              data-cta-loc="pricing-final">create your bean pod 🫘</a
            >
          </div>
          <img
            class="final-dog"
            src="/brand/beanies-pricing-dog.webp"
            alt=""
            width="140"
            height="140"
            loading="lazy"
          />
          <p class="ps">
            the beanie dog says <em>every bean counts</em> (wait a minute. dogs can't talk. he just
            says bark.)
          </p>
        </section>
  </div>
</BaseLayout>

<script>
  import { hydrateBeanLimits } from '../lib/planLimits';
  void hydrateBeanLimits();
</script>

<script define:vars={{ PRICES, DEFAULT_CURRENCY }}>
  // One table, one currency at a time. The server rendered USD; this swaps
  // every `[data-price]` node when a person picks another, and remembers it.
  const seg = document.getElementById('currency-seg');
  const STORAGE_KEY = 'beanies-currency';

  function show(code) {
    const table = PRICES[code];
    if (!table) return;
    document.querySelectorAll('[data-price]').forEach((el) => {
      const v = table[el.dataset.price];
      if (v !== undefined) el.textContent = String(v);
    });
    seg.querySelectorAll('button').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.currency === code));
    });
    try {
      localStorage.setItem(STORAGE_KEY, code);
    } catch {
      /* private mode: the choice just does not persist */
    }
  }

  seg.addEventListener('click', (e) => {
    const b = e.target.closest('button[data-currency]');
    if (b) show(b.dataset.currency);
  });

  let initial = DEFAULT_CURRENCY;
  try {
    initial = localStorage.getItem(STORAGE_KEY) || initial;
  } catch {
    /* as above */
  }
  if (initial !== DEFAULT_CURRENCY) show(initial);
</script>

<style>
  /*
   * Page-scoped additions to the switching-page kit. Everything the kit already
   * has (.hero, .section*, .btn*, .handout, .tape, .signoff, details) comes
   * from switch-page.css; only the pricing-specific pieces live here.
   * Kebab-case throughout, matching that sheet's rule.
   */
  .pricing-page .hero {
    text-align: center;
  }

  .pricing-page .hero h1 {
    margin-left: auto;
    margin-right: auto;
  }

  .pricing-page .hero-sub {
    font-size: 1.05rem;
    margin: 0 auto;
    max-width: 56ch;
  }

  .pricing-page .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    justify-content: center;
    margin-top: 1.8rem;
  }

  /* the site's dark treatment */
  .pricing-page .dark-section {
    background: var(--deep-slate);
    color: #ecf0f1;
    padding: 80px 24px;
  }

  .pricing-page .dark-section .section-label {
    color: var(--sky-silk);
  }

  .pricing-page .dark-section .section-title {
    color: #ecf0f1;
  }

  .pricing-page .promises {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    margin: 0 auto;
    max-width: 900px;
  }

  .pricing-page .promise {
    background: rgb(255 255 255 / 6%);
    border: 1px solid rgb(255 255 255 / 8%);
    border-radius: 20px;
    padding: 24px;
  }

  .pricing-page .promise-icon {
    align-items: center;
    background: rgb(174 214 241 / 15%);
    border-radius: 12px;
    display: flex;
    font-size: 1.2rem;
    height: 40px;
    justify-content: center;
    margin-bottom: 0.8rem;
    width: 40px;
  }

  .pricing-page .promise h3 {
    color: #ecf0f1;
    font-family: 'Outfit Variable', Outfit, sans-serif;
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 0.35rem;
  }

  .pricing-page .promise p {
    color: rgb(236 240 241 / 60%);
    font-size: 0.9rem;
    margin: 0;
  }

  /* currency switcher */
  .pricing-page .currency {
    align-items: center;
    display: flex;
    gap: 0.6rem;
    justify-content: center;

    /* No negative top margin. The -1.2rem was tuned to tuck this under the
       section subtitle; it now sits between the trial card and the plans, where
       a negative pull would clamp it against the card above. */
    margin: 0 auto 1.4rem;
  }

  .pricing-page .currency-label {
    color: var(--muted-text);
    font-size: 0.82rem;
  }

  .pricing-page .seg {
    background: #fff;
    border-radius: 999px;
    box-shadow: var(--card-shadow);
    display: inline-flex;
    padding: 4px;
  }

  .pricing-page .seg button {
    background: transparent;
    border: 0;
    border-radius: 999px;
    color: var(--muted-text);
    cursor: pointer;
    font-family: 'Outfit Variable', Outfit, sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    min-height: 2.25rem;
    padding: 0 0.9rem;
  }

  .pricing-page .seg button[aria-pressed='true'] {
    background: linear-gradient(135deg, var(--heritage-orange), var(--terracotta));
    color: #fff;
  }

  .pricing-page .seg button:focus-visible {
    outline: 3px solid var(--heritage-orange);
    outline-offset: 2px;
  }

  /* the trial band */
  .pricing-page .trial {
    align-items: center;
    background: #fff;
    border-left: 6px solid var(--heritage-orange);
    border-radius: var(--sq);
    box-shadow: var(--card-shadow);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin: 0 auto 22px;
    max-width: 900px;
    padding: 22px 26px;
  }

  .pricing-page .trial-num {
    color: var(--heritage-orange);
    font-family: 'Outfit Variable', Outfit, sans-serif;
    font-size: 2.4rem;
    font-weight: 800;
    line-height: 1;
  }

  .pricing-page .trial-num small {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pricing-page .trial p {
    flex: 1;
    margin: 0;
    min-width: 260px;
  }

  .pricing-page .trial b {
    color: var(--deep-slate);
  }

  /* the plans */
  .pricing-page .plans {
    display: grid;
    gap: 22px;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    margin: 0 auto;
    max-width: 900px;
  }

  .pricing-page .plan {
    background: #fff;
    border-radius: var(--sq);
    box-shadow: var(--card-shadow);
    display: flex;
    flex-direction: column;
    padding: 30px 26px 26px;
    position: relative;
  }

  .pricing-page .plan-free {
    border-top: 6px solid var(--sky-silk);
  }

  .pricing-page .plan-paid {
    border-top: 6px solid var(--heritage-orange);
  }

  .pricing-page .plan h3 {
    color: var(--deep-slate);
    font-family: 'Outfit Variable', Outfit, sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    margin: 0 0 0.2rem;
  }

  .pricing-page .plan .who {
    color: var(--muted-text);
    font-size: 0.86rem;
    margin: 0 0 1.1rem;
  }

  /* prices are Outfit, never Caveat: the CIG forbids the hand face on any figure */
  .pricing-page .price {
    align-items: baseline;
    color: var(--deep-slate);
    display: flex;
    font-family: 'Outfit Variable', Outfit, sans-serif;
    font-size: 2.6rem;
    font-weight: 800;
    gap: 0.35rem;
    line-height: 1;
    margin: 0 0 0.2rem;
  }

  .pricing-page .price .per {
    color: var(--muted-text);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .pricing-page .price-note {
    color: var(--muted-text);
    font-size: 0.82rem;
    margin: 0 0 1.2rem;
    min-height: 2.6em;
  }

  .pricing-page .plan ul {
    list-style: none;
    margin: 0 0 1.2rem;
    padding: 0;
  }

  .pricing-page .plan li {
    display: flex;
    font-size: 0.92rem;
    gap: 0.6rem;
    margin-bottom: 0.55rem;
  }

  .pricing-page .plan li span:first-child {
    flex-shrink: 0;
  }

  .pricing-page .plan li.muted {
    color: var(--muted-text);
  }

  /* buttons share a baseline across the row, whatever each list's length */
  .pricing-page .plan .btn {
    display: block;
    margin-top: auto;
    text-align: center;
  }

  .pricing-page .tape {
    white-space: nowrap;
  }

  /* who pays: the honesty block on the site's cream */
  .pricing-page .whopays {
    background:
      radial-gradient(620px 300px at 12% 0%, rgb(241 93 34 / 12%), transparent 70%),
      radial-gradient(520px 300px at 88% 100%, rgb(174 214 241 / 30%), transparent 70%),
      var(--story-cream);
    padding: 66px 24px;
