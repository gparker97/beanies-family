---
/**
 * /pricing
 *
 * A pricing page whose job is to defuse the "free for now" hedge that appears
 * on nine pages and four posts. It follows the switching-page kit
 * (`switch-page.css` + `.welcome-page`) so it looks like it already lived here.
 *
 * Every number on this page comes from `lib/pricing.ts`. Do not type a price
 * into this file.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { APP_URL, SITE_URL } from '@beanies/brand/nav';
import { DEFAULT_CURRENCY, PRICES, PRICING_FAQS, TRIAL_DAYS } from '../lib/pricing';
// Caveat: the CIG handwritten accent, for the tape label and the sign-off only.
import '@fontsource-variable/caveat';
import '../styles/switch-page.css';

const canonicalPath = '/pricing';
const p = PRICES[DEFAULT_CURRENCY];
const currencies = Object.entries(PRICES).map(([code, t]) => ({ code, label: t.label }));

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${SITE_URL}${canonicalPath}#faq`,
  mainEntity: PRICING_FAQS.map((f) => ({
    '@type': 'Question',
    '@id': `${SITE_URL}${canonicalPath}#${f.id}`,
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
    <BaseLayout
      title="pricing - beanies.family"
      description="beanies.family is free while it's in beta. at v1: 90 days of the whole app, then beanies basic from $30 a year, or beanies + magic beans with the ai included. no ads, and your data stays in your own encrypted file."
      canonicalPath={canonicalPath}
  jsonLd={faqSchema}
>
      <div class="welcome-page pricing-page">
        <header class="hero">
          <div class="hero-inner">
            <div class="hero-copy">
              <span class="kicker-pill">🫘 pricing</span>
              <h1>no ads. no data. <em>no surprises.</em></h1>
              <p class="hero-sub">
                free for now, while we're in beta. v1 will cost money, but i promise not to
                burn a hole in your wallet. your dog may even find a couple bucks in the corner
                of the sofa to cover the first month.
              </p>
              <div class="hero-cta">
                <a
                  class="btn btn-primary"
                  href={`${APP_URL}/welcome`}
                  data-cta="CTA: Create Pod"
                  data-cta-loc="pricing-hero">start counting beans 🫘</a
                >
                <a class="btn btn-ghost" href="#plans">see the plans</a>
              </div>
            </div>
            <div class="hero-art" aria-hidden="true">
              <div class="hero-halo"></div>
              <img
                src="/brand/beanies-pricing-pockets.webp"
                alt=""
                width="340"
                height="348"
                loading="eager"
              />
            </div>
          </div>
        </header>

        <section class="dark-section">
          <p class="section-label">before we talk money</p>
          <h2 class="section-title">three things a price won't change</h2>
          <div class="promises">
            <div class="promise">
              <div class="promise-icon">🚫</div>
              <h3>no ads at any tier</h3>
              <p>
                there are no advertisers to answer to because there are no ads, period. annoying
                popups be gone!
              </p>
            </div>
            <div class="promise">
              <div class="promise-icon">🔒</div>
              <h3>you are not the product</h3>
              <p>
                your data lives in your own encrypted file. i can't read it, so i couldn't sell it
                even if i wanted to.
              </p>
            </div>
            <div class="promise">
              <div class="promise-icon">📬</div>
              <h3>you'll hear it here first</h3>
              <p>if anything changes, it lands here and in your inbox. you'll know when i do.</p>
            </div>
          </div>
        </section>

        <section class="section" id="plans">
          <div class="wrap">
            <p class="section-label">what you pay</p>
            <h2 class="section-title">
              {TRIAL_DAYS} days of everything, 100% free. then three dollars a month.
            </h2>
            <p class="section-subtitle">
              we don't run ads or sell your data. so after {TRIAL_DAYS} days, if you want to stick
              around, it's three bucks a month for beanies basic. you can also self-host, which
              will always be free.
            </p>

            <div class="currency" role="group" aria-label="currency">
              <span class="currency-label">show prices in</span>
              <div class="seg" id="currency-seg">
                {
                  currencies.map((c) => (
                    <button
                      type="button"
                      data-currency={c.code}
                      aria-pressed={c.code === DEFAULT_CURRENCY ? 'true' : 'false'}
                    >
                      {c.label}
                    </button>
                  ))
                }
              </div>
            </div>

            <div class="trial">
              <div class="trial-num">{TRIAL_DAYS}<small>days</small></div>
              <p>
                <b>a generous free trial (if i do say so myself).</b> every feature, every family member, the
                beanie wall, the finances, and more, plus one ai read a day. after that beanies
                goes read-only until you pick a plan. no hard feelings either way: your data is
                always yours, exportable any time.
              </p>
            </div>

            <div class="plans plans--two">
              <div class="plan plan--basic">
                <h3>beanies basic</h3>
                <p class="who">the whole app, except ai</p>
                <p class="price">
                  <span data-price="basicYearly">{p.basicYearly}</span><span class="per">/ year</span>
                </p>
                <p class="price-note">
                  paid yearly, which works out to
                  <span data-price="basicPerMonth">{p.basicPerMonth}</span> / mo
                </p>
                <ul>
                  <li><span>✅</span><span>every feature, every world</span></li>
                  <li><span>✅</span><span>your whole family, no seat limits</span></li>
                  <li><span>✅</span><span>your data in your own encrypted file</span></li>
                  <li><span>✅</span><span>export the lot, any time</span></li>
                  <li class="muted">
                    <span>🧪</span><span>one ai read a month, so it's there when you need it</span>
                  </li>
                  <li class="muted">
                    <span>🔑</span><span>or bring your own openai key and use it as much as you like</span>
                  </li>
                </ul>
                <a
                  class="btn btn-ghost"
                  href={`${APP_URL}/welcome`}
                  data-cta="CTA: Create Pod"
                  data-cta-loc="pricing-plan-basic">start counting beans 🫘</a
                >
              </div>

              <div class="plan plan--paid">
                <span class="tape">where most families land</span>
                <h3>beanies + magic beans</h3>
                <p class="who">
                  the whole app, plus ai. you probably could have worked that out for yourself.
                </p>
                <p class="price">
                  <span data-price="fullMonthly">{p.fullMonthly}</span><span class="per">/ mo</span>
                </p>
                <p class="price-note">
                  or <span data-price="fullYearly">{p.fullYearly}</span> / year, which works out to
                  ~<span data-price="fullPerMonth">{p.fullPerMonth}</span>/mo
                </p>
                <ul>
                  <li><span>✅</span><span>everything in beanies basic</span></li>
                  <li><span>✅</span><span>ten ai reads per day</span></li>
                  <li><span>✅</span><span>early access to exclusive new features</span></li>
                </ul>
                <a
                  class="btn btn-primary"
                  href={`${APP_URL}/welcome`}
                  data-cta="CTA: Create Pod"
                  data-cta-loc="pricing-plan-full">start counting beans 🫘</a
                >
              </div>
            </div>

            <div class="aibox">
              <h3>what are magic beans?</h3>
              <p class="aibox-lede">
                that's just what we call ai features. it reads your invites, travel plans,
                recipes, and more so you don't have to type them in one by one.
              </p>
              <ul class="ailist">
                <li><span>📸</span><span>your invites or activities, in any form</span></li>
                <li><span>✈️</span><span>your travel plans and itineraries</span></li>
                <li>
                  <span>🍳</span><span>your recipes (you can even share a url or youtube link)</span>
                </li>
                <li class="soon">
                  <span>🏦</span><span>your bank transactions <b>coming soon</b></span>
                </li>
                <li class="soon"><span>🌱</span><span>lots more on the way</span></li>
              </ul>
            </div>
          </div>
        </section>

        <section class="whopays">
          <div class="wrap">
            <p class="section-label">a note from me (greg)</p>
            <h2 class="section-title">i've been paying for this myself</h2>
            <div class="handout letter">
              <p>
                Ok my beans - it's time to get down to brass tacks. Here are my thoughts on
                pricing. And for those who are sick of hearing my thoughts, well... too bad.
              </p>
              <p>
                First things first, the app is <span class="highlight">
                  still free, and will remain free while it's in beta</span
                >.
              </p>
              <p>
                I would never dream of charging users for software that is not up to my standards
                for a production app. We're still working out the kinks, together, and I'm
                grateful for each and every one of my early beanies who helps to unearth all those
                fiddly little bugs, issues, and snafus.
              </p>
              <p>
                That said, I've been footing the bill for months. As I may have mentioned (once or
                twice), we don't harvest user data, run ads, or do any other revenue-generating
                things. So, at some point, Something's Gotta Give, which is a great movie with
                Jack Nicholson, Diane Keaton, Frances McDormand, Jon Favreau, and about 10 other
                absolute Hollywood legends that I highly recommend you watch if you're in the mood
                to curl up on your couch with a blanket and some popcorn for a solid rom-com movie
                night. A top-notch cast and a great film. In my (humble) opinion.
              </p>
              <p>
                But getting back to the point - money. Yes, there will be pricing. And it will be
                fair and transparent. The pricing plans are right here on this page. If they
                change, you'll be the first to know.
              </p>
              <p>
                For those who've helped make beanies better just by being here, know that I
                appreciate everything you've done, and your contributions will not go unrewarded
                (in fact, <a href="#early">see down below</a> for some interesting prizes for
                early adopter beanies).
              </p>
              <p>
                Together, let's make this platform the best that it can possibly be. I've said it
                before, and I'll say it again - with our powers combined, we are: CAPTAIN BEANIE!
              </p>
              <p>Sorry, I meant: <em class="tagline">every bean counts</em></p>
              <p class="signoff"><span class="g">greg</span></p>
            </div>
          </div>
        </section>

        <section class="section section-tight" id="early">
          <div class="wrap">
            <p class="section-label">while you're early</p>
            <h2 class="section-title">a little something for being an early bean</h2>
            <p class="section-subtitle">a special surprise for my early adopter beanies</p>
            <div class="offers">
              <div class="offer offer--rest">
                <p class="who">everyone who joins before v1</p>
                <p class="deal"><em>half price</em>, forever</p>
                <p>
                  when your trial period is up, it's 50% off for as long as you stay. forever. no
                  code needed.
                </p>
              </div>
            </div>
          </div>
        </section>

        <section class="section section-tight">
          <div class="wrap">
            <p class="section-label">the rollout</p>
            <h2 class="section-title">here's what to expect</h2>
            <div class="steps">
              <div class="step step--now">
                <div class="step-rail"><span class="step-dot">1</span></div>
                <div class="step-body">
                  <span class="when">you are here</span>
                  <h3>beta. everything free, no clock.</h3>
                  <p>no charge while we're still testing. but that won't last forever.</p>
                </div>
              </div>
              <div class="step">
                <div class="step-rail"><span class="step-dot">2</span></div>
                <div class="step-body">
                  <span class="when">before anything changes</span>
                  <h3>i'll update you here and by email</h3>
                  <p>
                    you'll have time to decide, and the prices above will only take effect after
                    your trial period.
                  </p>
                </div>
              </div>
              <div class="step">
                <div class="step-rail"><span class="step-dot">3</span></div>
                <div class="step-body">
                  <span class="when">v1</span>
                  <h3>beta ends, subscriptions open</h3>
                  <p>
                    after the {TRIAL_DAYS} days trial period, pick one of the plans. if you sign
                    up now, you'll keep your special price forever.
                  </p>
                </div>
              </div>
              <div class="step">
                <div class="step-rail"><span class="step-dot">4</span></div>
                <div class="step-body">
                  <span class="when">after v1</span>
                  <h3>new families pay the full price</h3>
                  <p>which is why i'm telling you this now.</p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="section section-tight" id="faq">
          <div class="wrap">
            <p class="section-label">fair questions</p>
            <h2 class="section-title">anything else you'd like to know?</h2>
            {
              PRICING_FAQS.map((f, i) => (
                <details id={f.id} open={i === 0}>
                  <summary>{f.q}</summary>
                  <p>{f.a}</p>
                </details>
              ))
            }
          </div>
        </section>

        <section class="final">
          <h2 class="final-title">so... ready to count some beans? 🫘</h2>
          <p class="hero-sub">
            free while in beta, and <a href="#early">special rewards for those who sign up now</a>,
            so <em>get in while the gettin's good.</em>
          </p>
          <div class="hero-cta">
            <a
              class="btn btn-primary"
              href={`${APP_URL}/welcome`}
              data-cta="CTA: Create Pod"
              data-cta-loc="pricing-final">create your bean pod 🫘</a
            >
          </div>
          <img
            class="final-dog"
            src="/brand/beanies-pricing-dog.webp"
            alt=""
            width="140"
            height="140"
            loading="lazy"
          />
          <p class="ps">the beanie doggie says hello. and <em>every bean counts</em></p>
        </section>
  </div>
</BaseLayout>

<script define:vars={{ PRICES, DEFAULT_CURRENCY }}>
  // One table, one currency at a time. The server rendered USD; this swaps
  // every `[data-price]` node when a person picks another, and remembers it.
  const seg = document.getElementById('currency-seg');
  const STORAGE_KEY = 'beanies-currency';

  function show(code) {
    const table = PRICES[code];
    if (!table) return;
    document.querySelectorAll('[data-price]').forEach((el) => {
      const v = table[el.dataset.price];
      if (v !== undefined) el.textContent = String(v);
    });
    seg.querySelectorAll('button').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.currency === code));
    });
    try {
      localStorage.setItem(STORAGE_KEY, code);
    } catch {
      /* private mode: the choice just does not persist */
    }
  }

  seg.addEventListener('click', (e) => {
    const b = e.target.closest('button[data-currency]');
    if (b) show(b.dataset.currency);
  });

  let initial = DEFAULT_CURRENCY;
  try {
    initial = localStorage.getItem(STORAGE_KEY) || initial;
  } catch {
    /* as above */
  }
  if (initial !== DEFAULT_CURRENCY) show(initial);
</script>

<style>
  /*
   * Page-scoped additions to the switching-page kit. Everything the kit already
   * has (.hero, .section*, .btn*, .handout, .tape, .signoff, details) comes
   * from switch-page.css; only the pricing-specific pieces live here.
   * Kebab-case throughout, matching that sheet's rule.
   */
  .pricing-page .hero {
    text-align: center;
  }

  .pricing-page .hero h1 {
    margin-left: auto;
    margin-right: auto;
  }

  .pricing-page .hero-sub {
    font-size: 1.05rem;
    margin: 0 auto;
    max-width: 56ch;
  }

  .pricing-page .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    justify-content: center;
    margin-top: 1.8rem;
  }

  /* the site's dark treatment */
  .pricing-page .dark-section {
    background: var(--deep-slate);
    color: #ecf0f1;
    padding: 80px 24px;
  }

  .pricing-page .dark-section .section-label {
    color: var(--sky-silk);
  }

  .pricing-page .dark-section .section-title {
    color: #ecf0f1;
  }

  .pricing-page .promises {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    margin: 0 auto;
    max-width: 900px;
  }

  .pricing-page .promise {
    background: rgb(255 255 255 / 6%);
    border: 1px solid rgb(255 255 255 / 8%);
    border-radius: 20px;
    padding: 24px;
  }

  .pricing-page .promise-icon {
    align-items: center;
    background: rgb(174 214 241 / 15%);
    border-radius: 12px;
    display: flex;
    font-size: 1.2rem;
    height: 40px;
    justify-content: center;
    margin-bottom: 0.8rem;
    width: 40px;
  }

  .pricing-page .promise h3 {
    color: #ecf0f1;
    font-family: 'Outfit Variable', Outfit, sans-serif;
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 0.35rem;
  }

  .pricing-page .promise p {
    color: rgb(236 240 241 / 60%);
    font-size: 0.9rem;
    margin: 0;
  }

  /* currency switcher */
  .pricing-page .currency {
    align-items: center;
    display: flex;
    gap: 0.6rem;
    justify-content: center;
    margin: -1.2rem auto 1.8rem;
  }

  .pricing-page .currency-label {
    color: var(--muted-text);
    font-size: 0.82rem;
  }

  .pricing-page .seg {
    background: #fff;
    border-radius: 999px;
    box-shadow: var(--card-shadow);
    display: inline-flex;
    padding: 4px;
  }

  .pricing-page .seg button {
    background: transparent;
    border: 0;
    border-radius: 999px;
    color: var(--muted-text);
    cursor: pointer;
    font-family: 'Outfit Variable', Outfit, sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    min-height: 2.25rem;
    padding: 0 0.9rem;
  }

  .pricing-page .seg button[aria-pressed='true'] {
    background: linear-gradient(135deg, var(--heritage-orange), var(--terracotta));
    color: #fff;
  }

  .pricing-page .seg button:focus-visible {
    outline: 3px solid var(--heritage-orange);
    outline-offset: 2px;
  }

  /* the trial band */
  .pricing-page .trial {
    align-items: center;
    background: #fff;
    border-left: 6px solid var(--heritage-orange);
    border-radius: var(--sq);
    box-shadow: var(--card-shadow);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin: 0 auto 22px;
    max-width: 900px;
    padding: 22px 26px;
  }

  .pricing-page .trial-num {
    color: var(--heritage-orange);
    font-family: 'Outfit Variable', Outfit, sans-serif;
    font-size: 2.4rem;
    font-weight: 800;
    line-height: 1;
  }

  .pricing-page .trial-num small {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pricing-page .trial p {
    flex: 1;
    margin: 0;
    min-width: 260px;
  }

  .pricing-page .trial b {
    color: var(--deep-slate);
  }

  /* the plans */
  .pricing-page .plans {
    display: grid;
    gap: 22px;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    margin: 0 auto;
    max-width: 900px;
  }

  .pricing-page .plan {
    background: #fff;
    border-radius: var(--sq);
    box-shadow: var(--card-shadow);
    display: flex;
    flex-direction: column;
    padding: 30px 26px 26px;
    position: relative;
  }

  .pricing-page .plan-free {
    border-top: 6px solid var(--sky-silk);
  }

  .pricing-page .plan-paid {
    border-top: 6px solid var(--heritage-orange);
  }

  .pricing-page .plan h3 {
    color: var(--deep-slate);
    font-family: 'Outfit Variable', Outfit, sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    margin: 0 0 0.2rem;
  }

  .pricing-page .plan .who {
    color: var(--muted-text);
    font-size: 0.86rem;
    margin: 0 0 1.1rem;
  }

  /* prices are Outfit, never Caveat: the CIG forbids the hand face on any figure */
  .pricing-page .price {
    align-items: baseline;
    color: var(--deep-slate);
    display: flex;
    font-family: 'Outfit Variable', Outfit, sans-serif;
    font-size: 2.6rem;
    font-weight: 800;
    gap: 0.35rem;
    line-height: 1;
    margin: 0 0 0.2rem;
  }

  .pricing-page .price .per {
    color: var(--muted-text);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .pricing-page .price-note {
    color: var(--muted-text);
    font-size: 0.82rem;
    margin: 0 0 1.2rem;
    min-height: 2.6em;
  }

  .pricing-page .plan ul {
    list-style: none;
    margin: 0 0 1.2rem;
    padding: 0;
  }

  .pricing-page .plan li {
    display: flex;
    font-size: 0.92rem;
    gap: 0.6rem;
    margin-bottom: 0.55rem;
  }

  .pricing-page .plan li span:first-child {
    flex-shrink: 0;
  }

  .pricing-page .plan li.muted {
    color: var(--muted-text);
  }

  /* buttons share a baseline across the row, whatever each list's length */
  .pricing-page .plan .btn {
    display: block;
    margin-top: auto;
    text-align: center;
  }

  .pricing-page .tape {
    white-space: nowrap;
  }

  /* who pays: the honesty block on the site's cream */
  .pricing-page .whopays {
    background:
      radial-gradient(620px 300px at 12% 0%, rgb(241 93 34 / 12%), transparent 70%),
      radial-gradient(520px 300px at 88% 100%, rgb(174 214 241 / 30%), transparent 70%),
      var(--story-cream);
    padding: 66px 24px;
  }

  .pricing-page .whopays .handout {
    border-top-color: var(--terracotta);
  }

  .pricing-page .highlight {
    background: linear-gradient(transparent 60%, rgb(174 214 241 / 35%) 60%);
    padding: 0 2px;
  }

  /* early families */
  /* One offer since the first-ten deal was retired, so the container is sized
     for a single card rather than stretching it across the old two-up width. */
  .pricing-page .offers {
    display: grid;
    gap: 20px;
