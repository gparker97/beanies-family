    margin: 0 auto;
    max-width: 520px;
  }

  .pricing-page .offer {
    background: #fff;
    border-radius: var(--sq);
    box-shadow: var(--card-shadow);
    padding: 28px;
    text-align: center;
  }

  .pricing-page .offer-ten {
    border-top: 6px solid var(--heritage-orange);
  }

  .pricing-page .offer-rest {
    border-top: 6px solid var(--sky-silk);
  }

  .pricing-page .offer .who {
    color: var(--muted-text);
    font-size: 0.84rem;
    margin: 0 0 0.6rem;
  }

  .pricing-page .offer .deal {
    color: var(--deep-slate);
