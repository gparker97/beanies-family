    font-size: 0.82rem;
  }

  .pricing-page .seg {
    background: #fff;
    border-radius: 999px;
    box-shadow: var(--card-shadow);
    display: inline-flex;
    padding: 4px;
  }

  .pricing-page .seg button {
    background: transparent;
    border: 0;
    border-radius: 999px;
    color: var(--muted-text);
    cursor: pointer;
    font-family: 'Outfit Variable', Outfit, sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    min-height: 2.25rem;
    padding: 0 0.9rem;
  }

  .pricing-page .seg button[aria-pressed='true'] {
    background: linear-gradient(135deg, var(--heritage-orange), var(--terracotta));
    color: #fff;
  }

  .pricing-page .seg button:focus-visible {
    outline: 3px solid var(--heritage-orange);
    outline-offset: 2px;
  }

  /* the trial band */
  .pricing-page .trial {
    align-items: center;
    background: #fff;
    border-left: 6px solid var(--heritage-orange);
    border-radius: var(--sq);
    box-shadow: var(--card-shadow);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin: 0 auto 22px;
    max-width: 900px;
    padding: 22px 26px;
  }

  .pricing-page .trial-num {
    color: var(--heritage-orange);
    font-family: 'Outfit Variable', Outfit, sans-serif;
    font-size: 2.4rem;
    font-weight: 800;
